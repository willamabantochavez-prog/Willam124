dot.BorderSizePixel = 0
dot.ZIndex = 16
dot.Parent = MainFrame
Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

-- Soft outer ring (same color, very transparent, circle only)
local dotRing = Instance.new("Frame")
dotRing.Size = UDim2.new(1, 14, 1, 14)
dotRing.Position = UDim2.new(0, -7, 0, -7)
dotRing.BackgroundColor3 = C.accent
dotRing.BackgroundTransparency = 0.88
dotRing.BorderSizePixel = 0
dotRing.ZIndex = 15
dotRing.Parent = dot
Instance.new("UICorner", dotRing).CornerRadius = UDim.new(1, 0)

-- Dot pulse (ring only, no rectangular glow)
task.spawn(function()
    while MainFrame.Parent do
        local p = (math.sin(tick() * 3) + 1) / 2
        dotRing.BackgroundTransparency = 0.84 + 0.12 * (1 - p)
        tw(dotRing, {
            Size = UDim2.new(1, 14 + 8 * p, 1, 14 + 8 * p),
            Position = UDim2.new(0, -7 - 4 * p, 0, -7 - 4 * p)
        }, 0.08)
        task.wait(0.04)
    end
end)

