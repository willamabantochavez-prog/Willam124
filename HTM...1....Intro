-- ══════════════════════════════════════════════════════════════
-- ECLIPSE HUD OVERLAY v15.4
-- EclipseVS x vailVS | FPS | MS | Particles | Fixed Top Center
-- NO accent line | NO orange boxes | Clean pill shape
-- ══════════════════════════════════════════════════════════════

local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Stats = game:GetService("Stats")

pcall(function()
    for _, gui in ipairs(game:GetService("CoreGui"):GetChildren()) do
        if gui.Name == "EclipseHUD" then gui:Destroy() end
    end
end)

-- ════════════════════════════════
--        FPS / MS TRACKING
-- ════════════════════════════════

local fps = 0
local ms = 0
local frameCount = 0
local lastFPSTime = tick()

RunService.Heartbeat:Connect(function()
    frameCount = frameCount + 1
    local now = tick()
    if now - lastFPSTime >= 1 then
        fps = frameCount
        frameCount = 0
        lastFPSTime = now
    end
    pcall(function()
        ms = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
    end)
end)

-- ════════════════════════════════
--   COLOR PALETTE
-- ════════════════════════════════

local C = {
    bg        = Color3.fromRGB(10, 10, 14),
    accent    = Color3.fromRGB(255, 140, 0),
    green     = Color3.fromRGB(40, 200, 70),
    yellow    = Color3.fromRGB(255, 200, 40),
    red       = Color3.fromRGB(220, 60, 50),
    text      = Color3.fromRGB(255, 252, 245),
    textDim   = Color3.fromRGB(140, 135, 125),
    textMuted = Color3.fromRGB(90, 85, 80),
    border    = Color3.fromRGB(30, 28, 38),
    p1        = Color3.fromRGB(255, 140, 0),
    p2        = Color3.fromRGB(255, 100, 20),
    p3        = Color3.fromRGB(255, 180, 60),
}

-- ════════════════════════════════
--   TWEEN HELPER
-- ════════════════════════════════

local function tw(inst, props, dur)
    TweenService:Create(inst, TweenInfo.new(dur or 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

