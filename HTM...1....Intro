-- ──────────────────────────────
--   STATS UPDATE LOOP
-- ──────────────────────────────

task.spawn(function()
    while MainFrame.Parent do
        FPSVal.Text = tostring(fps)
        if fps >= 50 then
            tw(FPSVal, {TextColor3 = C.green}, 0.3)
            tw(fpsDot, {BackgroundColor3 = C.green}, 0.3)
        elseif fps >= 30 then
            tw(FPSVal, {TextColor3 = C.yellow}, 0.3)
            tw(fpsDot, {BackgroundColor3 = C.yellow}, 0.3)
        else
            tw(FPSVal, {TextColor3 = C.red}, 0.3)
            tw(fpsDot, {BackgroundColor3 = C.red}, 0.3)
        end

        MSVal.Text = tostring(ms)
        if ms <= 80 then
            tw(MSVal, {TextColor3 = C.green}, 0.3)
            tw(msDot, {BackgroundColor3 = C.green}, 0.3)
        elseif ms <= 150 then
            tw(MSVal, {TextColor3 = C.yellow}, 0.3)
            tw(msDot, {BackgroundColor3 = C.yellow}, 0.3)
        else
            tw(MSVal, {TextColor3 = C.red}, 0.3)
            tw(msDot, {BackgroundColor3 = C.red}, 0.3)
        end

        task.wait(0.5)
    end
end)

-- ──────────────────────────────
--   ENTRANCE ANIMATION
-- ──────────────────────────────

MainFrame.Position = UDim2.new(0.5, -BAR_W / 2, 0, -BAR_H - 12)
task.wait(0.15)
tw(MainFrame, {Position = UDim2.new(0.5, -BAR_W / 2, 0, 8)}, 0.5)

-- ──────────────────────────────
--   RIGHTSHIFT HIDE/SHOW
-- ──────────────────────────────

UIS.InputBegan:Connect(function(input, proc)
    if proc then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        if ScreenGui.Enabled then
            tw(MainFrame, {Position = UDim2.new(0.5, -BAR_W / 2, 0, -BAR_H - 12)}, 0.3)
            task.wait(0.3)
            ScreenGui.Enabled = false
        else
            ScreenGui.Enabled = true
            MainFrame.Position = UDim2.new(0.5, -BAR_W / 2, 0, -BAR_H - 12)
            tw(MainFrame, {Position = UDim2.new(0.5, -BAR_W / 2, 0, 8)}, 0.3)
        end
    end
end)

print("══════════════════════════════")
print("  ECLIPSE HUD OVERLAY v15.4")
print("  EclipseVS x vailVS")
print("  RightShift = Hide")
print("══════════════════════════════")
