--   NO ACCENT LINE HERE — REMOVED COMPLETELY
-- ═══════════════════════════════════════════════

-- ──────────────────────────────
--   FALLING PARTICLES
-- ──────────────────────────────

local ParticleBox = Instance.new("Frame")
ParticleBox.Size = UDim2.new(1, 0, 1, 0)
ParticleBox.BackgroundTransparency = 1
ParticleBox.ZIndex = 3
ParticleBox.ClipsDescendants = true
ParticleBox.Parent = MainFrame

local particles = {}
local MAX_P = 10
local P_COLORS = {C.p1, C.p2, C.p3}

local function spawnP()
    if #particles >= MAX_P then return end
    local sz = math.random(2, 3)
    local col = P_COLORS[math.random(1, #P_COLORS)]
    local sx = math.random(20, BAR_W - 20)
    local sp = math.random(28, 55) / 10
    local sw = math.random(4, 10)
    local ss = math.random(12, 22) / 10
    local al = math.random(18, 35) / 100

    local p = Instance.new("Frame")
    p.Size = UDim2.new(0, sz, 0, sz)
    p.Position = UDim2.new(0, sx, 0, -sz - 2)
    p.BackgroundColor3 = col
    p.BackgroundTransparency = 1 - al
    p.BorderSizePixel = 0
    p.ZIndex = 3
    p.Parent = ParticleBox
    Instance.new("UICorner", p).CornerRadius = UDim.new(1, 0)

    -- Very subtle glow circle (fully transparent parent, not a box)
    local g = Instance.new("Frame")
    g.Size = UDim2.new(1, sz * 2, 1, sz * 2)
    g.Position = UDim2.new(0, -sz, 0, -sz)
    g.BackgroundColor3 = col
    g.BackgroundTransparency = 1 - (al * 0.15)
    g.BorderSizePixel = 0
    g.ZIndex = 3
    g.Parent = p
    Instance.new("UICorner", g).CornerRadius = UDim.new(1, 0)

    table.insert(particles, {
        f = p, x = sx, y = -sz - 2,
        sp = sp, sw = sw, ss = ss,
        t = math.random() * 6.28, al = al
    })
end

local function updateP(dt)
    for i = #particles, 1, -1 do
        local pt = particles[i]
        pt.y = pt.y + (BAR_H / pt.sp) * dt
        pt.t = pt.t + dt * pt.ss
        local s = math.sin(pt.t) * pt.sw
        if pt.y > BAR_H + 4 then
            pt.f:Destroy()
            table.remove(particles, i)
        else
            pt.f.Position = UDim2.new(0, pt.x + s, 0, pt.y)
            if pt.y > BAR_H - 12 then
                local fade = (pt.y - (BAR_H - 12)) / 12
                pt.f.BackgroundTransparency = 1 - (pt.al * (1 - fade))
            end
        end
    end
end

task.spawn(function()
    while MainFrame.Parent do
        spawnP()
        task.wait(math.random(25, 50) / 100)
    end
end)

RunService.Heartbeat:Connect(function(dt)
    updateP(dt)
end)

