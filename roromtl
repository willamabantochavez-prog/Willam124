local function checkBrainrotNearby()
    local _, r, _ = gCP()
    if not r then return false end
    local brainrots = workspace:FindFirstChild("Brainrots") or workspace:FindFirstChild("Collectibles")
    if brainrots then
        for _, obj in pairs(brainrots:GetChildren()) do
            if obj:IsA("BasePart") or obj:FindFirstChildWhichIsA("BasePart") then
                local p = obj:IsA("BasePart") and obj.Position or obj:FindFirstChildWhichIsA("BasePart").Position
                if (r.Position - p).Magnitude < 15 then
                    return true
                end
            end
        end
    end
    return false
end

