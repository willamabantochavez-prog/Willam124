-- ══════════════════════════════════════
--   POSITION LOCK - 6 SECOND TIMEOUT
--   FIX: Espera respawn antes de contar
-- ══════════════════════════════════════

local function waitForCharacter()
    -- Esperar a que exista el personaje completo
    local char = LP.Character
    if not char then
        char = LP.CharacterAdded:Wait()
    end
    -- Esperar a que HumanoidRootPart y Humanoid existan
    local root = char:WaitForChild("HumanoidRootPart", 10)
    local humanoid = char:WaitForChild("Humanoid", 10)
    if not root or not humanoid then
        return nil, nil, nil
    end
    -- Esperar a que el personaje esté completamente cargado
    if not humanoid:IsDescendantOf(workspace) then
        humanoid.AncestryChanged:Wait()
    end
    -- Esperar extra para que el servidor termine de cargar todo
    task.wait(2)
    return char, root, humanoid
end

local function positionLockLoop()
    while posActive do
        local char, root, humanoid = waitForCharacter()

        if not root or not humanoid or not posActive then
            if posActive then
                StatusLabel.Text = "Status: Waiting for character..."
                StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
                task.wait(1)
            end
            continue
        end

        local dist = getDistanceFromTarget(root)

        -- Ya está en el destino
        if dist < 6 then
            StatusLabel.Text = string.format("✅ At Slot %d | Dist: %.1f", currentSlot, dist)
            StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
            setWalkSpeed(humanoid, SPOOFED_WALKSPEED)
            task.wait(1)
            continue
        end

        -- Caminar al destino
        StatusLabel.Text = string.format("🚶 Going to Slot %d...", currentSlot)
        StatusLabel.TextColor3 = Color3.fromRGB(100, 180, 255)

        local offset = getRandomOffset()
        local targetPos = Vector3.new(TARGET_X + offset.X, root.Position.Y, TARGET_Z + offset.Z)

        setWalkSpeed(humanoid, REAL_WALKSPEED)
        humanoid:MoveTo(targetPos)

        local startTime = tick()
        local arrived = false
        local shouldReset = false

        while posActive do
            -- Verificar que el personaje sigue vivo
            local _, r2, h2 = getCharParts()
            if not r2 or not h2 or h2.Health <= 0 then
                -- Personaje murió, salir del loop interno
                -- y esperar respawn en el loop externo
                break
            end

            local currentDist = getDistanceFromTarget(r2)
            local elapsed = tick() - startTime

            -- Llegó al destino
            if currentDist < 6 then
                arrived = true
                break
            end

            -- Timeout de 6 segundos
            if elapsed >= ARRIVAL_TIMEOUT then
                StatusLabel.Text = string.format("⏱️ Timeout (%.1fs) — Resetting!", elapsed)
                StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
                shouldReset = true
                break
            end

            -- Mostrar cuenta regresiva
            local remaining = ARRIVAL_TIMEOUT - elapsed
            StatusLabel.Text = string.format("🚶 %.1fs left | Dist: %.1f", remaining, currentDist)
            StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)

            -- Re-enviar MoveTo periódicamente
            if elapsed % 1.5 < 0.12 then
                h2:MoveTo(targetPos)
            end

            task.wait(0.1)
        end

        -- Si llegó, frenar
        if arrived then
            local _, _, h3 = getCharParts()
            if h3 then setWalkSpeed(h3, SPOOFED_WALKSPEED) end
        end

        -- Si hay que resetear, hacerlo y ESPERAR el respawn
        if shouldReset and posActive then
            resetPlayer()
            -- NO hacer continue inmediatamente
            -- El loop externo llamará waitForCharacter()
            -- que ESPERA el CharacterAdded + 2s extra
        end
    end
end
