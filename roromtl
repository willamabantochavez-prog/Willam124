    plusBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    plusBtn.TextSize = 14
    plusBtn.Font = Enum.Font.GothamBold
    plusBtn.BorderSizePixel = 0
    plusBtn.ZIndex = 6
    plusBtn.AutoButtonColor = false
    plusBtn.Parent = ctrlFrame
    Instance.new("UICorner", plusBtn).CornerRadius = UDim.new(0, 5)
    plusBtn.MouseEnter:Connect(function() plusBtn.BackgroundTransparency = 0.15 end)
    plusBtn.MouseLeave:Connect(function() plusBtn.BackgroundTransparency = 0 end)

    return minusBtn, valLabel, plusBtn
end

