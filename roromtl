    else
        PosToggle.Text = "🔓  Position Lock OFF"
        PosToggle.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        ptStroke.Color = Color3.fromRGB(100, 30, 30)
        StatusLabel.Text = "Status: Inactive"
        StatusLabel.TextColor3 = Color3.fromRGB(120, 120, 120)
