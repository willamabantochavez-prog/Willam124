local function lazyLoadAfk()
    local VU = game:GetService("VirtualUser")
    task.spawn(function()
        while state.afkActive do
            local wt = math.random(30, 90)
            for i = wt, 1, -1 do
                if not state.afkActive then break end
                afkLbls[2].Text = string.format("Next: %ds | Actions: %d", i, state.afkCount)
                task.wait(1)
            end
            if not state.afkActive then break end

            pcall(function()
                VU:CaptureController()
                VU:ClickButton2(Vector2.new())
            end)

            state.afkCount = state.afkCount + 1
            afkLbls[2].Text = string.format("Active | Actions: %d", state.afkCount)
            AfkStatus.Text = "🖱️ VirtualUser click"
            AfkStatus.TextColor3 = Color3.fromRGB(100, 200, 255)
            task.wait(0.5)
        end
    end)
end

