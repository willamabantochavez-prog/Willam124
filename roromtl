-- ════════════════════════════════
--   AUTO FARM LOGIC (6s RESET)
--   MoveTo → 6s timeout → Distance check → BreakJoints if not there
-- ════════════════════════════════

local farmResets = 0

local function autoFarmLoop()
    while autoFarmActive do
        local char, root, humanoid = getCharParts()

        if not root or not humanoid then
            FarmStatus.Text = "Waiting for character..."
            FarmStatus.TextColor3 = Color3.fromRGB(255, 200, 50)
            task.wait(1)
            continue
        end

        local dist = getDistanceFromTarget(root)

        if dist < TRIGGER_DIST then
            -- Already at target
            FarmStatus.Text = string.format("✅ At slot %d | Dist: %.1f", selectedSlot, dist)
            FarmStatus.TextColor3 = Color3.fromRGB(100, 255, 100)
            farmInfoLabels[2].Text = string.format("Status: Idle | Resets: %d", farmResets)
            setWalkSpeed(humanoid, SPOOFED_WALKSPEED)
            task.wait(0.5)
        else
            -- Walk to target
            local offset = getRandomOffset()
            local targetPos = Vector3.new(TARGET_X + offset.X, root.Position.Y, TARGET_Z + offset.Z)

            FarmStatus.Text = string.format("⚠ Walking to Slot %d...", selectedSlot)
            FarmStatus.TextColor3 = Color3.fromRGB(255, 140, 0)

            setWalkSpeed(humanoid, REAL_WALKSPEED)
            humanoid:MoveTo(targetPos)

            -- 6 second timeout
            local elapsed = 0
            local arrived = false

            while elapsed < MOVE_TIMEOUT do
                local _, r, h = getCharParts()
                if not r or not h then break end

                local d = (r.Position - targetPos).Magnitude
                FarmStatus.Text = string.format("Walking... %.1fs | Dist: %.1f", MOVE_TIMEOUT - elapsed, d)

                if d < 3 then
                    arrived = true
                    break
                end

                h:MoveTo(targetPos)
                task.wait(MOVE_CHECK_INTERVAL)
                elapsed = elapsed + MOVE_CHECK_INTERVAL
            end

            if arrived then
                FarmStatus.Text = string.format("✅ Reached Slot %d!", selectedSlot)
                FarmStatus.TextColor3 = Color3.fromRGB(100, 255, 100)
                local _, _, h = getCharParts()
                if h then setWalkSpeed(h, SPOOFED_WALKSPEED) end
                task.wait(0.5)
            else
                -- TIMEOUT → RESET
                farmResets = farmResets + 1
                farmInfoLabels[2].Text = string.format("Status: Reset #%d...", farmResets)
                FarmStatus.Text = string.format("🔄 Timeout! Reset #%d", farmResets)
                FarmStatus.TextColor3 = Color3.fromRGB(255, 100, 100)

                resetCharacter()

                -- Wait for respawn
                task.wait(3)
                local _, _, h = getCharParts()
                if h then
                    FarmStatus.Text = "Respawned, walking again..."
                    FarmStatus.TextColor3 = Color3.fromRGB(255, 200, 50)
                end
                task.wait(1)
            end
        end
    end
end

