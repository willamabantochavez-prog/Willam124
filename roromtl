    jumpsActive = not jumpsActive

    if jumpsActive then
        local targetName = UserBox.Text:gsub("%s+", "")
        local jumpsText = JumpsBox.Text:gsub("%s+", "")

        if targetName == "" then
            UserBox.PlaceholderText = "⚠ Enter username!"
            jumpsActive = false
            return
        end

        local jumpsValue = getJumpsValue(jumpsText)
        if not jumpsValue then
            JumpsBox.PlaceholderText = "⚠ Enter 1-∞ or 'inf'!"
            jumpsActive = false
            return
        end

        local found = Players:FindFirstChild(targetName)
        if not found then
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Name:lower():sub(1, #targetName) == targetName:lower() then
                    targetName = p.Name
                    UserBox.Text = p.Name
                    found = p
                    break
                end
            end
        end

        if not found then
            UserBox.PlaceholderText = "⚠ Player not found!"
            UserBox.Text = ""
            jumpsActive = false
            return
        end

        JumpsToggle.Text = "✅  ExtraJumps ON"
        JumpsToggle.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
        jtStroke.Color = Color3.fromRGB(30, 100, 30)

        applyExtraJumps(targetName, jumpsValue)

        local conn = RunService.Heartbeat:Connect(function()
            if not jumpsActive then return end
            applyExtraJumps(targetName, jumpsValue)
        end)
        table.insert(allConnections, conn)
    else
        JumpsToggle.Text = "⛔  ExtraJumps OFF"
        JumpsToggle.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        jtStroke.Color = Color3.fromRGB(100, 30, 30)
    end
end)

-- ════════════════════════════════
--   AUTO FARM / POSITION LOCK
--   Resets player if > 10 studs
-- ════════════════════════════════

local function positionLockLoop()
    while posActive do
        local char, root, humanoid = getCharParts()

        if not root or not humanoid then
            StatusLabel.Text = "Status: Waiting for character..."
            StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
            task.wait(1)
            continue
        end

        local dist = getDistanceFromTarget(root)

        -- RESET if too far from target
        if dist > RESET_RADIUS then
            StatusLabel.Text = string.format("⚠ Too far (%.1f) — Resetting!", dist)
            StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
            task.wait(0.3)
            resetPlayer()
            task.wait(3)
            continue
        end

        -- CLOSE ENOUGH — stay put
        StatusLabel.Text = string.format("✅ At position | Dist: %.1f", dist)
        StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
        setWalkSpeed(humanoid, SPOOFED_WALKSPEED)

        -- Periodically nudge to stay within radius
        task.wait(1)

        if not posActive then break end

        local _, r2, h2 = getCharParts()
        if r2 and h2 then
            local d2 = getDistanceFromTarget(r2)
            if d2 > RESET_RADIUS * 0.8 then
                -- Walk back to center if drifting
                local offset = getRandomOffset()
                local targetPos = Vector3.new(TARGET_X + offset.X, r2.Position.Y, TARGET_Z + offset.Z)
                walkToPosition(targetPos, function(d)
                    if posActive then
                        StatusLabel.Text = string.format("⚠ Correcting... | Dist: %.1f", d)
                    end
                end)
                local _, _, h3 = getCharParts()
                if h3 then setWalkSpeed(h3, SPOOFED_WALKSPEED) end
            end
        end
    end
end

PosToggle.MouseButton1Click:Connect(function()
    posActive = not posActive

    if posActive then
        PosToggle.Text = "🔒  Position Lock ON"
        PosToggle.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
        ptStroke.Color = Color3.fromRGB(30, 100, 30)
        StatusLabel.Text = "Status: Active..."
        StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
