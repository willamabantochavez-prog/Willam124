local function applyScale(newScale)
    currentScale = math.clamp(newScale, minScale, maxScale)
    local w = math.floor(BASE_WIDTH * currentScale + 0.5)
    local h = math.floor(BASE_HEIGHT * currentScale + 0.5)

    MainFrame.Size = UDim2.new(0, w, 0, h)
    MainFrame.Position = UDim2.new(0.5, -w / 2, 0.5, -h / 2)

    SizeDisplay.Text = math.floor(currentScale * 100 + 0.5) .. "%"
end

local allTextElements = {}

local function recolorTextForScale()
    for _, desc in ipairs(MainFrame:GetDescendants()) do
        if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
            if not allTextElements[desc] then
                allTextElements[desc] = desc.TextSize
            end
            local base = allTextElements[desc]
            desc.TextSize = math.max(8, math.floor(base * currentScale + 0.5))
        end
    end
end

local function showPanel(panel)
    if panel == "main" then
        MainPanel.Visible = true
        SettingsPanel.Visible = false
        currentPanel = "main"
        SettingsBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    else
        MainPanel.Visible = false
        SettingsPanel.Visible = true
        currentPanel = "settings"
        SettingsBtn.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
    end
end

local function setMinimized(state)
    isMinimized = state
    if isMinimized then
        ContentFrame.Visible = false
        local w = math.floor(BASE_WIDTH * currentScale + 0.5)
        MainFrame.Size = UDim2.new(0, w, 0, 38)
        MainFrame.Position = UDim2.new(0.5, -w / 2, 0.5, -19)
        CloseBtn.Text = "+"
    else
        applyScale(currentScale)
        ContentFrame.Visible = true
        CloseBtn.Text = "−"
    end
end

