local function getCharParts()
    local char = LocalPlayer.Character
    if not char then return nil, nil, nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    return char, root, humanoid
end

local function getRandomOffset()
    return Vector3.new(
        math.random() * POSITION_VARIANCE * 2 - POSITION_VARIANCE,
        0,
        math.random() * POSITION_VARIANCE * 2 - POSITION_VARIANCE
    )
end

local function getDistFromTarget(root)
    local dx = root.Position.X - TARGET_X
    local dz = root.Position.Z - TARGET_Z
    return math.sqrt(dx * dx + dz * dz)
end

local function setWS(humanoid, speed)
    pcall(function() humanoid.WalkSpeed = speed end)
end

local function doJump()
    pcall(function()
        local _, _, humanoid = getCharParts()
        if humanoid then humanoid.Jump = true end
    end)
end

-- ══════════════════════════════════════
--   BODYPOSITION MOVEMENT (PHYSICS)
--   Anti-cheat sees: physical force, not teleport
-- ══════════════════════════════════════

local activeBodyPos = nil

local function createBodyPosition(root)
    -- Clean any existing one
    if activeBodyPos then
        pcall(function() activeBodyPos:Destroy() end)
        activeBodyPos = nil
    end

    local bp = Instance.new("BodyPosition")
    bp.MaxForce = Vector3.new(BP_FORCE, 0, BP_FORCE)  -- No Y force (gravity stays)
    bp.P = BP_POWER
    bp.D = BP_DAMPING
    bp.Parent = root
    activeBodyPos = bp
    return bp
end

local function removeBodyPosition()
    if activeBodyPos then
        pcall(function() activeBodyPos:Destroy() end)
        activeBodyPos = nil
    end
end

local function walkToWithBodyPosition(targetX, targetZ, timeoutSec, statusCb)
    local char, root, humanoid = getCharParts()
    if not root or not humanoid then return false end

    -- Add small random offset for natural look
    local offset = getRandomOffset()
    local finalX = targetX + offset.X
    local finalZ = targetZ + offset.Z
    local finalPos = Vector3.new(finalX, root.Position.Y, finalZ)

    -- Create BodyPosition (physics-based movement)
    local bp = createBodyPosition(root)
    bp.Position = finalPos

    -- Wait until arrival or timeout
    local elapsed = 0
    local timeout = timeoutSec or MOVE_TIMEOUT
    local arrived = false

    while elapsed < timeout do
        local _, r, h = getCharParts()
        if not r or not h then
            removeBodyPosition()
            return false
        end

        local dist = (r.Position - finalPos).Magnitude

        if statusCb then statusCb(dist, timeout - elapsed) end

        if dist < 3 then
            arrived = true
            break
        end

        -- Keep updating position (in case character got pushed)
        bp.Position = finalPos

        task.wait(MOVE_CHECK_INTERVAL)
        elapsed = elapsed + MOVE_CHECK_INTERVAL
    end

    removeBodyPosition()
    return arrived
end

