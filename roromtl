-- ════════════════════════════════
--   ANTI AFK LOGIC
-- ════════════════════════════════

local afkCount = 0

local function antiAfkLoop()
    while afkActive do
        local waitTime = math.random(afkIntervalMin, afkIntervalMax)

        for i = waitTime, 1, -1 do
            if not afkActive then break end
            afkInfoLabels[2].Text = string.format("Next: %ds | Total: %d", i, afkCount)
            task.wait(1)
        end

        if not afkActive then break end

        local action = math.random(1, 4)

        if action == 1 then
            pcall(function()
                VirtualInputManager:SendMouseMoveEvent(math.random(-10, 10), math.random(-10, 10), game)
            end)
            AfkStatus.Text = "🖱️ Mouse move"
        elseif action == 2 then
            local keys = {Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D}
            local key = keys[math.random(1, #keys)]
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, key, false, game)
                task.wait(math.random() * 0.2 + 0.05)
                VirtualInputManager:SendKeyEvent(false, key, false, game)
            end)
            AfkStatus.Text = "⌨️ Key press"
        elseif action == 3 then
            pcall(function()
                local _, _, humanoid = getCharParts()
                if humanoid then humanoid.Jump = true end
            end)
            AfkStatus.Text = "🦘 Jump"
        elseif action == 4 then
            pcall(function()
                local cx = workspace.CurrentCamera.ViewportSize.X / 2
                local cy = workspace.CurrentCamera.ViewportSize.Y / 2
                VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 1)
                task.wait(0.05)
                VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 1)
            end)
            AfkStatus.Text = "🖱️ Click"
        end

        afkCount = afkCount + 1
        afkInfoLabels[2].Text = string.format("Status: Active | Total: %d", afkCount)
        AfkStatus.TextColor3 = Color3.fromRGB(100, 200, 255)
        task.wait(0.5)
    end
end

AfkToggle.MouseButton1Click:Connect(function()
    afkActive = not afkActive

    if afkActive then
        AfkToggle.Text = "✅  Anti AFK ON"
        AfkToggle.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
        afkStroke.Color = Color3.fromRGB(30, 100, 30)
        AfkStatus.Text = "Status: Active..."
        AfkStatus.TextColor3 = Color3.fromRGB(100, 255, 100)
        task.spawn(antiAfkLoop)
    else
        AfkToggle.Text = "💤  Anti AFK OFF"
        AfkToggle.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        afkStroke.Color = Color3.fromRGB(100, 30, 30)
        AfkStatus.Text = "Idle"
        AfkStatus.TextColor3 = Color3.fromRGB(120, 120, 120)
        afkInfoLabels[2].Text = "Status: Inactive | Clicks: 0"
    end
end)

