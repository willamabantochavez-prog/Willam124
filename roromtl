    s.Color = Color3.fromRGB(100, 30, 30)
    s.Thickness = 1.5
    s.Parent = btn
    btn.MouseEnter:Connect(function() btn.BackgroundTransparency = 0.1 end)
    btn.MouseLeave:Connect(function() btn.BackgroundTransparency = 0 end)
    return btn, s
