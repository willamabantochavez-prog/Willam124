local function lazyLoadAfk()
    local VirtualUser = game:GetService("VirtualUser")

    task.spawn(function()
        while state.afkActive do
            local waitTime = math.random(state.afkIntervalMin, state.afkIntervalMax)
            for i = waitTime, 1, -1 do
                if not state.afkActive then break end
                afkInfoLabels[2].Text = string.format("Next: %ds | Actions: %d", i, state.afkCount)
                task.wait(1)
            end
            if not state.afkActive then break end

            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new())
            end)

            state.afkCount = state.afkCount + 1
            afkInfoLabels[2].Text = string.format("Active | Actions: %d", state.afkCount)
            AfkStatus.Text = "🖱️ VirtualUser click"
            AfkStatus.TextColor3 = Color3.fromRGB(100, 200, 255)
            task.wait(0.5 + math.random() * 0.5)
        end
    end)
end

local function unloadAfk()
    state.afkActive = false
    AfkStatus.Text = "Idle"
    AfkStatus.TextColor3 = Color3.fromRGB(120, 120, 120)
    afkInfoLabels[2].Text = "Next: -- | Actions: 0"
end

