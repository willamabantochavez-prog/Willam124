-- Setting row builder
local function makeSettingRow(parent, label, default, minVal, maxVal, onChange)
    local row = makeCard(parent, 36)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -100, 1, 0)
    lbl.Position = UDim2.new(0, 12, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.TextColor3 = Color3.fromRGB(255, 140, 0)
    lbl.TextSize = 11
    lbl.Font = Enum.Font.GothamBold
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 5
    lbl.Parent = row

    local input = makeInput(row, 50, default, -96)
    local apply = makeApply(row, -40)

    apply.MouseButton1Click:Connect(function()
        local val = tonumber(input.Text)
        if val and val >= minVal and val <= maxVal then
            onChange(val)
            apply.BackgroundColor3 = Color3.fromRGB(60, 180, 60)
            task.delay(0.6, function() apply.BackgroundColor3 = Color3.fromRGB(40, 130, 40) end)
        else
            apply.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
            task.delay(0.6, function() apply.BackgroundColor3 = Color3.fromRGB(40, 130, 40) end)
        end
    end)

    return row, input, apply
end

