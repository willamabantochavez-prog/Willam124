-- ══════════════════════════════════════
--   POSITION LOCK (6s TIMEOUT)
-- ══════════════════════════════════════

local function farmLoop()
    while pOn do
        local c, r, h = gCP()
        if not r or not h then
            stLabel.Text = "Status: Waiting character..."
            stLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
            task.wait(1 + math.random() * 0.5)
            continue
        end

        local d = dist(r)

        -- Already at destination
        if d < 5 then
            stLabel.Text = string.format("✅ Slot %d | Dist: %.1f", cSlot, d)
            stLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
            sWS(h, SW)

            -- Random anti-AFK micro-movement while parked
            task.wait(1.5 + math.random() * 1.5)

            -- Small random nudge to seem natural
            if pOn then
                local nudge = rndOff() * 0.3
                local nudgePos = Vector3.new(r.Position.X + nudge.X, r.Position.Y, r.Position.Z + nudge.Z)
                h:MoveTo(nudgePos)
                task.wait(0.3 + math.random() * 0.3)
            end
            continue
        end

        -- Need to walk to slot
        stLabel.Text = string.format("🚶 Slot %d | Walking...", cSlot)
        stLabel.TextColor3 = Color3.fromRGB(100, 180, 255)

        local off = rndOff()
        local tPos = Vector3.new(TX + off.X, r.Position.Y, TZ + off.Z)

        local startT = tick()
        sWS(h, RW)
        h:MoveTo(tPos)

        local arrived = false
        while pOn do
            local cd = dist(r)
            local elapsed = tick() - startT

            if cd < 6 then
                arrived = true
                break
            end

            if elapsed >= TIMEOUT then
                stLabel.Text = string.format("⏱️ Timeout %.1fs → Reset!", elapsed)
                stLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
                task.wait(0.3 + math.random() * 0.4)
                rst()
                task.wait(3 + math.random())
                break
            end

            local rem = TIMEOUT - elapsed
            stLabel.Text = string.format("🚶 %.1fs left | Dist: %.1f", rem, cd)
            stLabel.TextColor3 = Color3.fromRGB(255, 200, 50)

            -- Re-issue MoveTo periodically (some games cancel it)
            if elapsed > 0 and elapsed % 1.5 < 0.1 then
                h:MoveTo(tPos)
            end

            task.wait(0.08 + math.random() * 0.04)
        end

        if arrived then
            local _, _, h2 = gCP()
            if h2 then sWS(h2, SW) end
        end
    end
end

