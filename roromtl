-- ════════════════════════════════
--   CHARACTER HELPERS
-- ════════════════════════════════

local function getCharParts()
    local char = LocalPlayer.Character
    if not char then return nil, nil, nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    return char, root, humanoid
end

local function getDistXZ(root)
    local dx = root.Position.X - TARGET_X
    local dz = root.Position.Z - TARGET_Z
    return math.sqrt(dx * dx + dz * dz)
end

local function doJump()
    pcall(function()
        local _, _, humanoid = getCharParts()
        if humanoid then humanoid.Jump = true end
    end)
end

local function updateSlotDisplay()
    local slot = SLOTS[selectedSlot]
    if slotDisplay then
        slotDisplay.Text = tostring(selectedSlot)
    end
    if infoLabels and infoLabels[2] then
        infoLabels[2].Text = string.format(
            "Slot: %d (%.0f, %.0f) | Jumps: %d",
            selectedSlot, slot.x, slot.z, farmJumps
        )
    end
end

-- ════════════════════════════════════════════════════════
--   AUTO FARM LOGIC
--   Walk → detect stuck → jump → keep going
-- ════════════════════════════════════════════════════════

local function autoFarmLoop()
    while farmActive do
        local char, root, humanoid = getCharParts()

        if not root or not humanoid then
            farmState = "Waiting for character..."
            task.wait(1)
            continue
        end

        pcall(function() humanoid.WalkSpeed = WALKSPEED end)

        local dist = getDistXZ(root)

        -- ── ARRIVED ──
        if dist < TRIGGER_DIST then
            farmState = string.format("✅ At Slot %d | Dist: %.1f", selectedSlot, dist)
            task.wait(2)
            continue
        end

        -- ── WALK TO TARGET ──
        farmState = string.format("📍 Walking to Slot %d...", selectedSlot)

        local bestDist = dist
        local timeSinceProgress = 0

        while farmActive do
            local _, r, h = getCharParts()
            if not r or not h then
                farmState = "Lost character..."
                break
            end

            local targetPos = Vector3.new(TARGET_X, r.Position.Y, TARGET_Z)
            pcall(function() h:MoveTo(targetPos) end)

            local d = getDistXZ(r)

            -- Arrived
            if d < TRIGGER_DIST then
                farmState = string.format("✅ Reached Slot %d!", selectedSlot)
                break
            end

            -- Progress tracking
            if d < bestDist - 1 then
                bestDist = d
                timeSinceProgress = 0
                farmState = string.format("🚶 Walking | Dist: %.1f", d)
            else
                timeSinceProgress = timeSinceProgress + 0.2

                if timeSinceProgress >= STUCK_TIME then
                    -- STUCK → Jump
                    farmJumps = farmJumps + 1
                    farmState = string.format("🦘 Jump #%d | Dist: %.1f", farmJumps, d)

                    doJump()
                    task.wait(0.4)
                    doJump()
                    task.wait(0.3)

                    timeSinceProgress = 0
                    bestDist = d
                    farmState = string.format("🔄 Retrying | Dist: %.1f", d)
                else
                    local pct = math.min(timeSinceProgress / STUCK_TIME, 1) * 100
                    farmState = string.format("🚶 Dist: %.1f | Stuck: %.0f%%", d, pct)
                end
            end

            task.wait(0.2)
        end

        -- Landed after walking
        if farmActive then
            local _, r, _ = getCharParts()
            if r and getDistXZ(r) < TRIGGER_DIST then
                farmState = string.format("✅ At Slot %d | Waiting...", selectedSlot)
                task.wait(2)
            end
        end
    end
end

