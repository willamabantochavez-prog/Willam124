-- ════════════════════════════════
--   POSITION LOCK (Natural)
-- ════════════════════════════════

local function positionLockLoop()
    while posActive do
        local char, root, humanoid = getCharParts()
        if not root or not humanoid then
            StatusLabel.Text = "Status: Waiting for character..."
            StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
            task.wait(1 + math.random() * 0.5)
            continue
        end

        local dist = getDistanceFromTarget(root)

        -- TOO FAR
        if dist > RESET_RADIUS then
            if canReset() then
                StatusLabel.Text = string.format("⚠ Too far (%.1f) — Resetting!", dist)
                StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
                task.wait(0.3 + math.random() * 0.3)
                resetPlayer()
                task.wait(3 + math.random() * 2)
            else
                StatusLabel.Text = string.format("⚠ Too far (%.1f) — Cooldown...", dist)
                StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
                task.wait(1)
            end
            continue
        end

        -- AT POSITION
        local targetSpeed = BASE_WALKSPEED + math.random() * 2 - 1
        setWalkSpeed(humanoid, targetSpeed)
        StatusLabel.Text = string.format("✅ At position | Dist: %.1f", dist)
        StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)

        task.wait(2 + math.random() * 3)
        if not posActive then break end

        local _, r2, h2 = getCharParts()
        if r2 and h2 then
            local d2 = getDistanceFromTarget(r2)

            if d2 > RESET_RADIUS * 0.6 then
                -- DRIFTING → walk back
                StatusLabel.Text = string.format("⚠ Drifting (%.1f) — Correcting...", d2)
                StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)

                local offset = getRandomOffset()
                local targetPos = Vector3.new(TARGET_X + offset.X, r2.Position.Y, TARGET_Z + offset.Z)

                local result = walkToPositionNatural(targetPos, function(d)
                    if posActive then
                        StatusLabel.Text = string.format("🔄 Moving... | Dist: %.1f", d)
                        StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
                    end
                end)

                if result == "stuck" then
                    if canReset() then
                        StatusLabel.Text = "⚠ Stuck — Resetting!"
                        StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
                        task.wait(0.5 + math.random() * 0.5)
                        resetPlayer()
                        task.wait(3 + math.random() * 2)
                    else
                        StatusLabel.Text = "⚠ Stuck — Cooldown..."
                        StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
                        task.wait(1)
                    end
                    continue
                elseif result == "lost" then
                    StatusLabel.Text = "⚠ Character lost — Waiting..."
                    StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
                    task.wait(2)
                    continue
                end

                local _, _, h3 = getCharParts()
                if h3 then setWalkSpeed(h3, BASE_WALKSPEED + math.random() * 2 - 1) end
            else
                -- Small random idle movement
                if math.random() < 0.15 then
                    local small = Vector3.new(math.random() * 2 - 1, 0, math.random() * 2 - 1)
                    humanoid:MoveTo(root.Position + small)
                    task.wait(0.5 + math.random() * 0.5)
                    humanoid:MoveTo(Vector3.new(TARGET_X, root.Position.Y, TARGET_Z))
                end
            end
        end
    end
end

