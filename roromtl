local function positionLockLoop()
    while posActive do
        local char, root, humanoid = getCharParts()

        if not root or not humanoid then
            StatusLabel.Text = "Status: Waiting for character..."
            StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
            task.wait(1)
            continue
        end

        local dist = getDistanceFromTarget(root)

        if dist < TRIGGER_DIST then
            StatusLabel.Text = string.format("✅ At Slot %d | Dist: %.1f", selectedSlot, dist)
            StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
            setWalkSpeed(humanoid, SPOOFED_WALKSPEED)
            task.wait(0.5)
        else
            StatusLabel.Text = string.format("⚠ Returning to Slot %d... | Dist: %.1f", selectedSlot, dist)
            StatusLabel.TextColor3 = Color3.fromRGB(255, 140, 0)

            task.wait(math.random() * 0.3 + 0.1)
            if not posActive then break end

            local offset = getRandomOffset()
            local targetPos = Vector3.new(TARGET_X + offset.X, root.Position.Y, TARGET_Z + offset.Z)

            local reached = walkToPosition(targetPos, function(d)
                if posActive then
                    StatusLabel.Text = string.format("⚠ Walking... | Dist: %.1f", d)
                end
            end, MOVE_TIMEOUT)

            if reached then
                StatusLabel.Text = string.format("✅ At Slot %d!", selectedSlot)
                StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
            else
                StatusLabel.Text = "⚠ Timed out, retrying..."
                StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            end

            local _, _, h = getCharParts()
            if h then setWalkSpeed(h, SPOOFED_WALKSPEED) end
            task.wait(0.5)
        end
    end
end

