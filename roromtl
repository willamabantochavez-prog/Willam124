-- ══════════════════════════════════════
--   ANTI AFK - NATIVE API ONLY
--   NO VirtualInputManager
--   Uses: Humanoid.Jump + Humanoid:ChangeState
-- ══════════════════════════════════════

local afkCount = 0

local function antiAfkLoop()
    while afkActive do
        local waitTime = math.random(afkIntervalMin, afkIntervalMax)

        -- Countdown
        for i = waitTime, 1, -1 do
            if not afkActive then break end
            afkInfoLabels[2].Text = string.format("Next: %ds | Actions: %d", i, afkCount)
            task.wait(1)
        end

        if not afkActive then break end

        -- Pick a native-only action
        local action = math.random(1, 3)

        if action == 1 then
            -- Jump (native Humanoid property)
            local _, _, humanoid = getCharParts()
            if humanoid then
                humanoid.Jump = true
            end
            AfkStatus.Text = "🦘 Jump"

        elseif action == 2 then
            -- ChangeState (native Humanoid method)
            local _, _, humanoid = getCharParts()
            if humanoid then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
            AfkStatus.Text = "⬆️ State change"

        elseif action == 3 then
            -- Tiny MoveTo nudge (native Humanoid method)
            local _, root, humanoid = getCharParts()
            if root and humanoid then
                local nudgeX = math.random(-1, 1) * 0.5
                local nudgeZ = math.random(-1, 1) * 0.5
                local nudgePos = Vector3.new(
                    root.Position.X + nudgeX,
                    root.Position.Y,
                    root.Position.Z + nudgeZ
                )
                humanoid:MoveTo(nudgePos)
            end
            AfkStatus.Text = "👟 Micro-move"
        end

        afkCount = afkCount + 1
        afkInfoLabels[2].Text = string.format("Active | Actions: %d", afkCount)
        AfkStatus.TextColor3 = Color3.fromRGB(100, 200, 255)
        task.wait(0.5)
    end
end

AfkToggle.MouseButton1Click:Connect(function()
    afkActive = not afkActive

    if afkActive then
        AfkToggle.Text = "✅  Anti AFK ON"
        AfkToggle.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
        afkStroke.Color = Color3.fromRGB(30, 100, 30)
        AfkStatus.Text = "Active..."
        AfkStatus.TextColor3 = Color3.fromRGB(100, 255, 100)
        task.spawn(antiAfkLoop)
    else
        AfkToggle.Text = "💤  Anti AFK OFF"
        AfkToggle.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        afkStroke.Color = Color3.fromRGB(100, 30, 30)
        AfkStatus.Text = "Idle"
        AfkStatus.TextColor3 = Color3.fromRGB(120, 120, 120)
        afkInfoLabels[2].Text = "Next: -- | Actions: 0"
    end
end)

