local function makeInfoBox(parent, lines)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 14 * #lines + 10)
    frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    frame.BorderSizePixel = 0
    frame.LayoutOrder = nextOrder()
    frame.Parent = parent
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)
    local s = Instance.new("UIStroke")
    s.Color = Color3.fromRGB(50, 50, 50)
    s.Thickness = 1
    s.Parent = frame
    local labels = {}
    for i, line in ipairs(lines) do
        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1, -10, 0, 14)
        l.Position = UDim2.new(0, 5, 0, 5 + (i - 1) * 14)
        l.BackgroundTransparency = 1
        l.Text = line
        l.TextColor3 = Color3.fromRGB(255, 140, 0)
        l.TextSize = 11
        l.Font = Enum.Font.GothamBold
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.Parent = frame
        labels[i] = l
    end
    return frame, labels
end

