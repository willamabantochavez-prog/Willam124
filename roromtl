local function getCharParts()
    local char = LocalPlayer.Character
    if not char then return nil, nil, nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    return char, root, humanoid
end

local function getRandomOffset()
    return Vector3.new(
        math.random() * POSITION_VARIANCE * 2 - POSITION_VARIANCE,
        0,
        math.random() * POSITION_VARIANCE * 2 - POSITION_VARIANCE
    )
end

local function getDistanceFromTarget(root)
    local dx = root.Position.X - TARGET_X
    local dz = root.Position.Z - TARGET_Z
    return math.sqrt(dx * dx + dz * dz)
end

local function setWalkSpeed(humanoid, speed)
    pcall(function() humanoid.WalkSpeed = speed end)
end

local function canReset()
    return (tick() - lastResetTime) >= RESET_COOLDOWN
end

local function resetPlayer()
    if not canReset() then return false end
    lastResetTime = tick()
    local char = LocalPlayer.Character
    if char then char:BreakJoints() end
    return true
end

-- Natural movement with intermediate waypoints
local function walkToPositionNatural(targetPos, statusCallback)
    local char, root, humanoid = getCharParts()
    if not root or not humanoid then return "lost" end

    local startPos = root.Position
    local adjustedTarget = Vector3.new(targetPos.X, startPos.Y, targetPos.Z)
    local totalDist = (startPos - adjustedTarget).Magnitude

    -- Short distance: direct
    if totalDist < 5 then
        humanoid:MoveTo(adjustedTarget)
        local elapsed = 0
        while elapsed < 3 do
            local _, r, h = getCharParts()
            if not r or not h then return "lost" end
            local dist = (r.Position - adjustedTarget).Magnitude
            if statusCallback then statusCallback(dist) end
            if dist < 3 then return "reached" end
            h:MoveTo(adjustedTarget)
            task.wait(0.1 + math.random() * 0.05)
            elapsed = elapsed + 0.1
        end
        return "stuck"
    end

    -- Longer: intermediate waypoints with random offsets
    local numWP = math.random(2, 3)
    local waypoints = {}
    for i = 1, numWP - 1 do
        local t = i / numWP
        local mid = startPos:Lerp(adjustedTarget, t)
        mid = mid + Vector3.new(math.random() * 6 - 3, 0, math.random() * 6 - 3)
        table.insert(waypoints, mid)
    end
    table.insert(waypoints, adjustedTarget)

    for idx, point in ipairs(waypoints) do
        local _, r, h = getCharParts()
        if not r or not h then return "lost" end
        h:MoveTo(point)

        local elapsed = 0
        local lastDist = math.huge
        local stallTimer = 0

        while elapsed < 4 do
            local _, r2, h2 = getCharParts()
            if not r2 or not h2 then return "lost" end
            local dist = (r2.Position - point).Magnitude
            if statusCallback then statusCallback(dist) end
            if dist < 3 then break end

            if math.abs(dist - lastDist) < 0.3 then
                stallTimer = stallTimer + 0.1
            else
                stallTimer = 0
            end
            lastDist = dist
            if stallTimer >= STALL_TIMEOUT then return "stuck" end

            h2:MoveTo(point)
            task.wait(0.1 + math.random() * 0.05)
            elapsed = elapsed + 0.1
        end

        if idx < #waypoints then
            task.wait(0.3 + math.random() * 0.5)
        end
    end

    local _, r3, _ = getCharParts()
    if r3 and (r3.Position - adjustedTarget).Magnitude < 5 then
        return "reached"
    end
    return "stuck"
end

