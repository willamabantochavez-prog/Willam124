-- ══════════════════════════════════════
--   POSITION LOCK - 6 SECOND TIMEOUT
--   Uses ONLY Humanoid:MoveTo (native)
-- ══════════════════════════════════════

local function positionLockLoop()
    while posActive do
        local char, root, humanoid = getCharParts()

        if not root or not humanoid then
            StatusLabel.Text = "Status: Waiting for character..."
            StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
            task.wait(1)
            continue
        end

        local dist = getDistanceFromTarget(root)

        -- Already at destination
        if dist < 6 then
            StatusLabel.Text = string.format("✅ At Slot %d | Dist: %.1f", currentSlot, dist)
            StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
            setWalkSpeed(humanoid, SPOOFED_WALKSPEED)
            task.wait(1)
            continue
        end

        -- Need to walk to target
        StatusLabel.Text = string.format("🚶 Going to Slot %d...", currentSlot)
        StatusLabel.TextColor3 = Color3.fromRGB(100, 180, 255)

        local offset = getRandomOffset()
        local targetPos = Vector3.new(TARGET_X + offset.X, root.Position.Y, TARGET_Z + offset.Z)

        setWalkSpeed(humanoid, REAL_WALKSPEED)
        humanoid:MoveTo(targetPos)

        local startTime = tick()
        local arrived = false

        while posActive do
            local _, r2, h2 = getCharParts()
            if not r2 or not h2 then
                task.wait(0.5)
                break
            end

            local currentDist = getDistanceFromTarget(r2)
            local elapsed = tick() - startTime

            -- Arrived!
            if currentDist < 6 then
                arrived = true
                break
            end

            -- 6 second timeout - RESET
            if elapsed >= ARRIVAL_TIMEOUT then
                StatusLabel.Text = string.format("⏱️ Timeout (%.1fs) — Resetting!", elapsed)
                StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
                task.wait(0.3)
                resetPlayer()
                task.wait(3)
                break
            end

            -- Show countdown
            local remaining = ARRIVAL_TIMEOUT - elapsed
            StatusLabel.Text = string.format("🚶 %.1fs left | Dist: %.1f", remaining, currentDist)
            StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)

            -- Re-issue MoveTo periodically
            if elapsed % 1.5 < 0.12 then
                humanoid:MoveTo(targetPos)
            end

            task.wait(0.1)
        end

        if arrived then
            local _, _, h3 = getCharParts()
            if h3 then setWalkSpeed(h3, SPOOFED_WALKSPEED) end
        end
    end
end

