-- ════════════════════════════════
--   AUTO FARM (BodyPosition + 6s + Jump x2)
-- ════════════════════════════════

local farmResets = 0

local function autoFarmLoop()
    while autoFarmActive do
        local char, root, humanoid = getCharParts()

        if not root or not humanoid then
            FarmStatus.Text = "Waiting for character..."
            FarmStatus.TextColor3 = Color3.fromRGB(255, 200, 50)
            task.wait(1)
            continue
        end

        local dist = getDistFromTarget(root)

        if dist < TRIGGER_DIST then
            -- Already at target
            FarmStatus.Text = string.format("✅ At Slot %d | Dist: %.1f", selectedSlot, dist)
            FarmStatus.TextColor3 = Color3.fromRGB(100, 255, 100)
            farmInfoLabels[2].Text = string.format("Slot: %d | Retries: %d | State: Idle", selectedSlot, farmResets)
            removeBodyPosition()
            task.wait(0.5)
        else
            -- Walk using BodyPosition (physics!)
            FarmStatus.Text = string.format("⚠ Walking to Slot %d...", selectedSlot)
            FarmStatus.TextColor3 = Color3.fromRGB(255, 140, 0)
            farmInfoLabels[2].Text = string.format("Slot: %d | Retries: %d | State: Walking", selectedSlot, farmResets)

            local arrived = walkToWithBodyPosition(TARGET_X, TARGET_Z, MOVE_TIMEOUT, function(d, remaining)
                if autoFarmActive then
                    FarmStatus.Text = string.format("BodyPos %.1fs | Dist: %.1f", remaining, d)
                end
            end)

            if arrived then
                FarmStatus.Text = string.format("✅ Reached Slot %d!", selectedSlot)
                FarmStatus.TextColor3 = Color3.fromRGB(100, 255, 100)
                farmInfoLabels[2].Text = string.format("Slot: %d | Retries: %d | State: Arrived", selectedSlot, farmResets)
                task.wait(0.5)
            else
                -- TIMEOUT → Jump twice
                farmResets = farmResets + 1
                FarmStatus.Text = string.format("🦘 Timeout! Jumping x2... (#%d)", farmResets)
                FarmStatus.TextColor3 = Color3.fromRGB(255, 200, 50)
                farmInfoLabels[2].Text = string.format("Slot: %d | Retries: %d | State: Jumping", selectedSlot, farmResets)

                removeBodyPosition()

                -- Jump 1
                doJump()
                task.wait(0.6)

                -- Jump 2
                doJump()
                task.wait(0.4)

                FarmStatus.Text = "Retrying walk to Slot " .. selectedSlot .. "..."
                FarmStatus.TextColor3 = Color3.fromRGB(255, 140, 0)
                task.wait(0.5)
            end
        end
    end
end

