-- ██  LAZY LOAD: EXTRA JUMPS  ██
-- ══════════════════════════════════════════════════════════════

local function lazyLoadJumps()
    local Debris = game:GetService("Debris")
    local jv = state.jumpsValue
    local used = 0

    for _, c in ipairs(state.jumpsConns) do pcall(function() c:Disconnect() end) end
    state.jumpsConns = {}

    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end

    local landConn = hum.StateChanged:Connect(function(_, new)
        if new == Enum.HumanoidStateType.Landed then used = 0 end
    end)
    table.insert(state.jumpsConns, landConn)

    local jumpConn = UIS.JumpRequest:Connect(function()
        if not state.jumpsActive then return end
        if hum:GetState() == Enum.HumanoidStateType.Freefall and used < jv then
            used = used + 1
            local bv = Instance.new("BodyVelocity")
            bv.Name = "BV_" .. math.random(10000, 99999)
            bv.Velocity = Vector3.new(0, hum.JumpPower * CFG.JUMP_POWER_MULT, 0)
            bv.MaxForce = Vector3.new(0, math.huge, 0)
            bv.Parent = root
            Debris:AddItem(bv, CFG.BV_DURATION)
        end
    end)
    table.insert(state.jumpsConns, jumpConn)
end

local function unloadJumps()
    for _, c in ipairs(state.jumpsConns) do pcall(function() c:Disconnect() end) end
    state.jumpsConns = {}
    pcall(function()
        local c = LocalPlayer.Character
        if c then
            local r = c:FindFirstChild("HumanoidRootPart")
            if r then
                for _, ch in ipairs(r:GetChildren()) do
                    if ch:IsA("BodyVelocity") and ch.Name:match("^BV_") then ch:Destroy() end
                end
            end
        end
    end)
end

