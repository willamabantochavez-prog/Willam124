--   ANTI AFK LOGIC
-- ══════════════════════════════════════

local afkCnt = 0
local afkMin, afkMax = 30, 90

local function afkLoop()
    while aOn do
        local wt = math.random(afkMin, afkMax)
        for i = wt, 1, -1 do
            if not aOn then break end
            afkLabels[2].Text = string.format("Next: %ds | Actions: %d", i, afkCnt)
            task.wait(1)
        end
        if not aOn then break end

        local act = math.random(1, 5)

        if act == 1 then
            pcall(function() VIM:SendMouseMoveEvent(math.random(-8, 8), math.random(-8, 8), game) end)
            afkSt.Text = "🖱️ Mouse move"
        elseif act == 2 then
            local keys = {Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D}
            local k = keys[math.random(1, #keys)]
            pcall(function()
                VIM:SendKeyEvent(true, k, false, game)
                task.wait(math.random() * 0.15 + 0.05)
                VIM:SendKeyEvent(false, k, false, game)
            end)
            afkSt.Text = "⌨️ Key tap"
        elseif act == 3 then
            pcall(function()
                local _, _, hh = gCP()
                if hh then hh.Jump = true end
            end)
            afkSt.Text = "🦘 Jump"
        elseif act == 4 then
            pcall(function()
                local vx = workspace.CurrentCamera.ViewportSize.X / 2
                local vy = workspace.CurrentCamera.ViewportSize.Y / 2
                VIM:SendMouseButtonEvent(vx, vy, 0, true, game, 1)
                task.wait(0.04)
                VIM:SendMouseButtonEvent(vx, vy, 0, false, game, 1)
            end)
            afkSt.Text = "🖱️ Click"
        elseif act == 5 then
            -- Camera micro-rotation (new anti-AFK method)
            pcall(function()
                local cam = workspace.CurrentCamera
                local cf = cam.CFrame
                cam.CFrame = cf * CFrame.Angles(0, math.rad(math.random(-2, 2)), 0)
                task.wait(0.1)
                cam.CFrame = cf
            end)
            afkSt.Text = "📷 Camera nudge"
        end

        afkCnt = afkCnt + 1
        afkLabels[2].Text = string.format("Active | Actions: %d", afkCnt)
        afkSt.TextColor3 = Color3.fromRGB(100, 200, 255)
        task.wait(0.3 + math.random() * 0.3)
    end
end

afkBtn.MouseButton1Click:Connect(function()
    aOn = not aOn
    if aOn then
        afkBtn.Text = "✅ Anti AFK ON"
        afkBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
        afkStr.Color = Color3.fromRGB(30, 100, 30)
        afkSt.Text = "Active..."
        afkSt.TextColor3 = Color3.fromRGB(100, 255, 100)
        task.spawn(afkLoop)
    else
        afkBtn.Text = "💤 Anti AFK OFF"
        afkBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        afkStr.Color = Color3.fromRGB(100, 30, 30)
        afkSt.Text = "Idle"
        afkSt.TextColor3 = Color3.fromRGB(120, 120, 120)
        afkLabels[2].Text = "Next: -- | Actions: 0"
    end
end)

