-- ██  LAZY LOAD: POSITION LOCK (FIXED)  ██
-- Uses task.spawn with proper error handling
-- ══════════════════════════════════════════════════════════════

local function lazyLoadPosLock()
    local function canReset()
        return (tick() - state.lastReset) >= CFG.RESET_COOLDOWN
    end

    local function resetChar()
        if not canReset() then return false end
        state.lastReset = tick()
        local char = LocalPlayer.Character
        if char then char:BreakJoints() end
        return true
    end

    local function getRandomOffset()
        return Vector3.new(
            math.random() * CFG.VARIANCE * 2 - CFG.VARIANCE,
            0,
            math.random() * CFG.VARIANCE * 2 - CFG.VARIANCE
        )
    end

    local function getDistFromTarget(root)
        local dx = root.Position.X - TARGET_X
        local dz = root.Position.Z - TARGET_Z
        return math.sqrt(dx * dx + dz * dz)
    end

    local function walkNatural(targetPos, statusCb)
        local char, root, humanoid = getCharParts()
        if not root or not humanoid then return "lost" end

        local adjusted = Vector3.new(targetPos.X, root.Position.Y, targetPos.Z)
        local totalDist = (root.Position - adjusted).Magnitude

        -- Short: direct
        if totalDist < 5 then
            humanoid:MoveTo(adjusted)
            local elapsed = 0
            local lastD = math.huge
            local stall = 0
            while elapsed < CFG.STUCK_TIMEOUT do
                local _, r, h = getCharParts()
                if not r or not h then return "lost" end
                local d = (r.Position - adjusted).Magnitude
                if statusCb then statusCb(d) end
                if d < 3 then return "reached" end
                if math.abs(d - lastD) < 0.3 then stall = stall + 0.1 else stall = 0 end
                lastD = d
                if stall >= CFG.STALL_TIMEOUT then return "stuck" end
                h:MoveTo(adjusted)
                task.wait(0.1 + math.random() * 0.05)
                elapsed = elapsed + 0.1
            end
            return "stuck"
        end

        -- Longer: waypoints
        local numWP = math.random(2, 3)
        local waypoints = {}
        for i = 1, numWP - 1 do
            local t = i / numWP
            local mid = root.Position:Lerp(adjusted, t)
            mid = mid + Vector3.new(math.random() * 6 - 3, 0, math.random() * 6 - 3)
            table.insert(waypoints, mid)
        end
        table.insert(waypoints, adjusted)

        for idx, point in ipairs(waypoints) do
            local _, r, h = getCharParts()
            if not r or not h then return "lost" end
            h:MoveTo(point)
            local elapsed = 0
            local lastD = math.huge
            local stall = 0
            while elapsed < 4 do
                local _, r2, h2 = getCharParts()
                if not r2 or not h2 then return "lost" end
                local d = (r2.Position - point).Magnitude
                if statusCb then statusCb(d) end
                if d < 3 then break end
                if math.abs(d - lastD) < 0.3 then stall = stall + 0.1 else stall = 0 end
                lastD = d
                if stall >= CFG.STALL_TIMEOUT then return "stuck" end
                h2:MoveTo(point)
                task.wait(0.1 + math.random() * 0.05)
                elapsed = elapsed + 0.1
            end
            if idx < #waypoints then task.wait(0.3 + math.random() * 0.5) end
        end

        local _, r3, _ = getCharParts()
        if r3 and (r3.Position - adjusted).Magnitude < 5 then return "reached" end
        return "stuck"
    end

    -- Main loop using task.spawn (robust)
    task.spawn(function()
        local ok, err = pcall(function()
            while state.posActive do
                local char, root, humanoid = getCharParts()

                if not root or not humanoid then
                    StatusLabel.Text = "Waiting for character..."
                    StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
                    task.wait(1 + math.random() * 0.5)
                else
                    local dist = getDistFromTarget(root)

                    -- TOO FAR
                    if dist > CFG.RESET_RADIUS then
                        if canReset() then
                            StatusLabel.Text = string.format("⚠ Too far (%.1f) — Reset!", dist)
                            StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
                            task.wait(0.3 + math.random() * 0.3)
                            resetChar()
                            task.wait(3 + math.random() * 2)
                        else
                            StatusLabel.Text = string.format("⚠ Too far (%.1f) — CD...", dist)
                            StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
                            task.wait(1)
                        end
                    else
                        -- AT POSITION
                        safeWalkSpeed(humanoid, CFG.WALKSPEED + math.random() * 2 - 1)
                        StatusLabel.Text = string.format("✅ %s | Dist: %.1f", SLOTS[currentSlot].name, dist)
                        StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)

                        task.wait(2 + math.random() * 3)

                        if not state.posActive then break end

                        local _, r2, h2 = getCharParts()
                        if r2 and h2 then
                            local d2 = getDistFromTarget(r2)

                            if d2 > CFG.RESET_RADIUS * 0.6 then
                                -- DRIFTING
                                StatusLabel.Text = string.format("⚠ Drifting (%.1f) — Fixing...", d2)
                                StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)

                                local offset = getRandomOffset()
                                local targetPos = Vector3.new(TARGET_X + offset.X, r2.Position.Y, TARGET_Z + offset.Z)

                                local result = walkNatural(targetPos, function(d)
                                    if state.posActive then
                                        StatusLabel.Text = string.format("🔄 Walking... | %.1f", d)
                                        StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
                                    end
                                end)

                                if result == "stuck" then
                                    if canReset() then
                                        StatusLabel.Text = "⚠ Stuck — Reset!"
                                        StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
                                        task.wait(0.5 + math.random() * 0.5)
                                        resetChar()
                                        task.wait(3 + math.random() * 2)
                                    else
                                        StatusLabel.Text = "⚠ Stuck — CD..."
                                        StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
                                        task.wait(1)
                                    end
                                elseif result == "reached" then
                                    local _, _, h3 = getCharParts()
                                    if h3 then safeWalkSpeed(h3, CFG.WALKSPEED + math.random() * 2 - 1) end
                                end
                            else
                                -- Small idle jitter
                                if math.random() < 0.15 then
                                    local small = Vector3.new(math.random() * 2 - 1, 0, math.random() * 2 - 1)
                                    humanoid:MoveTo(root.Position + small)
                                    task.wait(0.5 + math.random() * 0.5)
                                    humanoid:MoveTo(Vector3.new(TARGET_X, root.Position.Y, TARGET_Z))
                                end
                            end
                        end
                    end
                end

                task.wait(0.5) -- Small wait between cycles
            end
        end)

        if not ok then
            warn("[Eclipse] PosLock error: " .. tostring(err))
            StatusLabel.Text = "⚠ Error — Check console"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
        end
    end)
end

local function unloadPosLock()
    state.posActive = false
    StatusLabel.Text = "Status: Inactive"
    StatusLabel.TextColor3 = Color3.fromRGB(120, 120, 120)
    pcall(function()
        local _, _, h = getCharParts()
        if h then safeWalkSpeed(h, 16) end
    end)
end

