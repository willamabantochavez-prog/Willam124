        local m = getrawmetatable(game)
        local oc = m.__namecall
        setreadonly(m, false)
        m.__namecall = newcclosure(function(s, ...)
            local mth = getnamecallmethod()
            if mth == "Kick" or mth == "Shutdown" or mth == "Destroy" then
                return nil
            end
            return oc(s, ...)
        end)
        setreadonly(m, true)
    end)

    -- WalkSpeed spoofing (returns fake value to server checks)
    pcall(function()
        local m = getrawmetatable(game)
        local oi = m.__index
        setreadonly(m, false)
        m.__index = newcclosure(function(s, k)
            if k == "WalkSpeed" then
                local ok, isH = pcall(function() return s:IsA("Humanoid") end)
                if ok and isH then
                    local ch = s.Parent
                    if ch and ch == LP.Character then
                        return SW
                    end
                end
            end
            return oi(s, k)
        end)
        setreadonly(m, true)
    end)

    -- Anti-teleport detection: intercept RemoteEvents that report position
    pcall(function()
        if not detoured then
            detoured = true
            local nc2 = getrawmetatable(game).__namecall
            local oldF
            oldF = hookfunction(nc2, newcclosure(function(s, ...)
                local args = {...}
                local mth = getnamecallmethod()
                -- Block suspicious remote calls that report exact position
                if mth == "FireServer" or mth == "InvokeServer" then
                    for i, v in pairs(args) do
                        if typeof(v) == "Vector3" then
                            -- Don't modify, just let through with small delay
                        end
                    end
                end
                return oldF(s, ...)
            end))
        end
    end)
end

-- ════════════════════════════════
--   UTILITY (obfuscated names)
-- ════════════════════════════════

local function gCP()
    local c = LP.Character
    if not c then return nil, nil, nil end
    return c, c:FindFirstChild("HumanoidRootPart"), c:FindFirstChildOfClass("Humanoid")
end

local function dist(r)
    if not r then return 9999 end
    local p = r.Position
    return math.sqrt((p.X - TX)^2 + (p.Z - TZ)^2)
end

local function rndOff()
    return Vector3.new(math.random() * VARR * 2 - VARR, 0, math.random() * VARR * 2 - VARR)
end

local function sWS(h, s)
    pcall(function() h.WalkSpeed = s end)
end

local function rst()
    pcall(function()
        _, _, h = gCP()
        if h then h.Health = 0 end
    end)
end

-- Safe humanoid walk (uses MoveTo, not CFrame - harder to detect)
local function safeWalk(targetPos, callback)
    local c, r, h = gCP()
    if not r or not h then return false end

    sWS(h, RW)

    -- Use Humanoid:MoveTo which is the legitimate API
    h:MoveTo(targetPos)

    local s = tick()
    while pOn do
        local d = dist(r)
        if callback then callback(d) end
        if d < 5 then return true end
        if tick() - s >= TIMEOUT then return false end
        task.wait(0.08 + math.random() * 0.04) -- Random delay to avoid pattern
    end
    return false
end

