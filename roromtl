-- ██  SIMPLE HELPERS  ██
-- ══════════════════════════════════════════════════════════════

local function getChar()
    local c = LocalPlayer.Character
    if not c then return nil, nil end
    return c:FindFirstChild("HumanoidRootPart"), c:FindFirstChildOfClass("Humanoid")
end

local function distToTarget(root)
    local dx = root.Position.X - TARGET_X
    local dz = root.Position.Z - TARGET_Z
    return math.sqrt(dx * dx + dz * dz)
end

-- ══════════════════════════════════════════════════════════════
-- ██  LAZY LOAD: POSITION LOCK (VERY SIMPLE)  ██
--  Loop:
--    1. Wait for character
--    2. MoveTo(target)
--    3. Wait 6 seconds
--    4. Check distance
--    5. If not arrived → die
--    6. Respawn → go to 1
-- ══════════════════════════════════════════════════════════════

local function lazyLoadPosLock()
    task.spawn(function()
        while state.posActive do
            -- Step 1: Wait for character
            local root, hum = getChar()
            if not root or not hum then
                StatusLabel.Text = "⏳ Waiting to respawn..."
                StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
                -- Wait for character to spawn
                local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
                task.wait(1) -- small delay after spawn
                root = char:FindFirstChild("HumanoidRootPart")
                hum = char:FindFirstChildOfClass("Humanoid")
                if not root or not hum then
                    task.wait(1)
                    continue
                end
            end

            if not state.posActive then break end

            -- Step 2: Walk to target
            local targetPos = Vector3.new(TARGET_X, root.Position.Y, TARGET_Z)
            hum.WalkSpeed = CFG.WALKSPEED
            hum:MoveTo(targetPos)

            StatusLabel.Text = string.format("🚶 Walking to %s...", SLOTS[currentSlot].name)
            StatusLabel.TextColor3 = Color3.fromRGB(100, 200, 255)

            -- Keep sending MoveTo while waiting
            local arrived = false
            local elapsed = 0
            local moveConn

            -- Send MoveTo every 0.5s to keep pathfinding active
            moveConn = task.spawn(function()
                while state.posActive and elapsed < CFG.WALK_TIMEOUT do
                    local r, h = getChar()
                    if r and h then
                        -- Update target Y to current height
                        local tp = Vector3.new(TARGET_X, r.Position.Y, TARGET_Z)
                        h:MoveTo(tp)

                        -- Check if arrived early
                        local d = distToTarget(r)
                        if d < CFG.ARRIVE_DIST then
                            arrived = true
                            break
                        end
                    end
                    task.wait(0.5)
                    elapsed = elapsed + 0.5
                end
            end)

            -- Step 3: Wait 6 seconds
            local waitStart = tick()
            while tick() - waitStart < CFG.WALK_TIMEOUT do
                if not state.posActive then break end
                if arrived then break end
                task.wait(0.1)
            end

            if not state.posActive then break end

            -- Step 4: Check if arrived
            local r2, h2 = getChar()
            if r2 and not arrived then
                local d = distToTarget(r2)
                if d < CFG.ARRIVE_DIST then
                    arrived = true
                end
            end

            if arrived then
                -- SUCCESS: At destination
                StatusLabel.Text = string.format("✅ At %s | Waiting...", SLOTS[currentSlot].name)
                StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)

                -- Keep walking to stay there
                local r3, h3 = getChar()
                if h3 then
                    h3.WalkSpeed = 16
                    h3:MoveTo(Vector3.new(TARGET_X, r3.Position.Y, TARGET_Z))
                end

                -- Wait a bit then check again
                task.wait(3 + math.random() * 2)

                -- Check if still there
                local r4, _ = getChar()
                if r4 and distToTarget(r4) > CFG.ARRIVE_DIST * 3 then
                    StatusLabel.Text = "⚠ Drifted away — Walking back..."
                    StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
                    -- Loop will walk again
                end
            else
                -- FAILED: Didn't arrive in 6 seconds
                StatusLabel.Text = "⚠ Stuck — Resetting!"
                StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)

                -- Step 5: Die
                task.wait(0.3)
                local char = LocalPlayer.Character
                if char then
                    char:BreakJoints()
                end

                StatusLabel.Text = "💀 Died — Respawning..."
                StatusLabel.TextColor3 = Color3.fromRGB(255, 50, 50)

                -- Step 6: Wait for respawn, then loop continues
                task.wait(3)
            end

            task.wait(0.5)
        end

        -- Stopped
        StatusLabel.Text = "Status: Inactive"
        StatusLabel.TextColor3 = Color3.fromRGB(120, 120, 120)
    end)
end

local function unloadPosLock()
    state.posActive = false
    StatusLabel.Text = "Status: Inactive"
    StatusLabel.TextColor3 = Color3.fromRGB(120, 120, 120)
end

