local function applyScale(newScale)
    currentScale = math.clamp(newScale, 0.65, 1.5)
    MainScale.Scale = currentScale
    SizeDisplay.Text = math.floor(currentScale * 100 + 0.5) .. "%"
end

local function showPanel(panel)
    if panel == "main" then
        MainPanel.Visible = true
        SettingsPanel.Visible = false
        state.currentPanel = "main"
        SettingsBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    else
        MainPanel.Visible = false
        SettingsPanel.Visible = true
        state.currentPanel = "settings"
        SettingsBtn.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
    end
end

local function setMinimized(min)
    state.isMinimized = min
    if min then
        ContentFrame.Visible = false
        MainFrame.Size = UDim2.new(0, BASE_WIDTH, 0, 38)
        CloseBtn.Text = "+"
    else
        ContentFrame.Visible = true
        MainFrame.Size = UDim2.new(0, BASE_WIDTH, 0, BASE_HEIGHT)
        CloseBtn.Text = "−"
    end
end

MinusBtn.MouseButton1Click:Connect(function() applyScale(currentScale - 0.1) end)
PlusBtn.MouseButton1Click:Connect(function() applyScale(currentScale + 0.1) end)
CloseBtn.MouseButton1Click:Connect(function() setMinimized(not state.isMinimized) end)
SettingsBtn.MouseButton1Click:Connect(function()
    if state.currentPanel == "main" then showPanel("settings") else showPanel("main") end
end)

