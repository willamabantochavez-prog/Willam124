-- JUMPS
JumpsToggle.MouseButton1Click:Connect(function()
    if not state.jumpsActive then
        local targetName = UserBox.Text:gsub("%s+", "")
        local jumpsText = JumpsBox.Text:gsub("%s+", "")

        if targetName == "" then UserBox.PlaceholderText = "⚠ Enter username!" return end

        local jv
        if jumpsText:lower() == "inf" or jumpsText:lower() == "infinite" then
            jv = math.huge
        else
            jv = tonumber(jumpsText)
        end
        if not jv or jv < 1 then JumpsBox.PlaceholderText = "⚠ Enter 1-∞ or 'inf'!" return end

        local found = Players:FindFirstChild(targetName)
        if not found then
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Name:lower():sub(1, #targetName) == targetName:lower() then
                    targetName = p.Name UserBox.Text = p.Name found = p break
                end
            end
        end
        if not found then UserBox.PlaceholderText = "⚠ Not found!" UserBox.Text = "" return end
        if found ~= LocalPlayer then JumpsBox.PlaceholderText = "⚠ Only yourself!" return end

        state.jumpsActive = true
        state.jumpsValue = jv
        JumpsToggle.Text = "✅  ExtraJumps ON"
        JumpsToggle.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
        jtStroke.Color = Color3.fromRGB(30, 100, 30)
        lazyLoadJumps()
    else
        state.jumpsActive = false
        JumpsToggle.Text = "⛔  ExtraJumps OFF"
        JumpsToggle.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        jtStroke.Color = Color3.fromRGB(100, 30, 30)
        unloadJumps()
    end
end)

