    {name = "Slot 7", x = -490.25, z = 10.84},
    {name = "Slot 8", x = -503.77, z = 81.59},
}

local selectedSlot = 1
local TARGET_X = SLOTS[1].x
local TARGET_Z = SLOTS[1].z

local TRIGGER_DIST = 8
local MOVE_TIMEOUT = 6
local WALKSPEED = 22
local farmActive = false
local farmJumps = 0
local farmState = "Idle"

-- ════════════════════════════════
--   CHARACTER HELPERS
-- ════════════════════════════════

local function getCharParts()
    local char = LocalPlayer.Character
    if not char then return nil, nil, nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    return char, root, humanoid
end

local function getDistFromTarget(root)
    local dx = root.Position.X - TARGET_X
    local dz = root.Position.Z - TARGET_Z
    return math.sqrt(dx * dx + dz * dz)
end

local function doJump()
    pcall(function()
        local _, _, humanoid = getCharParts()
        if humanoid then humanoid.Jump = true end
    end)
end

-- ══════════════════════════════════════
--   AUTO FARM LOGIC
--   MoveTo → 6s → if stuck: jump → retry
-- ══════════════════════════════════════

local farmThread = nil

local function autoFarmLoop()
    while farmActive do
        local char, root, humanoid = getCharParts()

        if not root or not humanoid then
            farmState = "Waiting for character..."
            task.wait(1)
            continue
        end

        -- Set walkspeed
        pcall(function() humanoid.WalkSpeed = WALKSPEED end)

        local dist = getDistFromTarget(root)

        if dist < TRIGGER_DIST then
            -- At target, wait a bit then repeat
            farmState = string.format("✅ At Slot %d | Dist: %.1f", selectedSlot, dist)
            task.wait(2)
        else
            -- Walk to target
            farmState = string.format("⚠ Walking to Slot %d...", selectedSlot)

            local targetPos = Vector3.new(TARGET_X, root.Position.Y, TARGET_Z)
            humanoid:MoveTo(targetPos)

            -- Wait up to MOVE_TIMEOUT seconds
            local elapsed = 0
            local arrived = false

            while elapsed < MOVE_TIMEOUT do
                if not farmActive then return end

                local _, r, h = getCharParts()
                if not r or not h then break end

                local d = getDistFromTarget(r)
                farmState = string.format("Walking %.1fs | Dist: %.1f", MOVE_TIMEOUT - elapsed, d)

                if d < TRIGGER_DIST then
                    arrived = true
                    break
                end

                -- Keep sending MoveTo (in case humanoid gets stuck)
                if elapsed % 1 < 0.2 then
                    pcall(function()
                        targetPos = Vector3.new(TARGET_X, r.Position.Y, TARGET_Z)
                        h:MoveTo(targetPos)
                    end)
                end

                task.wait(0.2)
                elapsed = elapsed + 0.2
            end

            if arrived then
                farmState = string.format("✅ Reached Slot %d!", selectedSlot)
                task.wait(1)
            else
                -- TIMEOUT → Jump (unstick the character)
                farmJumps = farmJumps + 1
                farmState = string.format("🦘 Stuck! Jump #%d", farmJumps)

                -- Jump twice to unstick
                doJump()
                task.wait(0.4)
                doJump()
                task.wait(0.6)

                farmState = "Retrying walk to Slot " .. selectedSlot .. "..."
            end
        end
    end
end

