-- ════════════════════════════════
--   POSITION LOCK (BodyPosition)
-- ════════════════════════════════

local function positionLockLoop()
    while posActive do
        local char, root, humanoid = getCharParts()

        if not root or not humanoid then
            StatusLabel.Text = "Waiting for character..."
            StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
            removeBodyPosition()
            task.wait(1)
            continue
        end

        local dist = getDistFromTarget(root)

        if dist < TRIGGER_DIST then
            StatusLabel.Text = string.format("✅ At Slot %d | Dist: %.1f", selectedSlot, dist)
            StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
            removeBodyPosition()
            task.wait(0.5)
        else
            StatusLabel.Text = string.format("⚠ Returning to Slot %d...", selectedSlot)
            StatusLabel.TextColor3 = Color3.fromRGB(255, 140, 0)

            task.wait(math.random() * 0.3 + 0.1)
            if not posActive then break end

            local arrived = walkToWithBodyPosition(TARGET_X, TARGET_Z, MOVE_TIMEOUT, function(d, remaining)
                if posActive then
                    StatusLabel.Text = string.format("BodyPos %.1fs | Dist: %.1f", remaining, d)
                end
            end)

            if arrived then
                StatusLabel.Text = string.format("✅ At Slot %d!", selectedSlot)
                StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
            else
                StatusLabel.Text = "🦘 Timeout! Jumping x2..."
                StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)
                removeBodyPosition()
                doJump()
                task.wait(0.6)
                doJump()
                task.wait(0.4)
            end

            task.wait(0.5)
        end
    end
end

