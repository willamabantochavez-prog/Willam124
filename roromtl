--        CONFIGURATION
-- ════════════════════════════════

local SLOTS = {
    {name = "Slot 1", x = -461.32, z = 140.12},
    {name = "Slot 2", x = -389.20, z = 151.84},
    {name = "Slot 3", x = -330.62, z = 109.53},
    {name = "Slot 4", x = -317.93, z = 39.50},
