local function makeRow(parent, labelText)
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, 0, 0, ROW_H)
    card.BackgroundColor3 = Color3.fromRGB(22, 20, 28)
    card.BorderSizePixel = 0
    card.LayoutOrder = nextOrder()
    card.ZIndex = 4
    card.ClipsDescendants = true
    card.Parent = parent
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 7)

    -- Label: 6px from left
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, LABEL_W, 1, 0)
    label.Position = UDim2.new(0, MARGIN_LEFT, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Color3.fromRGB(255, 140, 0)
    label.TextSize = 11
    label.Font = Enum.Font.GothamBold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 5
    label.Parent = card

    -- Control container: 2px from right (flush!)
    local ctrlFrame = Instance.new("Frame")
    ctrlFrame.Size = UDim2.new(0, CTRL_W, 1, 0)
    ctrlFrame.Position = UDim2.new(1, -(CTRL_W + MARGIN_RIGHT), 0, 0)
    ctrlFrame.BackgroundTransparency = 1
    ctrlFrame.ZIndex = 5
    ctrlFrame.ClipsDescendants = true
    ctrlFrame.Parent = card

    return card, label, ctrlFrame
end

