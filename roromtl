-- ════════════════════════════════
--   EXTRA JUMPS (GRADUAL - UNDETECTED)
--   1 → 2 → 3 → ... → target
--   Random delay between each increment
-- ════════════════════════════════

local function getJumpsValue(text)
    if text:lower() == "inf" or text:lower() == "infinite" or text:lower() == "infinity" then
        return math.huge
    end
    local num = tonumber(text)
    if num and num >= 1 then return num end
    return nil
end

local function setJumpAttribute(playerName, value)
    pcall(function()
        local player = Players:FindFirstChild(playerName)
        if not player then return end

        local character = player.Character
        if character then
            character:SetAttribute("ExtraJumps", value)
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid:SetAttribute("ExtraJumps", value)
            end
        end
        player:SetAttribute("ExtraJumps", value)
    end)
end

local function gradualJumpLoop()
    local targetVal = jumpTargetValue
    local playerName = jumpTargetPlayer

    if not playerName then return end

    -- Get current value
    local currentVal = 0
    pcall(function()
        local player = Players:FindFirstChild(playerName)
        if player then
            local char = player.Character
            if char then
                currentVal = char:GetAttribute("ExtraJumps") or 0
            end
        end
    end)

    jumpCurrentValue = currentVal

    -- If already at target, just maintain
    if currentVal >= targetVal and targetVal ~= math.huge then
        -- Already done, just keep it set
        while jumpsActive do
            setJumpAttribute(playerName, targetVal)
            JumpStatusLabel.Text = string.format("Status: ✓ Maintained | Current: %s | Target: %s",
                tostring(currentVal), tostring(targetVal))
            task.wait(math.random(10, 20)) -- Check every 10-20 seconds
        end
        return
    end

    -- Gradually increase: +1 every few seconds
    while jumpsActive do
        if currentVal < targetVal then
            currentVal = currentVal + 1
            jumpCurrentValue = currentVal

            setJumpAttribute(playerName, currentVal)

            JumpStatusLabel.Text = string.format("Status: ↑ Setting... | Current: %s | Target: %s",
                tostring(currentVal), tostring(targetVal))
            JumpStatusLabel.TextColor3 = Color3.fromRGB(255, 200, 50)

            -- Random delay between increments (looks natural)
            local delay = jumpIncrementDelay + math.random() * 2 - 0.5
            if delay < 0.5 then delay = 0.5 end
            task.wait(delay)
        else
            -- Reached target! Now just maintain
            JumpStatusLabel.Text = string.format("Status: ✓ Reached! | Current: %s | Target: %s",
                tostring(currentVal), tostring(targetVal))
            JumpStatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)

            -- Maintain: re-set every 10-20 seconds (not every frame!)
            while jumpsActive do
                setJumpAttribute(playerName, targetVal)
                task.wait(math.random(10, 20))
            end
            return
        end
    end
end

