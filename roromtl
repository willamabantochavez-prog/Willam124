-- [-] [val] [+]  RIGHT-ALIGNED inside ctrlFrame
local function makeBtnGroup(ctrlFrame)
    local btnH = BTN_SZ
    local totalW = BTN_SZ + GAP + VAL_W + GAP + BTN_SZ
    -- Right-align: startX so group ends near right edge of ctrlFrame
    local startX = CTRL_W - totalW

    local minusBtn = Instance.new("TextButton")
    minusBtn.Size = UDim2.new(0, BTN_SZ, 0, btnH)
    minusBtn.Position = UDim2.new(0, startX, 0.5, -btnH / 2)
    minusBtn.BackgroundColor3 = Color3.fromRGB(55, 50, 65)
    minusBtn.Text = "-"
    minusBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    minusBtn.TextSize = 14
    minusBtn.Font = Enum.Font.GothamBold
    minusBtn.BorderSizePixel = 0
    minusBtn.ZIndex = 6
    minusBtn.AutoButtonColor = false
    minusBtn.Parent = ctrlFrame
    Instance.new("UICorner", minusBtn).CornerRadius = UDim.new(0, 5)
    minusBtn.MouseEnter:Connect(function() minusBtn.BackgroundTransparency = 0.15 end)
    minusBtn.MouseLeave:Connect(function() minusBtn.BackgroundTransparency = 0 end)

    local valFrame, valLabel = makeValBox(ctrlFrame, VAL_W, btnH, "1")
    valFrame.Position = UDim2.new(0, startX + BTN_SZ + GAP, 0.5, -btnH / 2)

    local plusBtn = Instance.new("TextButton")
    plusBtn.Size = UDim2.new(0, BTN_SZ, 0, btnH)
    plusBtn.Position = UDim2.new(0, startX + BTN_SZ + GAP + VAL_W + GAP, 0.5, -btnH / 2)
    plusBtn.BackgroundColor3 = Color3.fromRGB(55, 50, 65)
