local function getJumpsValue(text)
    if text:lower() == "inf" or text:lower() == "infinite" or text:lower() == "infinity" then
        return math.huge
    end
    local num = tonumber(text)
    if num and num >= 1 then return num end
    return nil
end

local function setupExtraJumps(count)
    for _, conn in ipairs(jumpConnections) do pcall(function() conn:Disconnect() end) end
    jumpConnections = {}
    jumpsUsed = 0

    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root then return end

    -- Reset on landing
    local stateConn = humanoid.StateChanged:Connect(function(_, new)
        if new == Enum.HumanoidStateType.Landed then jumpsUsed = 0 end
    end)
    table.insert(jumpConnections, stateConn)

    -- Extra jumps via BodyVelocity
    local jumpConn = UIS.JumpRequest:Connect(function()
        if not jumpsActive then return end
        local state = humanoid:GetState()
        if state == Enum.HumanoidStateType.Freefall and jumpsUsed < count then
            jumpsUsed = jumpsUsed + 1
            local bv = Instance.new("BodyVelocity")
            bv.Name = "BV_" .. math.random(10000, 99999)
            bv.Velocity = Vector3.new(0, humanoid.JumpPower * 1.1, 0)
            bv.MaxForce = Vector3.new(0, math.huge, 0)
            bv.Parent = root
            Debris:AddItem(bv, 0.15)
        end
    end)
    table.insert(jumpConnections, jumpConn)
end

local function cleanupExtraJumps()
    for _, conn in ipairs(jumpConnections) do pcall(function() conn:Disconnect() end) end
    jumpConnections = {}
    jumpsUsed = 0
    local char = LocalPlayer.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            for _, child in ipairs(root:GetChildren()) do
                if child:IsA("BodyVelocity") and child.Name:match("^BV_") then child:Destroy() end
            end
        end
    end
end

