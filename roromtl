local function getCharParts()
    local char = LP.Character
    if not char then return nil, nil, nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    return char, root, humanoid
end

local function getDistanceFromTarget(root)
    if not root then return 9999 end
    local pos = root.Position
    local dx = pos.X - TARGET_X
    local dz = pos.Z - TARGET_Z
    return math.sqrt(dx * dx + dz * dz)
end

local function getRandomOffset()
    return Vector3.new(
        math.random() * POSITION_VARIANCE * 2 - POSITION_VARIANCE,
        0,
        math.random() * POSITION_VARIANCE * 2 - POSITION_VARIANCE
    )
end

local function setWalkSpeed(humanoid, speed)
    pcall(function() humanoid.WalkSpeed = speed end)
end

local function resetPlayer()
    pcall(function()
        local _, _, humanoid = getCharParts()
        if humanoid then
            humanoid.Health = 0
        end
    end)
end

local function updateSlotDisplay()
    if slotInfoLabel then
        slotInfoLabel.Text = string.format("📍 Slot %d | X: %.2f  Z: %.2f", currentSlot, TARGET_X, TARGET_Z)
    end
end

local function updateSlot(i)
    if i >= 1 and i <= 8 then
        currentSlot = i
        TARGET_X = SLOTS[i].x
        TARGET_Z = SLOTS[i].z
        updateSlotDisplay()
    end
end

