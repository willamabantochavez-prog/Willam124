-- ════════════════════════════════
--   AC BYPASS HOOKS
-- ════════════════════════════════

local function installHooks()
    if hooksInstalled then return end
    hooksInstalled = true

    pcall(function()
        local mt = getrawmetatable(game)
        local oldNamecall = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "Kick" or method == "Shutdown" then
                return nil
            end
            return oldNamecall(self, ...)
        end)
        setreadonly(mt, true)
    end)

    pcall(function()
        if hookfunction then
            local kickFunc = LocalPlayer.Kick
            if kickFunc then
                hookfunction(kickFunc, newcclosure(function(...)
                    return nil
                end))
            end
        end
    end)

    pcall(function()
        local mt = getrawmetatable(game)
        local oldIndex = mt.__index
        setreadonly(mt, false)
        mt.__index = newcclosure(function(self, key)
            if key == "WalkSpeed" then
                local ok, isH = pcall(function() return self:IsA("Humanoid") end)
                if ok and isH then
                    local char = self.Parent
                    if char and char == LocalPlayer.Character then
                        return SPOOFED_WALKSPEED
                    end
                end
            end
            return oldIndex(self, key)
        end)
        setreadonly(mt, true)
    end)

    pcall(function()
        local mt = getrawmetatable(game)
        local oldNewindex = mt.__newindex
        setreadonly(mt, false)
        mt.__newindex = newcclosure(function(self, key, value)
            if key == "WalkSpeed" then
                local ok, isH = pcall(function() return self:IsA("Humanoid") end)
                if ok and isH then
                    local char = self.Parent
                    if char and char == LocalPlayer.Character then
                        if value < REAL_WALKSPEED then return end
                    end
                end
            end
            return oldNewindex(self, key, value)
        end)
        setreadonly(mt, true)
    end)
end

installHooks()

-- ════════════════════════════════
--   CHARACTER / MOVEMENT HELPERS
-- ════════════════════════════════

local function getCharParts()
    local char = LocalPlayer.Character
    if not char then return nil, nil, nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    return char, root, humanoid
end

local function getRandomOffset()
    return Vector3.new(
        math.random() * POSITION_VARIANCE * 2 - POSITION_VARIANCE,
        0,
        math.random() * POSITION_VARIANCE * 2 - POSITION_VARIANCE
    )
end

local function getDistanceFromTarget(root)
    local dx = root.Position.X - TARGET_X
    local dz = root.Position.Z - TARGET_Z
    return math.sqrt(dx * dx + dz * dz)
end

local function setWalkSpeed(humanoid, speed)
    pcall(function() humanoid.WalkSpeed = speed end)
end

local function walkToPosition(targetPos, statusCallback, timeoutSec)
    local char, root, humanoid = getCharParts()
    if not root or not humanoid then return false end

    setWalkSpeed(humanoid, REAL_WALKSPEED)

    local adjustedTarget = Vector3.new(targetPos.X, root.Position.Y, targetPos.Z)
    humanoid:MoveTo(adjustedTarget)

    local maxWait = timeoutSec or MOVE_TIMEOUT
    local elapsed = 0

    while elapsed < maxWait do
        local _, r, h = getCharParts()
        if not r or not h then return false end

        local dist = (r.Position - adjustedTarget).Magnitude
        if statusCallback then statusCallback(dist) end
        if dist < 3 then return true end

        h:MoveTo(adjustedTarget)
        task.wait(MOVE_CHECK_INTERVAL)
        elapsed = elapsed + MOVE_CHECK_INTERVAL
    end
    return false
end

local function resetCharacter()
    pcall(function()
        local char = LocalPlayer.Character
        if char then char:BreakJoints() end
    end)
end

-- ════════════════════════════════
--   UNDETECTED EXTRA JUMPS
--   (BodyVelocity method, no SetAttribute)
-- ════════════════════════════════

local jumpConn = nil
local jumpCount = 0
local maxJumps = 3
local jumpForce = 55

local function setupUndetectedJumps()
    -- Clean previous
    if jumpConn then jumpConn:Disconnect() jumpConn = nil end

    jumpConn = RunService.Heartbeat:Connect(function()
        if not jumpsActive then return end

        local char, root, humanoid = getCharParts()
        if not char or not root or not humanoid then return end

        -- Detect if on ground using raycast
        local rayParams = RaycastParams.new()
        rayParams.FilterDescendantsInstances = {char}
        rayParams.FilterType = Enum.RaycastFilterType.Exclude

        local rayResult = workspace:Raycast(
            root.Position,
            Vector3.new(0, -3.5, 0),
            rayParams
        )

        local onGround = rayResult ~= nil

        if onGround then
            jumpCount = 0
        end

        -- Check if player pressed jump while in air
        if humanoid:GetState() == Enum.HumanoidStateType.Freefall
        or humanoid:GetState() == Enum.HumanoidStateType.Jumping then
            -- Player is in air, listen for jump input
        end
    end)

    table.insert(allConnections, jumpConn)

    -- Use UserInputService for jump detection (only for local player, undetected)
    local inputConn = UIS.JumpRequest:Connect(function()
        if not jumpsActive then return end

        local char, root, humanoid = getCharParts()
        if not char or not root or not humanoid then return end

        -- Check if in air
        local rayParams = RaycastParams.new()
        rayParams.FilterDescendantsInstances = {char}
        rayParams.FilterType = Enum.RaycastFilterType.Exclude

        local rayResult = workspace:Raycast(
            root.Position,
            Vector3.new(0, -3.5, 0),
            rayParams
        )

        local onGround = rayResult ~= nil

        if not onGround and jumpCount < maxJumps then
            jumpCount = jumpCount + 1
            -- Apply upward velocity via BodyVelocity (undetected)
            local bv = Instance.new("BodyVelocity")
            bv.Velocity = Vector3.new(0, jumpForce, 0)
            bv.MaxForce = Vector3.new(0, math.huge, 0)
            bv.P = 1000
            bv.Parent = root
            task.delay(0.15, function()
                pcall(function() bv:Destroy() end)
            end)
        end
    end)

    table.insert(allConnections, inputConn)
end

