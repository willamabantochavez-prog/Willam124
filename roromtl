local function getJumps(txt)
    if txt:lower() == "inf" or txt:lower() == "infinite" or txt:lower() == "infinity" then
        return math.huge
    end
    local n = tonumber(txt)
    if n and n >= 1 then return n end
    return nil
end

local function applyJumps(name, val)
    local p = Players:FindFirstChild(name)
    if p then
        local ch = p.Character
        if ch then
            ch:SetAttribute("ExtraJumps", val)
            local h = ch:FindFirstChildOfClass("Humanoid")
            if h then h:SetAttribute("ExtraJumps", val) end
        end
        p:SetAttribute("ExtraJumps", val)
        return true
    end
    return false
end

