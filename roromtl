LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    if farmActive then
        local _, _, humanoid = getCharParts()
        if humanoid then
            pcall(function() humanoid.WalkSpeed = WALKSPEED end)
        end
    end
end)

