-- ════════════════════════════════
--     CORE LOGIC: SET ATTRIBUTE
-- ════════════════════════════════

local function getJumpsValue(text)
    if text:lower() == "inf" or text:lower() == "infinite" or text:lower() == "infinity" then
        return math.huge
    end
    local num = tonumber(text)
    if num and num >= 1 then
        return num
    end
    return nil
end

local function applyExtraJumps(targetName, jumpsValue)
    -- Check in Players service
    local targetPlayer = Players:FindFirstChild(targetName)
    
    if targetPlayer then
        local character = targetPlayer.Character
        if character then
            -- Set attribute on character model
            character:SetAttribute("ExtraJumps", jumpsValue)
            
            -- Also set on Humanoid if exists
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid:SetAttribute("ExtraJumps", jumpsValue)
            end
        end
        
        -- Set attribute on Player instance
        targetPlayer:SetAttribute("ExtraJumps", jumpsValue)
        
        -- Set attribute on PlayerScripts if exists
        local playerScripts = targetPlayer:FindFirstChild("PlayerScripts")
        if playerScripts then
            playerScripts:SetAttribute("ExtraJumps", jumpsValue)
        end
        
        return true
    end
    return false
end

-- ════════════════════════════════
--         TOGGLE HANDLER
-- ════════════════════════════════

ToggleBtn.MouseButton1Click:Connect(function()
    active = not active

    if active then
        local targetName = UserBox.Text:gsub("%s+", "")
        local jumpsText = JumpsBox.Text:gsub("%s+", "")

        -- Validate username
        if targetName == "" then
            UserBox.PlaceholderText = "⚠ Enter a username!"
            active = false
            return
        end

        -- Validate jumps
        local jumpsValue = getJumpsValue(jumpsText)
        if not jumpsValue then
            JumpsBox.PlaceholderText = "⚠ Enter 1-∞ or 'inf'!"
            active = false
            return
        end

        -- Check if player exists
        local found = Players:FindFirstChild(targetName)
        if not found then
            -- Try partial match
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Name:lower():sub(1, #targetName) == targetName:lower() then
                    targetName = p.Name
                    UserBox.Text = p.Name
                    found = p
                    break
                end
            end
        end

        if not found then
            UserBox.PlaceholderText = "⚠ Player not found!"
            UserBox.Text = ""
            active = false
            return
        end

        -- Activate
        ToggleBtn.Text = "✅  ON"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
        ToggleStroke.Color = Color3.fromRGB(30, 100, 30)

        -- Apply immediately
        applyExtraJumps(targetName, jumpsValue)

        -- Continuous loop to keep attribute set
        heartbeatConn = RunService.Heartbeat:Connect(function()
            if not active then return end
            applyExtraJumps(targetName, jumpsValue)
        end)

    else
        -- Deactivate
        ToggleBtn.Text = "⛔  OFF"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        ToggleStroke.Color = Color3.fromRGB(100, 30, 30)

        if heartbeatConn then
            heartbeatConn:Disconnect()
            heartbeatConn = nil
        end
    end
end)

-- ════════════════════════════════
--        DRAGGABLE FRAME
-- ════════════════════════════════

local dragging, dragInput, dragStart, startPos

local function updateInput(input)
    local delta = input.Position - dragStart
    MainFrame.Position = UDim2.new(
        startPos.X.Scale,
        startPos.X.Offset + delta.X,
        startPos.Y.Scale,
        startPos.Y.Offset + delta.Y
    )
end

TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

TitleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UIS.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        updateInput(input)
    end
end)

