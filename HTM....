local function getJumpsValue(text)
    if text:lower() == "inf" or text:lower() == "infinite" or text:lower() == "infinity" then
        return math.huge
    end
    local num = tonumber(text)
    if num and num >= 1 then
        return num
    end
    return nil
end

local function applyExtraJumps(name, jumps)
    local targetPlayer = Players:FindFirstChild(name)
    if not targetPlayer then return false end

    local character = targetPlayer.Character
    if character then
        character:SetAttribute("ExtraJumps", jumps)
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid:SetAttribute("ExtraJumps", jumps)
        end
    end

    targetPlayer:SetAttribute("ExtraJumps", jumps)

    local playerScripts = targetPlayer:FindFirstChild("PlayerScripts")
    if playerScripts then
        playerScripts:SetAttribute("ExtraJumps", jumps)
    end

    return true
end

