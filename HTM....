local particles = {}
local MAX_PARTICLES = 18
local PARTICLE_COLORS = {C.particle1, C.particle2, C.particle3}

local function spawnParticle()
    if #particles >= MAX_PARTICLES then return end

    local size = math.random(2, 5)
    local color = PARTICLE_COLORS[math.random(1, #PARTICLE_COLORS)]
    local startX = math.random(0, BASE_WIDTH)
    local speed = math.random(20, 50) / 10
    local swayAmp = math.random(10, 30)
    local swaySpeed = math.random(10, 25) / 10
    local alpha = math.random(20, 55) / 100

    local p = Instance.new("Frame")
    p.Size = UDim2.new(0, size, 0, size)
    p.Position = UDim2.new(0, startX, 0, -size - 5)
    p.BackgroundColor3 = color
    p.BackgroundTransparency = 1 - alpha
    p.BorderSizePixel = 0
    p.ZIndex = 2
    p.Parent = ParticleContainer
    Instance.new("UICorner", p).CornerRadius = UDim.new(1, 0)

    local glow = Instance.new("Frame")
    glow.Size = UDim2.new(1, size * 2, 1, size * 2)
    glow.Position = UDim2.new(0, -size, 0, -size)
    glow.BackgroundColor3 = color
    glow.BackgroundTransparency = 1 - (alpha * 0.3)
    glow.BorderSizePixel = 0
    glow.ZIndex = 2
    glow.Parent = p
    Instance.new("UICorner", glow).CornerRadius = UDim.new(1, 0)

    table.insert(particles, {
        frame = p,
        x = startX,
        y = -size - 5,
        speed = speed,
        swayAmp = swayAmp,
        swaySpeed = swaySpeed,
        time = math.random() * 6.28,
        alpha = alpha,
        size = size,
    })
end

local function updateParticles(dt)
    for i = #particles, 1, -1 do
        local pt = particles[i]
        pt.y = pt.y + (BASE_HEIGHT / pt.speed) * dt
        pt.time = pt.time + dt * pt.swaySpeed
        local sway = math.sin(pt.time) * pt.swayAmp

        if pt.y > BASE_HEIGHT + 10 then
            pt.frame:Destroy()
            table.remove(particles, i)
        else
            pt.frame.Position = UDim2.new(0, pt.x + sway, 0, pt.y)
            local fadeZone = BASE_HEIGHT - 60
            if pt.y > fadeZone then
                local fade = (pt.y - fadeZone) / 60
                pt.frame.BackgroundTransparency = 1 - (pt.alpha * (1 - fade))
            end
        end
    end
end

task.spawn(function()
    while MainFrame.Parent do
        spawnParticle()
        task.wait(math.random(15, 35) / 100)
    end
end)

RunService.Heartbeat:Connect(function(dt)
    updateParticles(dt)
end)

