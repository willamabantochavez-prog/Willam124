            StatusLabel.Text = string.format("Active | %s = %s jumps", targetName, jumpStr)
            local pulse = (math.sin(tick() * 3) + 1) / 2
            StatusLabel.TextColor3 = Color3.new(
                0.2 + 0.2 * pulse,
                0.8 + 0.2 * pulse,
                0.3 + 0.1 * pulse
            )
        end
        task.wait(0.3)
    end
end)

