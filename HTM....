-- Toggle logic
ToggleBtn.MouseButton1Click:Connect(function()
    active = not active

    if active then
        local name = UserBox.Text:gsub("%s+", "")
        local jumpsText = JumpsBox.Text:gsub("%s+", "")

        -- Validate username
        if name == "" then
            UserBox.PlaceholderText = "Enter a username!"
            active = false
            return
        end

        -- Validate jumps
        local jVal = getJumpsValue(jumpsText)
        if not jVal then
            JumpsBox.PlaceholderText = "Enter 1+ or 'inf'!"
            active = false
            return
        end

        -- Find player (partial match)
        local found = Players:FindFirstChild(name)
        if not found then
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Name:lower():sub(1, #name) == name:lower() then
                    name = p.Name
                    UserBox.Text = p.Name
                    found = p
                    break
                end
            end
        end

        if not found then
            UserBox.PlaceholderText = "Player not found!"
            UserBox.Text = ""
            active = false
            return
        end

        -- Activate
        targetName = name
        jumpsValue = jVal

        ToggleBtn.Text = "ON"
        tweenProperty(ToggleBtn, {BackgroundColor3 = C.green}, 0.3)
        toggleGlow.Color = C.greenGlow
        toggleGlow.Transparency = 0.3

        local jumpStr = (jVal == math.huge) and "infinite" or tostring(jVal)
        StatusLabel.Text = string.format("Active | %s = %s jumps", targetName, jumpStr)
        StatusLabel.TextColor3 = C.green

        -- Apply immediately
        applyExtraJumps(targetName, jumpsValue)

        -- Continuous loop
        heartbeatConn = RunService.Heartbeat:Connect(function()
            if not active then return end
            applyExtraJumps(targetName, jumpsValue)
        end)
    else
        -- Deactivate
        ToggleBtn.Text = "OFF"
        tweenProperty(ToggleBtn, {BackgroundColor3 = C.red}, 0.3)
        toggleGlow.Color = C.redGlow
        toggleGlow.Transparency = 0.6

        StatusLabel.Text = "Idle"
        StatusLabel.TextColor3 = C.textMuted

        if heartbeatConn then
            heartbeatConn:Disconnect()
            heartbeatConn = nil
        end
    end
end)

