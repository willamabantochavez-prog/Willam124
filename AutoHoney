return false end

local function hn()local t={}for _,o in ipairs(W:GetChildren())do if o.Name=="Honey"and o:IsA("Model")then table.insert(t,o)end end
if#t==0 then local w=W:FindFirstChild("Workspace")if w then for _,o in ipairs(w:GetChildren())do if o.Name=="Honey"and o:IsA("Model")then table.insert(t,o)end end end end
return t end

local function near(c)local h=hn()if#h==0 then return nil end
local r=c:FindFirstChild("HumanoidRootPart")if not r then return h[1]end
local n,d=h[1],(h[1]:GetPivot().Position-r.Position).Magnitude
for i=2,#h do local dd=(h[i]:GetPivot().Position-r.Position).Magnitude if dd<d then n,d=h[i],dd end end
return n end

local function pos(m)if m.PrimaryPart then return m:GetPivot().Position end
local mn,mx=Vector3.new(1/0,1/0,1/0),Vector3.new(-1/0,-1/0,-1/0)local f=false
for _,p in ipairs(m:GetDescendants())do if p:IsA("BasePart")then f=true
mn=Vector3.new(math.min(mn.X,p.Position.X-p.Size.X/2),math.min(mn.Y,p.Position.Y-p.Size.Y/2),math.min(mn.Z,p.Position.Z-p.Size.Z/2))
mx=Vector3.new(math.max(mx.X,p.Position.X+p.Size.X/2),math.max(mx.Y,p.Position.Y+p.Size.Y/2),math.max(mx.Z,p.Position.Z+p.Size.Z/2))end end
return f and(mn+mx)/2 or m:GetPivot().Position end

local cp2,wi,ls,lp,st=nil,1,0,nil,0
local function fly(c,t,sp)local r,h=c:FindFirstChild("HumanoidRootPart"),c:FindFirstChildOfClass("Humanoid")
if not r or not h then return end
if(t-r.Position).Magnitude<1.5 then r.AssemblyLinearVelocity=Vector3.zero cp2=nil return end
if not cp2 then local p=PF:CreatePath({AgentRadius=2,AgentCanJump=false,WaypointSpacing=4})
local ok=pcall(function()p:ComputeAsync(r.Position,t)end)
if ok and p.Status==Enum.PathStatus.Success then cp2=p wi=1 st=0 else cp2=nil
r.AssemblyLinearVelocity=(t-r.Position).Unit*sp return end end
local wp=cp2:GetWaypoints()if wi>#wp then cp2=nil return end
local pp=wi==#wp and t or wp[wi].Position
local d=(pp-r.Position)r.AssemblyLinearVelocity=d.Unit*sp
if tick()-ls>1 then if lp and(r.Position-lp).Magnitude<1.5 then st=st+1 else st=0 end lp=r.Position ls=tick()end
if st>=3 then cp2=nil st=0 end
if d.Magnitude<4 and wi<#wp then wi=wi+1 st=0 end end

