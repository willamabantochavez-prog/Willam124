            pcall(v2Retype.stop, v2Retype)
            if S.anchorConn then S.anchorConn:Disconnect() end
            if S.anchorRespawn then S.anchorRespawn:Disconnect() end
            if S.buyConn then S.buyConn:Disconnect() end
            if S.ragdollConn then S.ragdollConn:Disconnect() end
            if S.anchorOn then pcall(setAnchorParts, nil, false) end
            stopSnow()
            if GUI then GUI:Destroy() end
            if ExternalConsoleGui then ExternalConsoleGui:Destroy() end
        end
    end
end

