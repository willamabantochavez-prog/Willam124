        if parsed.error then
            addRiddleLog("API ERROR: " .. tostring(parsed.error.message or parsed.error.type or "?"))
            return
        end
        if parsed.choices and parsed.choices[1] then
            local c = parsed.choices[1].message and parsed.choices[1].message.content
            if c then addRiddleLog("SUCCESS: " .. c) else addRiddleLog("No content in choices") end
        else
            addRiddleLog("Unexpected format")
        end
    end)
end

local function findRemote()
    if _G.PhiNotifyRemote then return _G.PhiNotifyRemote end
    local ok2, Net = pcall(function() return RS:WaitForChild("Packages", 3):WaitForChild("Net", 3) end)
    if not ok2 or not Net then return nil end
    for _, d in ipairs(Net:GetDescendants()) do
        if d:IsA("RemoteEvent") then
            local ok3, conns = pcall(getconnections, d.OnClientEvent)
            if ok3 and type(conns) == "table" then
                for _, c in ipairs(conns) do
                    local ok4, fn = pcall(function() return c.Function end)
                    if ok4 and type(fn) == "function" then
                        local ok5, info = pcall(debug.getinfo or debug.info, fn)
                        if ok5 and tostring(info.short_src or info.source or ""):find("NotificationController", 1, true) then
                            return d
                        end
                    end
                end
            end
        end
    end
    return nil
end

local function hookRemote()
    aceRemote = findRemote()
    if aceRemote then
        if type(getconnections) == "function" then
            pcall(function()
                for _, c in ipairs(getconnections(aceRemote.OnClientEvent)) do c:Disable() end
            end)
        end
        aceRemote.OnClientEvent:Connect(function(text) if type(text) == "string" then onAnnouncement(text) end end)
    end
end

