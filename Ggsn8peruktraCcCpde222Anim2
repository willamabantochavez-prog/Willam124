-- Use an explicit reference timezone rather than an executor's local calendar.
local function createRiddleCalendar(config, deps)
    deps = deps or {}
    return function()
        local timestamp = deps.timestamp and deps.timestamp() or workspace:GetServerTimeNow()
        local offset = tonumber(config.RiddleUtcOffsetHours) or 0
        if offset ~= offset then offset = 0 end
        local adjusted = math.floor(timestamp + math.clamp(offset, -14, 14) * 3600)
        if deps.toDate then return deps.toDate(adjusted) end
        local current = DateTime.fromUnixTimestamp(adjusted):ToUniversalTime()
        return {day = current.Day, month = current.Month, year = current.Year}
    end
end

-- Pre-normalize the full riddle database once, after all supplied revisions are applied.
-- This avoids repeating normalization on thousands of keys for every question.
local RiddleDatabaseFacts = {}
for key, value in pairs(RiddleDatabase) do
    local normalizedKey = normalize(key)
    if normalizedKey ~= "" and value ~= nil then
        table.insert(RiddleDatabaseFacts, {key = normalizedKey, value = value})
    end
end

table.sort(RiddleDatabaseFacts, function(a, b)
    if #a.key == #b.key then
        return a.key < b.key
    end
    return #a.key > #b.key
end)

local function contains(text, phrase)
    return text:find(phrase, 1, true) ~= nil
end

-- Riddle clues must match complete words/phrases; substring matches like "og"
-- inside "unrecognized" were producing confident but unrelated answers.
local function containsPhrase(text, phrase)
    if type(text) ~= "string" or type(phrase) ~= "string" or phrase == "" then return false end
    return (" " .. text .. " "):find(" " .. phrase .. " ", 1, true) ~= nil
end

local function factAnswer(query)
    -- La coincidencia más larga evita que una clave corta tape una pregunta específica.
    -- La base suministrada tiene prioridad en empates porque contiene las revisiones más recientes.
    local best, bestLength = nil, 0
    for _, item in ipairs(RiddleDatabaseFacts) do
        if #item.key < bestLength then break end
        if #item.key > bestLength and containsPhrase(query, item.key) then
            best, bestLength = item.value, #item.key
        end
    end
    for _, item in ipairs(FACTS) do
        if #item.key > bestLength and containsPhrase(query, item.key) then
            best, bestLength = item.value, #item.key
        end
    end
    return best or ""
end

local function machineAnswer(query)
    local number = query:match("(%d+)%a*%s+machine") or query:match("(%d+)%a*%s+maquina") or query:match("machine%s*number%s*(%d+)") or query:match("machine%s*(%d+)")
    if query:find("fuse machine", 1, true) then number = "3" end
    if query:find("craft machine", 1, true) then number = "4" end
    local ordinals = {first=1,second=2,third=3,fourth=4,fifth=5,sixth=6,seventh=7,eighth=8,ninth=9,tenth=10,
        eleventh=11,twelfth=12,thirteenth=13,fourteenth=14,fifteenth=15,sixteenth=16,seventeenth=17,eighteenth=18,
        primero=1,primera=1,segundo=2,segunda=2,tercero=3,tercera=3,cuarto=4,cuarta=4,quinto=5,quinta=5,
        sexto=6,sexta=6,septimo=7,septima=7,octavo=8,octava=8,noveno=9,novena=9,decimo=10,decima=10}
    for word, pos in pairs(ordinals) do
        if containsPhrase(query, word .. " machine") or containsPhrase(query, word .. " maquina") then number = tostring(pos); break end
    end
    if not number then
        for i, name in ipairs(MACHINE_ORDER) do
            if containsPhrase(query, name:lower()) then
                if query:find("month",1,true) then
                    for _, machine in ipairs(MACHINES) do if machine.name == name then return machine.month end end
                end
                return name
            end
        end
        return ""
    end
    local pos = tonumber(number)
    if not pos then return "" end
    local machine
    for _, item in ipairs(MACHINES) do if item.position == pos then machine = item; break end end
    if not machine then return "MACHINE " .. tostring(pos) .. " NOT FOUND" end
    if contains(query, "month") and contains(query, "year") or contains(query, "mes") and contains(query, "ano") then
        return machine.month .. " " .. machine.year
    elseif contains(query, "date") or contains(query, "fecha") or contains(query, "when") or contains(query, "cuando") then
        if machine.date ~= "" then return machine.date:gsub("%s+", "") end
        return machine.month .. machine.year
    elseif contains(query, "month") or contains(query, "mes") then return machine.month
    elseif contains(query, "year") or contains(query, "ano") then return machine.year
    elseif contains(query, "day") or contains(query, "dia") then
        local day = machine.date:match("%a+%s+(%d+)")
        return day or ""
    end
    return machine.name
end

local function marketAnswer(query)
    local chosen
    for _, entry in ipairs(MARKET) do
        local longest = 0
        for _, alias in ipairs(entry.aliases) do
            local a = normalize(alias)
            if #a > longest and containsPhrase(query, a) then chosen, longest = entry, #a end
        end
    end
    if not chosen then return "" end
    local variant
    local variants = {"yin yang","yinyang","radioactive","bloodrot","diamond","rainbow","candy","galaxy","cursed","divine","cyber","phantom","crystal","eclipse","gold","lava"}
    local variantKey = {["yin yang"]="yinyang", yinyang="yinyang", radioactive="radioactive", bloodrot="bloodrot",
        diamond="diamond", rainbow="rainbow", candy="candy", galaxy="galaxy", cursed="cursed", divine="divine",
        cyber="cyber", phantom="phantom", crystal="crystal", eclipse="eclipse", gold="gold", lava="lava"}
    for _, label in ipairs(variants) do if contains(query, label) then variant = variantKey[label]; break end end
    local asksPrice = contains(query,"price") or contains(query,"cost") or contains(query,"worth") or contains(query,"value") or contains(query,"how much") or contains(query,"precio") or contains(query,"cuanto") or contains(query,"vale")
    local asksExists = contains(query,"exist") or contains(query,"how many") or contains(query,"count") or contains(query,"cuantos") or contains(query,"existencias") or contains(query,"normal")
    local exists = chosen.exists
    if variant then exists = chosen.mutations[variant] or "NAN" end
    if asksPrice then
        local number = chosen.price:match("%$([%d%.]+)")
        local price = number and (number:match("^(%d+)") or number) .. "M" or "NAN"
        if asksExists then return price .. exists end
        return price
    end
    if asksExists then return exists end
    return ""
end

local function knowledgeAnswer(query)
    local best, bestScore = nil, 0
    for _, item in ipairs(KNOWLEDGE) do
        local score = 0
        local title = normalize(item.title)
        if containsPhrase(query, title) then score = score + 10 end
        for _, keyword in ipairs(item.keywords) do
            local k = normalize(keyword)
            if #k > 2 and containsPhrase(query, k) then score = score + 4 end
        end
        if score > bestScore then best, bestScore = item, score end
    end
    if best and bestScore > 0 then return best.text end
    return ""
end

function RiddleEngine.Answer(question)
    local raw = tostring(question or "")
    local query = normalize(raw)
    if query == "" then return "UNKNOWN" end
    -- Numeric clue components are literal code characters, not unknown riddles.
    if query:match("^%d+$") then return query end

    -- Code literal: "use code ABC123"
    local code = raw:match("[Uu][Ss][Ee]%s+[Tt][Hh][Ee]%s+[Cc][Oo][Dd][Ee]%s*[:#%-]?%s*([%w_%-]+)") or raw:match("[Uu][Ss][Ee]%s+[Cc][Oo][Dd][Ee]%s*[:#%-]?%s*([%w_%-]+)")
        or raw:match("[Uu][Ss][Aa]%s+[Ee][Ll]%s+[Cc][Oo][Dd][Ii][Gg][Oo]%s*[:#%-]?%s*([%w_%-]+)") or raw:match("[Uu][Ss][Aa]%s+[Cc][Oo][Dd][Ii][Gg][Oo]%s*[:#%-]?%s*([%w_%-]+)")
    if code then return code end

    -- A known whole phrase containing "and" must not be split (for example,
    -- "black and white mutation"). Only keep it whole when an exact alias exists.
    local hasExplicitSeparator = raw:find("+", 1, true) ~= nil or raw:find("&", 1, true) ~= nil
        or raw:find(",", 1, true) ~= nil or raw:find(";", 1, true) ~= nil
        or raw:find("\n", 1, true) ~= nil or raw:find("\r", 1, true) ~= nil
    if not hasExplicitSeparator and query:find(" and ", 1, true) then
        local whole = RiddleDatabase[query]
        if whole and tostring(whole) ~= "" then return compact(whole) end
        for _, item in ipairs(FACTS) do
            if normalize(item.key) == query then return compact(item.value) end
        end
        for _, item in ipairs(KNOWLEDGE) do
            if normalize(item.title) == query and item.text and item.text ~= "" then return compact(item.text) end
        end
    end

    -- Conectores separan preguntas independientes; conservar el orden y
    -- concatenar las respuestas para formar el código final.
    local combined = raw:gsub("[\r\n;,]+", "+"):gsub("&", "+")
    combined = combined:gsub("%f[%a]and%f[%A]", "+")
    combined = combined:gsub("%f[%a]plus%f[%A]", "+")
    if combined:find("+", 1, true) then
        local parts = {}
        for part in combined:gmatch("[^+]+") do
            local p = normalize(part)
            if p ~= "" then
                local answer = p:match("^%d+$") and p or ""
                if answer == "" then answer = marketAnswer(p) end
                if answer == "" then answer = machineAnswer(p) end
                if answer == "" then answer = factAnswer(p) end
                if answer == "" then answer = brainrotNameAnswer and brainrotNameAnswer(p) or "" end
                if answer == "" then answer = knowledgeAnswer(p) end
                if answer == "" then return "UNKNOWN" end
                table.insert(parts, compact(answer))
            end
        end
        if #parts == 0 then return "UNKNOWN" end
        return table.concat(parts, "")
    end

    local answer = marketAnswer(query)
    if answer ~= "" then return answer end
    answer = machineAnswer(query)
    if answer ~= "" then return compact(answer) end
    answer = factAnswer(query)
    if answer ~= "" then return compact(answer) end
    answer = knowledgeAnswer(query)
    if answer ~= "" then return answer end
    return "UNKNOWN"
end

