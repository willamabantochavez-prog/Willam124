        if type(firesignal) ~= "function" and type(fireclick) ~= "function" then return false, "No Button Activation API" end
        if v2Flight then return false, "Waiting For Game Response" end
        if not v2CodeBox or not v2CodeBox.Parent or not v2CodeButton or not v2CodeButton.Parent then refreshV2CodeObjects() end
        if not v2CodeBox or not v2CodeButton then return false, "Waiting For Code Box Or Confirm Button" end
        if not v2CodeBox.Active then return false, "Code Box Not Active" end
        -- Match the working Aetherion adapter: avoid firing a confirm button with no handler.
