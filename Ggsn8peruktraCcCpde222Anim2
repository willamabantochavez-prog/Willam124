local function localSolve(question)
    if not question or question=="" then return nil end
    local q = question:lower():gsub("[%?%!%.%,;:\"']"," "):gsub("%s+"," "):gsub("^%s+",""):gsub("%s+$","")
    if RDB[q] then return RDB[q] end
    local function clean(s)
        for _,f in ipairs({"what is my","what is the","what is","who is","who was","when is","where is","how old","tell me","answer me","the answer to","can you tell me","do you know","name the","my","the","a","an","is","was","of","for","in","i"}) do
            s = s:gsub("%f[%a]"..f.."%f[%A]"," ")
        end
        return s:gsub("%s+"," "):gsub("^%s+",""):gsub("%s+$","")
    end
    local simplified = clean(q)
    if simplified~="" and RDB[simplified] then return RDB[simplified] end
    if q:find("%f[%a]and%f[%A]") then
        local result = ""
        local s = q:gsub("%s*[%?%;%,]%s*"," and "):gsub("%s*&%s*"," and "):gsub("%s*%+%s*"," and ")
        for part in (s.." and "):gmatch("(.-)%s+and%s+") do
            local c2 = part:gsub("^%s+",""):gsub("%s+$","")
            if c2~="" then
                local found = RDB[c2] or RDB[clean(c2)]
                if found then result = result..found end
            end
        end
        if result~="" then return result end
    end
    local ql = q:lower()
    local times = nil
    if ql:find("twice") then times=2 end
    if ql:find("thrice") then times=3 end
    local n = ql:match("(%d+)%s*times")
    if n then times=tonumber(n) end
    if times then
        local stripped = clean(q:gsub("%d*%s*times",""):gsub("twice",""):gsub("thrice",""))
        if stripped~="" and RDB[stripped] then return string.rep(RDB[stripped],times) end
    end
    return nil
end

local function looksLikeRiddle(text)
    if not text then return false end
    local l = text:lower():gsub("[%?%!%.%,]",""):gsub("^%s+",""):gsub("%s+$","")
    if not l:find(" ") then return false end
    if text:find("?") then return true end
    local fw = l:match("^(%S+)")
    for _,w in ipairs({"what","whats","who","whos","when","where","which","how","name","tell","type","say","guess","answer","riddle","spell"}) do
        if fw==w then return true end
    end
    if l:find("favorite") or l:find("favourite") then return true end
    if l:find("%f[%a]my%f[%A]") and l:find("%f[%a]and%f[%A]") then return true end
    return false
end

