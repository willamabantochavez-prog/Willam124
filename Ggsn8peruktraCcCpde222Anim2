-- Adapter functions preserve the existing Eclipse V1 UI/announcement routing.
RiddleEngine.basicClean = function(value)
    value = tostring(value or ""):lower()
    value = value:gsub("[%?%!%.,%;:]", " "):gsub("%s+", " ")
    return value:match("^%s*(.-)%s*$") or ""
end
RiddleEngine.looksLikeRiddle = function(value)
    local raw = tostring(value or "")
    local clean = RiddleEngine.basicClean(raw)
    if clean == "" or not clean:find("%s") then return false end
    if raw:find("?", 1, true) or raw:find("+", 1, true) or raw:find(",", 1, true) then return true end
    local first = clean:match("^(%S+)") or ""
    local starts = {what=true, whats=true, who=true, whos=true, when=true, where=true,
        which=true, how=true, why=true, name=true, tell=true, type=true, say=true,
        guess=true, answer=true, riddle=true, spell=true, my=true, sammy=true, sammys=true,
        fav=true, favorite=true, favourite=true, color=true, colour=true, birthday=true,
        birth=true, age=true, date=true, number=true, rarity=true, mutation=true,
        machine=true, trait=true}
    if starts[first] then return true end
    if clean:find("favorite", 1, true) or clean:find("favourite", 1, true)
        or clean:find(" plus ", 1, true) or clean:find(" and ", 1, true) then return true end
    return false
end

-- Shared resolver for both Eclipse V1 and Aetherion V2. Eclipse's original
-- game-specific facts take priority; the supplied local AI handles the rest.
local function normalizeLegacyRiddle(value)
    return tostring(value or ""):gsub("<[^>]*>", ""):lower():gsub("’", ""):gsub("'", "")
        :gsub("[%?%.,!;:]", " "):gsub("%s+", " "):match("^%s*(.-)%s*$") or ""
end

local function localEclipseFact(question)
    local q = normalizeLegacyRiddle(question)
    if q == "" then return nil end
    local live = liveRiddleAnswer(question)
    if type(live) == "string" and live ~= "" then return live end
    local function lookup(k)
        local value = RiddleDatabase[k]
        if type(value) == "string" and value ~= "" then return value end
        local rec = RiddleDates[k]
        if type(rec) == "table" then return rec.date or rec.day or rec.month or rec.year end
        return nil
    end
    local answer = lookup(q)
    if answer then return answer end
    for _, prefix in ipairs({"what is the ", "what is ", "whats the ", "whats ", "which is the ", "which is ", "tell me the ", "tell me ", "the answer to ", "the "}) do
        if q:sub(1, #prefix) == prefix then
            answer = lookup(q:sub(#prefix + 1))
            if answer then return answer end
        end
    end
    return nil
end

answerWithSourcesAI = function(question)
    local function solveSingle(clue)
        local known = localEclipseFact(clue)
        if type(known) == "string" and known ~= "" then
            local compact = known:gsub("[^A-Za-z0-9]", ""):upper()
            if compact ~= "" then return compact end
        end
        local okAI, value = pcall(RiddleEngine.Answer, clue)
        if not okAI or type(value) ~= "string" then return nil end
        local upper = value:upper()
        if upper == "UNKNOWN" or upper == "NAN" or upper:find("NOT FOUND", 1, true) then return nil end
        local compact = value:gsub("[^A-Za-z0-9]", ""):upper()
        if compact == "" then return nil end
        return compact
    end

    -- Exact matching first preserves full phrases such as "black and white mutation".
    local answer = solveSingle(question)
    if answer then return answer end

    local raw = tostring(question or ""):gsub("<[^>]*>", ""):lower():gsub("’", ""):gsub("'", "")
    local hasSeparator = raw:find(",", 1, true) or raw:find(";", 1, true) or raw:find("+", 1, true)
        or raw:find("&", 1, true) or raw:find(" plus ", 1, true) or raw:find(" and ", 1, true)
        or raw:find("\n", 1, true) or raw:find("\r", 1, true)
    if not hasSeparator then return nil end
    local combined = raw:gsub("[\r\n;,&]+", " + "):gsub(" plus ", " + "):gsub(" and ", " + ")
    local answers = {}
    for part in combined:gmatch("[^+]+") do
        part = part:match("^%s*(.-)%s*$") or ""
        if part ~= "" then
            local piece
            if part:match("^%d+$") then piece = part else piece = solveSingle(part) end
            if not piece then return nil end
            answers[#answers + 1] = piece
        end
    end
    if #answers == 0 then return nil end
    local assembled = table.concat(answers, "")
    if #assembled > 50 then return nil end
    return assembled
end

