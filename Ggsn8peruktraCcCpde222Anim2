local function solveRiddle(msg)
    setStatus("Riddle detected!",COLORS.Text)
    if _riddleSubmitV1 and not _riddleSubmitV2 then
        task.spawn(function() local a=workerSolve(msg);if a then setStatus("Worker: "..a,COLORS.Green);riddleSubmitAnswer(a) else setStatus("Worker failed",COLORS.Red) end end);return
    end
    if _riddleSubmitV2 then
        task.spawn(function()
            local la=localSolve(msg);if la then setStatus("Local: "..la,COLORS.Green);riddleSubmitAnswer(la);return end
            local ga,ge=groqSolve(msg);if ga then setStatus("AI: "..ga,COLORS.Green);riddleSubmitAnswer(ga);return end
            local wa=workerSolve(msg);if wa then setStatus("Worker: "..wa,COLORS.Green);riddleSubmitAnswer(wa);return end
            setStatus("All failed ("..tostring(ge or "miss")..")",COLORS.Red)
        end);return
    end
    if _backupRiddle then
        task.spawn(function()
            local la=localSolve(msg);if la then setStatus("Local: "..la,COLORS.Green);riddleSubmitAnswer(la);return end
            local wa=workerSolve(msg);if wa then setStatus("Worker: "..wa,COLORS.Green);riddleSubmitAnswer(wa);return end
            setStatus("Backup failed",COLORS.Red)
        end);return
    end
end

local function stripRich(t) if type(t)~="string" then return tostring(t) end;return (t:gsub("<[^>]->","")) end
local function tokenize(t) local w={};for word in t:gmatch("[%w_]+") do w[#w+1]=word end;return w end
local aceBuffer = {}

local function onAnnounce(...)
    local text=stripRich(tostring((...) or ""))
    text=text:match("^%s*(.-)%s*$") or ""
    if text=="" then return end
    if text:find("%s") then
        if _riddleSolver and looksLikeRiddle(text) then
            local key=text:lower():gsub("[%?%!%.%,]",""):gsub("^%s+",""):gsub("%s+$","")
            if key==_lastRiddleKey and tick()-_lastRiddleAt<5 then return end
            _lastRiddleKey=key;_lastRiddleAt=tick()
            solveRiddle(text)
        end
        return
    end
    if not(_autoCodeV1 or _autoCodeV2 or _autoCodeV3) then return end
    for _,word in ipairs(tokenize(text)) do aceBuffer[#aceBuffer+1]=word end
    local parts={};for i=1,math.min(#aceBuffer,ACE_WORD_COUNT) do parts[i]=aceBuffer[i] end
    if #aceBuffer<ACE_WORD_COUNT then return end
    aceBuffer={}
    local captured=table.concat(parts)
    if captured=="" or _seen[captured] then return end
    _seen[captured]=true;task.delay(1.25,function() _seen[captured]=nil end)
    appendToBox(captured)
end

local aceRemote=nil
local function findRemote()
    if _G.PhiNotifyRemote then return _G.PhiNotifyRemote end
    local ok,Net=pcall(function() return RS:WaitForChild("Packages",5):WaitForChild("Net",5) end)
    if not ok or not Net then return nil end
    if not(getconnections and debug and (debug.getinfo or debug.info)) then return nil end
    for _,d in ipairs(Net:GetDescendants()) do
        if d:IsA("RemoteEvent") then
            local ok2,cs=pcall(getconnections,d.OnClientEvent)
            if ok2 and type(cs)=="table" then
                for _,c in ipairs(cs) do
                    local f,fn=pcall(function() return c.Function end)
                    if f and type(fn)=="function" then
                        local i,info=pcall(debug.getinfo or debug.info,fn)
                        if i and tostring(info.short_src or info.source or ""):find("NotificationController",1,true) then return d end
                    end
                end
            end
        end
    end
    return nil
end

