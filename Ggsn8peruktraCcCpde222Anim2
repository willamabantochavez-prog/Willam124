    -- ══════════════════════════════════════
    -- ANNOUNCEMENT ROUTING (V2 → V1)
    -- ══════════════════════════════════════

    local function routeV1(message)
        local text = tostring(message or ""):gsub("<[^>]->", ""):match("^%s*(.-)%s*$") or ""
        if text == "" then return end
        local control = text:lower():gsub("[%p]", " "):gsub("%s+", " "):match("^%s*(.-)%s*$") or ""
        local riddleControls = {
            ["riddle"] = true, ["riddle is"] = true, ["making a riddle"] = true,
            ["im going to make a riddle"] = true, ["riddle is hard"] = true,
            ["riddle is easy"] = true, ["riddle is soon"] = true, ["riddle is ready"] = true,
        }
        if riddleControls[control] or control:find("^riddle is coming soon") then
            logRich("[EclipBrainrotAi] Riddle marker received; waiting for clue text.", "rgb(250,204,90)")
            return
        end
        if text:find("%s") then
            if cfg.riddleSolver and Engine.looksLikeRiddle(text) then
                local key = Engine.basicClean(text)
                if key == S.lastRiddleKey and tick() - S.lastRiddleAt < 5 then return end
                S.lastRiddleKey = key; S.lastRiddleAt = tick()
                queueV1Riddle(text)
            end
        else
            for word in text:gmatch("[%w_]+") do
                if word ~= "" and not S.seen[word] then
                    S.seen[word] = true
                    task.delay(1.25, function() S.seen[word] = nil end)
                    appendToBox(word)
                end
            end
        end
    end

    -- V2 riddle routing is deliberately more tolerant than V2 code scraping:
    -- announcements from this game RemoteEvent can omit sender/location metadata,
    -- while V1 still sees the text. Normalize metadata only for clear riddle clues
    -- and only while the user's V2 Auto Riddle Solver is enabled.
    local function looksLikeV2RiddleText(value)
        local text = tostring(value or ""):gsub("<[^>]*>", ""):match("^%s*(.-)%s*$") or ""
        if text == "" then return false end
        local lower = text:lower()
        if lower:find("%f[%w_]riddle%f[^%w_]") or text:find("?", 1, true)
            or text:find("+", 1, true) or lower:find(" plus ", 1, true)
            or lower:find(" and ", 1, true) then return true end
        local okLike, answerLike = pcall(Engine.looksLikeRiddle, text)
        if okLike and answerLike then return true end
        return false
    end

    local function dispatchV2Riddle(message, duration, sound, location, senderId, messageId, remove, allowBare)
        if not v2Riddle or not v2Riddle.enabled or remove or type(message) ~= "string" then return false end
        local cleanMessage = tostring(message):gsub("<[^>]*>", ""):match("^%s*(.-)%s*$") or ""
        if cleanMessage == "" then return false end
        local lowerMessage = cleanMessage:lower()
        -- Do not feed an explicit redeem-code announcement into the riddle solver.
        if lowerMessage:find("^%s*use%s+code%f[%W]")
            or lowerMessage:find("^%s*use%s+the%s+code%f[%W]")
            or lowerMessage:find("^%s*code%s+is%f[%W]") then return false end
        local looksLike = looksLikeV2RiddleText(cleanMessage)
        if not looksLike and not allowBare then return false end
        if not looksLike and allowBare then
            local okAnswer, value = pcall(answerWithSourcesAI, cleanMessage)
            if not okAnswer or type(value) ~= "string" then return false end
            local upper = value:upper()
            if upper == "" or upper == "UNKNOWN" or upper == "NAN" then return false end
        end

        -- The event came through the game's notification RemoteEvent. Treat a
        -- recognized clue as a top riddle announcement if its optional metadata
        -- is missing/inconsistent; do not apply this normalization to code parts.
        local v2Location = "Top"
        local v2Sender = AetherionConfig.SammyUserId
        local okDispatch, handled, control = pcall(function()
            v2Riddle:learn(cleanMessage, duration, sound, v2Location, v2Sender, messageId, false)
            local _, isControl = v2Riddle:observe(cleanMessage, duration, sound, v2Location, v2Sender, messageId, false)
            if isControl then return true, true end
            return v2Riddle:receive2(cleanMessage, duration, sound, v2Location, v2Sender, messageId, false), false
        end)
        if not okDispatch then
            logRich("[Eclipse V2 AI] Riddle dispatch error: " .. tostring(handled), CC.Red)
            warn("[Eclipse V2 AI] Riddle dispatch error: " .. tostring(handled))
            return false
        end
        if handled then
            logRich("[Eclipse V2 AI] Clue routed to EclipBrainrotAi: " .. cleanMessage:sub(1, 100), "rgb(250,204,90)")
            print("[Eclipse V2 AI] Clue routed to EclipBrainrotAi: " .. cleanMessage:sub(1, 160))
        end
        return handled == true
    end

    routeAnnouncement = function(replayed, ...)
        local message, duration, sound, location, senderId, messageId, remove = ...

        -- Capture for retype
        if not replayed and v2Retype then v2Retype:capture(...) end

        local fromSammy = tonumber(senderId) == AetherionConfig.SammyUserId
        local plain = tostring(message or ""):gsub("<[^>]*>", "")
        local lower = plain:lower()
        local riddleMarker = lower:find("%f[%w_]riddle%f[^%w_]" ) ~= nil
        local codeMarker = lower:find("%f[%w_]use%s+code%f[^%w_]" ) or lower:find("%f[%w_]code%s+is%f[^%w_]" )

        if not fromSammy then
            local v2Handled = false
            if cfg.v2AutoRiddle and v2Riddle and v2Riddle.enabled then
                v2Handled = dispatchV2Riddle(message, duration, sound, location, senderId, messageId, remove, false)
            end
            if not v2Handled and S.on then routeV1(message) end
            return v2Handled
        end

        -- From Sammy: V2 first
        local handled = false
        -- V2 Auto Mode + riddle marker
        if v2Engine.autoMode and riddleMarker then
            if v2Engine:startRiddle() then
                if v2Riddle.enabled then
                    dispatchV2Riddle(message, duration, sound, location, senderId, messageId, remove, true)
                end
                handled = true
            end
        end

        -- V2 Auto Mode or enabled + code marker
        if not handled and (v2Engine.enabled or v2Engine.autoMode) and codeMarker then
            handled = v2Engine:receive(...)
        end

        -- V2 Auto Riddle Solver: run every eligible clue through the shared
        -- EclipBrainrotAi-backed resolver, even when notification metadata varies.
        if not handled and v2Riddle.enabled and v2Riddle.armed then
            handled = dispatchV2Riddle(message, duration, sound, location, senderId, messageId, remove, true)
        end

        -- V2 bare parts (not in riddle mode)
        if not handled and v2Engine.enabled and not v2Engine.autoRiddle then
            if plain:match("^[A-Za-z0-9]+$") and not riddleMarker then
                handled = v2Engine:receive(...)
            end
        end

        -- V1 fallback (if not handled by V2)
        if not handled and S.on then routeV1(message) end

        return handled
    end

    -- ══════════════════════════════════════
    -- FIND NOTIFICATION REMOTE & INSTALL RESPONSES
    -- ══════════════════════════════════════

    local function installV2Responses()
        if v2ResponsesConnected then return true end
        if not v2Notification or type(v2Notification.Start) ~= "function" then return false end
        if not v2CodesScript then return false end

        local expectedSource = v2CodesScript:GetFullName()

        for _, name in ipairs({"Success", "Error"}) do
            local original = v2Notification[name]
            if type(original) ~= "function" then return false end

            local wrapper
            wrapper = function(self, message, ...)
                local caller = nil
                pcall(function()
                    if type(debug.info) == "function" then caller = debug.info(2, "s")
                    elseif type(debug.getinfo) == "function" then caller = debug.getinfo(2, "S").short_src end
                end)

                local pending = v2Flight
                if _alive and pending and caller == expectedSource and not pending.box.Active then
                    local code = pending.code
                    local nativeMessage = tostring(message or "")
                    v2Flight = nil
                    local ok3, err3 = pcall(pending.callback, name == "Success", nativeMessage)
                    if not ok3 then warn("[Eclipse V2] " .. tostring(err3)) end
                end
                return original(self, message, ...)
            end

            v2Notification[name] = wrapper
        end

        v2ResponsesConnected = true
        logRich("V2 response hooks installed", CC.Green)
        return true
    end

    local function findNotificationRemote()
        -- Find NotificationController module
        local ok2, ctrl = pcall(function()
            return RS:WaitForChild("Controllers", 15):WaitForChild("NotificationController", 15)
        end)
        if not ok2 or not ctrl then v2ReadyReason = "Controllers Not Found"; return false end

        local ok3, mod = pcall(require, ctrl)
        if not ok3 or type(mod) ~= "table" then v2ReadyReason = "Notification Module Unavailable"; return false end
        v2Notification = mod

        if type(mod.Start) ~= "function" then v2ReadyReason = "Notification.Start Missing"; return false end

        -- Get RemoteEvent from upvalues
        local ok4, ups = pcall(function() return debug.getupvalues(mod.Start) end)
        if not ok4 or type(ups) ~= "table" then v2ReadyReason = "Cannot Read Upvalues"; return false end

        local found = nil
        for _, v in pairs(ups) do
            if typeof(v) == "Instance" and v:IsA("RemoteEvent") and v:IsDescendantOf(RS) then
                if found and found ~= v then v2ReadyReason = "Ambiguous Remote"; return false end
                found = v
            end
        end
        if not found then v2ReadyReason = "Remote Not In Upvalues"; return false end

        v2NotifyRemote = found

        -- Connect announcement event
        found.OnClientEvent:Connect(function(...)
            routeAnnouncement(false, ...)
        end)
        v2ReadyReason = nil
        logRich("V2 listener: " .. found.Name, CC.Green)

        -- Find CodesController for response hooks
        local csOk, cs = pcall(function()
            return RS:WaitForChild("Controllers", 5):WaitForChild("CodesController", 5)
        end)
        if csOk and cs then
            local cmOk, cmod = pcall(require, cs)
            if cmOk and type(cmod) == "table" then
                v2CodesScript = cs
                installV2Responses()
            end
        end

        return true
    end

    -- Try to find remote (with retries)
    task.spawn(function()
        for retry = 1, 5 do
            if findNotificationRemote() then break end
            task.wait(retry * 2)
        end
        if v2Engine then v2Engine:wake() end
        if v2Riddle then v2Riddle:wake() end
    end)

