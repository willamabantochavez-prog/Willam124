    if not ok2 or type(res)~="table" then return nil,"fail" end
    local rb = res.Body or res.body
    if type(rb)~="string" then return nil,"no body" end
    local st = tonumber(res.StatusCode or res.Status or 0) or 0
    if st<200 or st>=300 then return nil,"HTTP "..st end
    local d,data = pcall(function() return HS:JSONDecode(rb) end)
    if not d or type(data)~="table" then return nil,"json" end
    local ch = data.choices and data.choices[1]
    local msg = ch and ch.message and ch.message.content
    if not msg then return nil,"empty" end
    msg = msg:gsub("<[^>]->",""):match("([^\r\n]+)") or msg
    msg = msg:gsub("^%s+",""):gsub("%s+$",""):gsub("^[\"']+",""):gsub("[\"']+$",""):upper():gsub("%s+",""):gsub("[%?%.%,!]","")
    if msg=="" or #msg>160 then return nil,"bad" end
    return msg
end

