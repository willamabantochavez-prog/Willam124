-- ══════════════════════════════════════════
-- CORE LOGIC (BOTH V1 + V2 MECHANISMS)
-- ══════════════════════════════════════════
local function initCoreLogic()
    local GUI = Window.Parent
    local Engine = RiddleEngine
    local _alive = true

    -- ─── TIMER HELPERS ───
    local function afterFn(seconds, cb) task.delay(seconds, function() if _alive then cb() end end) end
    local function deferFn(cb) task.defer(function() if _alive then cb() end end) end

    -- ══════════════════════════════════════
    -- V1 MECHANISMS (from working V1 script)
    -- ══════════════════════════════════════

    local function resetCapture() S.parts = {} end

    local function clearBoxWatch()
        if S.boxConn then pcall(function() S.boxConn:Disconnect() end) end
        if S.boxAncConn then pcall(function() S.boxAncConn:Disconnect() end) end
        S.boxConn = nil; S.boxAncConn = nil; S.watchedBox = nil
    end

    local function watchBox(box)
        if not box or S.watchedBox == box then return end
        clearBoxWatch(); S.watchedBox = box
        if box.Text ~= "" then S.lastNonBlank = box.Text end
        S.boxConn = box:GetPropertyChangedSignal("Text"):Connect(function()
            if box.Text == "" then resetCapture() else S.lastNonBlank = box.Text end
        end)
        S.boxAncConn = box.AncestryChanged:Connect(function(_, p2) if not p2 then resetCapture(); clearBoxWatch() end end)
    end

    clearPending = function()
        S.pendingToken = S.pendingToken + 1; S.pendingText = nil; S.pendingBox = nil; S.pendingUntil = 0
    end

    rememberPending = function(box, text, replace)
        if not text or text == "" then return end
        if not replace and S.pendingText and os.clock() <= S.pendingUntil then return end
        S.pendingToken = S.pendingToken + 1
        local tok = S.pendingToken; S.pendingText = text; S.pendingBox = box; S.pendingUntil = os.clock() + 8
        task.delay(8, function() if tok == S.pendingToken then clearPending() end end)
    end

    local function restoreRejected(box, text)
        if not cfg.retypeInvalid or not text or text == "" then return false end
        RunService.Heartbeat:Wait()
        local target = codeBoxFn() or box
        if not target or not visChain(target) then return false end
        local ok2 = pcall(function() target.Text = text end)
        if ok2 then S.lastBox = target; watchBox(target) end
        return ok2
    end

    handleFeedback = function(text, src)
        if not S.pendingText then return end
        if os.clock() > S.pendingUntil then clearPending(); return end
        if src and src:IsDescendantOf(GUI) then return end
        local lower = tostring(text or ""):lower()
        local rej = lower:find("invalid code", 1, true) or lower:find("code is invalid", 1, true)
            or lower:find("expired", 1, true) or lower:find("already redeemed", 1, true)
            or lower:find("already used", 1, true) or lower:find("doesn't exist", 1, true)
        local acc = lower:find("code redeemed", 1, true) or lower:find("redeemed successfully", 1, true)
            or lower:find("successfully redeemed", 1, true) or lower:find("success", 1, true) or lower == "redeemed"
        if not rej and not acc then return end
        local prev = S.pendingText
        if acc and not rej then clearPending(); setStatus("VALID - " .. prev, CC.Green); return end
        local restored = false
        if cfg.retypeInvalid then restored = restoreRejected(S.pendingBox, prev) end
        clearPending()
        if restored then setStatus("INVALID - " .. prev .. " (retyped)", "rgb(250,204,90)")
        else setStatus("INVALID - " .. prev, CC.Red) end
    end

    typeAndSubmitCode = function(code, submitNow)
        if not player then return false, "no player" end
        local pGui = player:FindFirstChildOfClass("PlayerGui")
        if not pGui then return false, "no pg" end
        code = tostring(code or "")
        if code == "" then return false, "empty" end

        -- Try direct Codes GUI first
        local cg = pGui:FindFirstChild("Codes")
        if cg then
            local cf = cg:FindFirstChild("Codes") or cg
            if cf then
                local redeem = cf:FindFirstChild("CodeRedeem", true)
                local box = redeem and redeem:FindFirstChild("TextBox", true)
                if not (box and box:IsA("TextBox") and not isOurGui(box)) then
                    for _, d in ipairs(cf:GetDescendants()) do
                        if d:IsA("TextBox") and not isOurGui(d) and (d.Name:lower():find("code") or d.PlaceholderText:lower():find("code")) then box=d; break end
                    end
                end
                if not (box and box:IsA("TextBox")) then
                    for _, d in ipairs(cf:GetDescendants()) do if d:IsA("TextBox") and not isOurGui(d) then box=d; break end end
                end
                if box then
                    local btn = findSubmitBtn(box)
                    if not btn then
                        for _, d in ipairs(cf:GetDescendants()) do
                            if d:IsA("GuiButton") and not isOurGui(d) then
                                local n=d.Name:lower(); local label=""; pcall(function() label=(d.Text or ""):lower() end)
                                if n:find("confirm") or n:find("submit") or n:find("redeem") or label:find("confirm") or label:find("submit") or label:find("redeem") or label:find("claim") then btn=d; break end
                            end
                        end
                    end
                    if rememberPending then rememberPending(box, code, true) end
                    local setOk=pcall(function() box.Text=code end)
                    task.wait(math.max(0.01, cfg.redeemDelay))
                    if not setOk or box.Text~=code then return false, "textbox rejected code" end
                    fireBoxFocusLost(box)
                    if submitNow==false then return true, "pasted in game code box" end
                    if not btn then return false, "pasted, but submit button not found" end
                    if not clickBtn(btn) then return false, "pasted, but executor could not activate submit button" end
                    return true, "pasted and submit activated"
                end
            end
        end

        -- Fallback: find any visible code box
        local btns = {}
        for _, g in ipairs(pGui:GetChildren()) do
            if g:IsA("ScreenGui") and g.Enabled and not isOurGui(g) then
                for _, d in ipairs(g:GetDescendants()) do
                    if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOurGui(d) then
                        local n = d.Name:lower(); local pn = (d.Parent and d.Parent.Name or ""):lower()
                        if (n:find("code") or n:find("redeem") or pn:find("code") or pn:find("redeem")) and visChain(d) then
                            btns[#btns + 1] = d
                        end
                    end
                end
            end
        end
        for _, b in ipairs(btns) do clickBtn(b); task.wait(0.05) end
        task.wait(0.3)

        local box = nil; local dl = tick() + 3
        while tick() < dl do
            for _, d in ipairs(findAllBoxes()) do if visChain(d) then box = d; break end end
            if box then break end
            task.wait(0.1)
        end
        if not box then return false, "no codebox" end
        if rememberPending then rememberPending(box, code, true) end
        local setOk=pcall(function() box.Text = code end)
        task.wait(math.max(0.01, cfg.redeemDelay))
        if not setOk or box.Text~=code then return false, "fallback textbox rejected code" end
        fireBoxFocusLost(box)
        if submitNow==false then return true, "pasted in game code box (fallback)" end
        local btn = findSubmitBtn(box)
        if not btn then return false, "pasted, but submit button not found" end
        if not clickBtn(btn) then return false, "pasted, but executor could not activate submit button" end
        return true, "pasted and submit activated (fallback)"
    end

    appendToBox = function(text)
        if not text or text == "" then return end
        if S.watchedBox and not visChain(S.watchedBox) then resetCapture(); clearBoxWatch() end
        local box = codeBoxFn()
        S.parts[#S.parts + 1] = text
        local combined = table.concat(S.parts)
        local count = #S.parts
        updateV3Ind(count, cfg.submitAfter)
        if box then S.lastBox = box; watchBox(box); pcall(function() box.Text = combined end) end
        local cb = _G._eCodeBox; if cb then cb.Text = combined end
        logRich("code " .. count .. "/" .. cfg.submitAfter .. ": " .. combined)
        if count >= cfg.submitAfter then
            S.parts = {}
            if cfg.autoSubmit then
                rememberPending(box, combined, true)
                local ok2, msg = typeAndSubmitCode(combined)
                if ok2 then setStatus("SUBMITTED - " .. combined, CC.Green)
                else
                    local rest = restoreRejected(box, combined); clearPending()
                    if rest then setStatus("FAILED - " .. combined .. " (retyped)", "rgb(250,204,90)")
                    else setStatus("FAILED - " .. combined .. " (" .. tostring(msg) .. ")", CC.Red) end
                end
            end
        end
    end

    clearCapture = function() S.parts = {}; updateV3Ind(0, cfg.submitAfter) end

    -- V1 and V2 both call the shared Eclipse + EclipBrainrotAi resolver.
    local function runV1Riddle(question)
        S.askedCount = S.askedCount + 1
        logRich("[EclipBrainrotAi] Question: " .. tostring(question):sub(1, 100), "rgb(250,204,90)")
        print("[EclipBrainrotAi] Question: " .. tostring(question):sub(1, 180))
        local okAI, rawAnswer = pcall(answerWithSourcesAI, question)
        if not okAI then
            logRich("[EclipBrainrotAi] ERROR: " .. tostring(rawAnswer), CC.Red)
            warn("[EclipBrainrotAi] " .. tostring(rawAnswer))
            return
        end
        local answer = tostring(rawAnswer or ""):match("^%s*(.-)%s*$") or ""
        local upper = answer:upper()
        local compactAnswer = answer:gsub("[^A-Za-z0-9]", "")
        if answer == "" or upper == "UNKNOWN" or upper == "NAN" or upper:find("NOT FOUND", 1, true) or compactAnswer == "" then
            S.askedCount = math.max(0, S.askedCount)
            logRich("[EclipBrainrotAi] No local answer for this clue; nothing was submitted.", CC.Red)
            print("[EclipBrainrotAi] UNKNOWN - nothing submitted")
            if setStatus then setStatus("AI: UNKNOWN RIDDLE", CC.Red) end
            return
        end
        answer = compactAnswer:upper()
        S.solvedCount = S.solvedCount + 1
        logRich("[EclipBrainrotAi] Answer: " .. answer, CC.Green)
        print("[EclipBrainrotAi] Answer: " .. answer)
        local cb = _G._eCodeBox; if cb then cb.Text = answer end
        local pasted, result = typeAndSubmitCode(answer, cfg.autoSubmit)
        if pasted then
            logRich("[EclipBrainrotAi] " .. tostring(result), CC.Green)
            print("[EclipBrainrotAi] " .. tostring(result))
            if setStatus then setStatus((cfg.autoSubmit and "AI CODE SUBMITTED - " or "AI CODE PASTED - ") .. answer, CC.Green) end
        else
            logRich("[EclipBrainrotAi] PASTE/SUBMIT ERROR: " .. tostring(result), CC.Red)
            warn("[EclipBrainrotAi] PASTE/SUBMIT ERROR: " .. tostring(result))
            if setStatus then setStatus("AI ANSWER FOUND - " .. tostring(result), CC.Red) end
        end
    end

    local function pumpV1Queue()
        if S.riddleBusy then return end
        S.riddleBusy = true
        task.spawn(function()
            while #S.riddleQueue > 0 do
                local q = table.remove(S.riddleQueue, 1)
                local okRun, runErr = pcall(runV1Riddle, q)
                if not okRun then
                    logRich("[EclipBrainrotAi] UNCAUGHT ERROR: " .. tostring(runErr), CC.Red)
                    warn("[EclipBrainrotAi] UNCAUGHT ERROR: " .. tostring(runErr))
                end
            end
            S.riddleBusy = false
        end)
    end

    local function queueV1Riddle(q)
        if #S.riddleQueue > 6 then return end
        S.riddleQueue[#S.riddleQueue + 1] = q; pumpV1Queue()
    end

