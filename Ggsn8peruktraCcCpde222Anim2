            local f = chat:FindFirstChild("Frame")
            if f then
                local cb = f:FindFirstChild("ChatBarParentFrame")
                if cb then
                    local bf = cb:FindFirstChild("Frame")
                    if bf then
                        local eb = bf:FindFirstChild("BoxFrame")
                        if eb then
                            local ef = eb:FindFirstChild("Frame")
                            if ef then
                                local bar = ef:FindFirstChild("ChatBar")
                                if bar then return bar end
                            end
                        end
                    end
                end
            end
        end
        return nil
    end)
    if s2 and box then return box end
    return nil
