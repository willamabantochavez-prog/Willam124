        S.anchorOn = state; cfg.anchor = state; saveCfg()
        local t = BG_THEMES[cfg.bg] or BG_THEMES[1]
        ATgl.Text = state and "ON" or "OFF"
        ATgl.BackgroundColor3 = state and t.Accent or t.Control
        ATgl.TextColor3 = state and t.TabTextOn or t.Dim
        ATS.Color = state and t.Accent or t.Border
        ATS.Transparency = state and 0.4 or 0.7
        if state then
            local ch = player.Character; if not ch then return end
            local r = ch:FindFirstChild("HumanoidRootPart"); if not r then return end
            S.anchorPos = r.CFrame; setAnchorParts(ch, true)
            if S.anchorConn then S.anchorConn:Disconnect() end
            S.anchorConn = RunService.Heartbeat:Connect(function()
                if not S.anchorOn or not S.anchorPos then return end
                local c = player.Character; if not c then return end
                local r2 = c:FindFirstChild("HumanoidRootPart"); if not r2 then return end
                if (r2.Position - S.anchorPos.Position).Magnitude > 2 then r2.CFrame = S.anchorPos end
                pcall(function() r2.AssemblyLinearVelocity = Vector3.zero end)
            end)
            if S.anchorRespawn then S.anchorRespawn:Disconnect() end
