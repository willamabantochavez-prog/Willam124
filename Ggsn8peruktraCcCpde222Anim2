                task.wait(1.5)
                local nr = nc:WaitForChild("HumanoidRootPart", 5)
                if nr then nr.CFrame = S.anchorPos end
            end)
        else
            if S.anchorConn then S.anchorConn:Disconnect(); S.anchorConn = nil end
            if S.anchorRespawn then S.anchorRespawn:Disconnect(); S.anchorRespawn = nil end
            S.anchorPos = nil; setAnchorParts(nil, false)
        end
    end
