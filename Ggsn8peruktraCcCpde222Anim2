        -- just like the V1 AI solver. Only unresolved engine answers fall back
        -- to Eclipse's legacy riddle database/shared resolver.
        local function validAnswer(value)
            if type(value)~="string" then return nil end
            value=value:match("^%s*(.-)%s*$") or ""
