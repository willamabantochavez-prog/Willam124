appendToBox = function(text)
    if not text or text=="" then return end
    if _lastWatchedBox and not visChain(_lastWatchedBox) then resetCapture();clearBoxWatch() end
    local box=aceBox()
    _capturedParts[#_capturedParts+1]=text
    local combined=table.concat(_capturedParts)
    local count=#_capturedParts
    if box then _lastBox=box;watchBox(box);pcall(function() box.Text=combined end) end
    setStatus(count.."/".._submitAfter.." "..combined,COLORS.Green)
    flashCode(combined,COLORS.Green)
    if count>=_submitAfter then
        _capturedParts={}
        if _autoCodeV1 then
            if type(setclipboard)=="function" then pcall(setclipboard,combined) end
            setStatus("v1 copied: "..combined,COLORS.Green)
        end
        if _autoCodeV2 then
            local b2=aceBox()
            if b2 then pcall(function() b2.Text=combined end);fireFocusLost(b2);setStatus("v2 typed: "..combined,COLORS.Green)
            else setStatus("v2 no box",COLORS.Red) end
        end
        if _autoCodeV3 then
            local b3=aceBox()
            if b3 then pcall(function() b3.Text=combined end);fireFocusLost(b3);setStatus("v3 typed+fl: "..combined,COLORS.Green)
            else setStatus("v3 no box",COLORS.Red) end
        end
        if _autoSubmitV1 then
            local ok2,msg=voltSubmit(combined)
            if ok2 then setStatus("sub v1 volt: "..combined,COLORS.Green) else setStatus("sub v1 fail: "..tostring(msg),COLORS.Red) end
        end
        if _autoSubmitV2 then
            local ok2,msg=basicSubmit(combined)
            if ok2 then setStatus("sub v2 basic: "..combined,COLORS.Green) else setStatus("sub v2 fail: "..tostring(msg),COLORS.Red) end
        end
        if _autoSubmitV3 then
            updateV3Ind(count,_submitAfter)
        end
        if _autoSubmitV4 then
            local ok2,msg=typeAndSubmit(combined)
            if ok2 then setStatus("sub v4 test: "..combined,COLORS.Green) else setStatus("sub v4 fail: "..tostring(msg),COLORS.Red) end
        end
    end
end

