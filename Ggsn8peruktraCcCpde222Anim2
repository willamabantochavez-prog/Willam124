local function pasteToChat(text)
    local box = findChatBox()
    if box then
        box.Text = "/" .. text
        if type(firesignal) == "function" then pcall(firesignal, box.FocusLost, true) end
        return true
    end
    return false
end

local function v3SetGreen() v3IsGreen = true; v3Count = submitAfter end
local function v3SetRed() v3IsGreen = false; v3Count = 0 end

local function submitCode(code)
    if cfg.autoCopy1 and setclipboard then pcall(setclipboard, code); addFeed("Copied: " .. code) end
    if cfg.autoCopy2 then
        if pasteToChat(code) then addFeed("Pasted: " .. code) else addFeed("Chat box not found") end
    end
end

local function appendWord(word)
    table.insert(codeBuffer, word)
    v3Count = #codeBuffer
    local code = table.concat(codeBuffer, " ")
    addFeed("Word " .. v3Count .. "/" .. submitAfter .. ": " .. word)
    if v3Count >= submitAfter then
        v3SetGreen()
        task.delay(10, function()
            if v3Count >= submitAfter then v3SetRed(); codeBuffer = {} end
        end)
        submitCode(code)
    end
end

