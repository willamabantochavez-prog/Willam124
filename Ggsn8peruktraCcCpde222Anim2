            pcall(deps.log,"V2 AI: "..tostring(msg))
        end
    end
    local function cancelFn(job) if job and deps.cancel then deps.cancel(job) end end
    local function refreshEntries() s.answers,s.questions={},{} for _,e in ipairs(s.entries) do s.answers[#s.answers+1]=e.value or"?" s.questions[#s.questions+1]=e.question end s.revision+=1 end
    local function reset(msg) cancelFn(s.timer) if not s.pending then cancelFn(s.responseTimer) s.responseTimer=nil end s.timer,s.waitingForReady,s.retryAt=nil,false,nil s.session+=1 s.entries,s.attempts,s.transientRetries={},{},{} s.completedQuestion,s.lastClueAt=nil,nil refreshEntries() emit(msg or(s.enabled and "Waiting For A Riddle..." or "V2 Riddle Solver Off")) end
    local function learnedValue(q) local r=s.learned[q] if type(r)=="string" then return r end if type(r)=="table" then return r.answer end end
    local months={"january","february","march","april","may","june","july","august","september","october","november","december"}
    local todayFields={["todays date"]="date",["todays day"]="day",["todays month"]="month",["todays year"]="year",["date today"]="date",["day today"]="day",["month today"]="month",["year today"]="year",["today date"]="date",["today day"]="day",["today month"]="month",["today year"]="year",["day of the month"]="day",["date of the month"]="day"}
    local function todayQuery(q,req) local field=todayFields[q] if not field then return nil end field=req or field local cur=deps.currentDate and deps.currentDate() or os.date("!*t") local rec={date=tostring(cur.day),day=tostring(cur.day),month=months[cur.month],year=tostring(cur.year)} return rec[field],q.." "..field end
    local function exact(question)
        local orig,q=normalize(question),key(question)
