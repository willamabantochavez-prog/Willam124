function createSettingsStore(config,deps)
    config,deps=config or {},deps or {}
    local path="AetherionAutoCodeRedeemer.settings.json"
    local maxBytes=16*1024 local lastCanonical
    local function finite(v) return type(v)=="number" and v==v and v>-math.huge and v<math.huge end
    local maxParts=finite(config.MaxParts) and math.max(1,math.floor(config.MaxParts)) or 12
    local defaultParts=finite(config.DefaultParts) and math.clamp(math.floor(config.DefaultParts),1,maxParts) or math.min(3,maxParts)
    local function options(v) return type(v)=="table" and v or {} end
    local function bounded(v,mn,mx,fb,int) if not finite(v) then return fb end if int then v=math.floor(v) end return math.clamp(v,mn,mx) end
    local function sanitize(v) v=options(v) local riddle,admin=options(v.riddleSettings),options(v.adminAbuse) local clean={version=1,enabled=v.enabled==true,guess=v.guess==true,partsMode=v.partsMode==true,partsModeBeforeGuess=v.partsModeBeforeGuess==true,autoMode=v.autoMode==true,amount=bounded(v.amount,1,maxParts,defaultParts,true),riddleEnabled=v.riddleEnabled==true,riddleBeforeAuto=v.riddleBeforeAuto==true,riddleSettings={learnFacts=riddle.learnFacts==true,fallback=riddle.fallback==true,fallbackDelay=bounded(riddle.fallbackDelay,0,1,0.55,false)},fpsBoost=v.fpsBoost==true,adminAbuse={autoBuy=admin.autoBuy==true,antiRagdoll=admin.antiRagdoll==true,lockPosition=admin.lockPosition==true}} if type(v.manualBeforeAuto)=="table" then local m=v.manualBeforeAuto clean.manualBeforeAuto={enabled=m.enabled==true,guess=m.guess==true,partsMode=m.partsMode==true,partsModeBeforeGuess=m.partsModeBeforeGuess==true} end return clean end
    local function canonical(v) if type(v)~="table" then return tostring(v) end local keys,result={},{} for k in pairs(v) do table.insert(keys,k) end table.sort(keys) for _,k in ipairs(keys) do table.insert(result,'"'..k..'":'..canonical(v[k])) end return "{"..table.concat(result,",").."}" end
    local store={path=path}
    function store:load() lastCanonical=nil if type(deps.read)~="function" or type(deps.decode)~="function" then return nil,"unavailable" end local o,r=pcall(deps.read,path) if not o then return nil,"read_failed" end if r==nil or r=="" then return nil,"missing" end if type(r)~="string" or #r>maxBytes then return nil,"invalid_file" end local d,v=pcall(deps.decode,r) if not d or type(v)~="table" then return nil,"decode_failed" end if v.version~=1 then return nil,"unsupported_version" end local c=sanitize(v) lastCanonical=canonical(c) return c end
    function store:save(v) if type(deps.write)~="function" or type(deps.encode)~="function" then return false,"unavailable" end local c=sanitize(v) local n=canonical(c) if n==lastCanonical then return true,"unchanged" end local o,r=pcall(deps.encode,c) if not o or type(r)~="string" or #r==0 or #r>maxBytes then return false,"encode_failed" end local w,res=pcall(deps.write,path,r) if not w or res==false then return false,"write_failed" end lastCanonical=n return true,"saved" end
    return store
end

function createRetypeReplay(config,deps)
    local r={alive=true,busy=false,records={},serial=0,generation=0}
    local maxR=math.clamp(math.floor(tonumber(config.RetypeBufferLimit) or 32),1,128)
    local ttl=math.max(1,tonumber(config.RetypeBufferTTL) or 180)
    local maxLen=math.max(1,math.floor(tonumber(config.RetypeMessageLimit) or 1024))
    local function clean(v) return (v:gsub("<[^>]*>","")):match("^%s*(.-)%s*$") end
    local function prune(now2) local f={} for _,rec in ipairs(r.records) do if now2-rec.at<=ttl then f[#f+1]=rec end end while #f>maxR do table.remove(f,1) end r.records=f end
    function r:capture(msg,dur,snd,loc,sender,id,remove) if not self.alive or remove or loc~="Top" or type(msg)~="string" or tonumber(sender)~=config.SammyUserId or #msg==0 or #msg>maxLen then return false end local now2=deps.now() prune(now2) self.serial+=1 self.records[#self.records+1]={message=msg,sender=config.SammyUserId,id=id~=nil and tostring(id)~="" and tostring(id) or nil,plain=clean(msg),at=now2,serial=self.serial} prune(now2) return true end
    function r:run() if not self.alive or self.busy then return false,"Already Running" end local bl,rs=deps.blocked() if bl then return false,rs end if not deps.modeEnabled() then return false,"No Mode" end prune(deps.now()) if #self.records==0 then return false,"No Announcements" end self.busy=true self.generation+=1 local ok2=pcall(function() deps.beginBatch() deps.resetCollections() for _,rec in ipairs(self.records) do if not self.alive then break end deps.dispatch(rec.message,rec.duration,nil,"Top",rec.sender,"retype:"..self.generation..":"..rec.serial,false) end end) self.busy=false deps.endBatch(ok2) if not ok2 then return false,"Failed" end return true,"Retyped "..#self.records end
    function r:stop() self.alive=false self.records={} end return r
end

