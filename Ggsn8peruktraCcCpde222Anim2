    local function key(v) local q=normalize(payload(v)) q=q:gsub("^what%s+is%s+",""):gsub("^whats%s+",""):gsub("^tell%s+me%s+",""):gsub("^the%s+answer%s+to%s+",""):gsub("^the%s+","") return q end
    local function encoded(v) return(tostring(v or ""):gsub("[^A-Za-z0-9]",""):upper()) end
    local function emit(msg)
        local previous=s.status
        if msg then s.status=msg end
        deps.changed(s)
        local important = msg and (msg:find("Riddle Answer",1,true) or msg:find("Submitting",1,true)
            or msg:find("Unknown Part",1,true) or msg:find("Code Box",1,true)
            or msg:find("Code Redeemed",1,true) or msg:find("Submit Failed",1,true)
            or msg:find("Rejected",1,true) or msg:find("Game Response",1,true))
