-- La base se guarda comprimida para mantener este archivo único y evitar que
-- el texto fuente supere el límite práctico de tamaño de Roblox Studio.
local function decodeRiddleBase64(source)
    local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local map = {}
    for index = 1, #alphabet do
        map[alphabet:sub(index, index)] = index - 1
    end
    local output = {}
    local buffer, bits = 0, 0
    for index = 1, #source do
        local char = source:sub(index, index)
        if char ~= "=" then
            local value = map[char]
            if value ~= nil then
                buffer = buffer * 64 + value
                bits = bits + 6
                if bits >= 8 then
                    bits = bits - 8
                    output[#output + 1] = math.floor(buffer / (2 ^ bits)) % 256
                    buffer = buffer % (2 ^ bits)
                end
            end
        end
    end
    return output
end

local function decompressRiddleData(source)
    local output = {}
    local position = 1
    while position <= #source do
        local flags = source[position]
        position = position + 1
        for bit = 0, 7 do
            if position > #source then break end
            local isReference = math.floor(flags / (2 ^ bit)) % 2 == 1
            if isReference then
                if position + 1 > #source then error("Riddle data is truncated") end
                local code = source[position] * 256 + source[position + 1]
                position = position + 2
                local distance = math.floor(code / 16)
                local length = (code % 16) + 3
                if distance < 1 or distance > #output then error("Invalid Riddle data reference") end
                for _ = 1, length do
                    output[#output + 1] = output[#output - distance + 1]
                end
            else
                output[#output + 1] = source[position]
                position = position + 1
            end
        end
    end

    local chunks = {}
    for first = 1, #output, 2048 do
        local bytes = {}
        local last = math.min(first + 2047, #output)
        for index = first, last do
            bytes[#bytes + 1] = string.char(output[index])
        end
        chunks[#chunks + 1] = table.concat(bytes)
    end
    return table.concat(chunks)
end

