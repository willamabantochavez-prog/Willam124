    end
    if _autoCodeV2 then
        local box=aceBox()
        if box then pcall(function() box.Text=ans end);fireFocusLost(box);setStatus("v2 typed: "..ans,COLORS.Green)
        else setStatus("v2 no box",COLORS.Red) end
    end
    if _autoCodeV3 then
        local box=aceBox()
        if box then pcall(function() box.Text=ans end);fireFocusLost(box);setStatus("v3 typed+fl: "..ans,COLORS.Green)
        else setStatus("v3 no box",COLORS.Red) end
    end
    if _autoSubmitV1 then
        local ok2,msg=voltSubmit(ans)
        if ok2 then setStatus("sub v1 volt: "..ans,COLORS.Green) else setStatus("sub v1 fail: "..tostring(msg),COLORS.Red) end
