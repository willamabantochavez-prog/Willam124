local function solveLocalDB(text)
    local lower = text:lower()
    for pattern, ans in pairs(riddleDB) do
        if lower:find(pattern, 1, true) then return ans end
    end
    for pattern, ans in pairs(riddleDB) do
        local words = {}
        for w in pattern:gmatch("%w+") do table.insert(words, w) end
        local matches = 0
        for _, w in ipairs(words) do if lower:find(w, 1, true) then matches += 1 end end
        if matches >= math.max(3, math.ceil(#words * 0.7)) then return ans end
    end
    return nil
end

local function solveWorker(text)
    if not cfg.workerUrl or cfg.workerUrl:gsub("%s", "") == "" then return nil end
    if not reqFunc then return nil end
    local ok2, res = pcall(reqFunc, {Url = cfg.workerUrl .. "?q=" .. HS:UrlEncode(text), Method = "GET"})
    if not ok2 then addRiddleLog("Worker fail: " .. tostring(res)); return nil end
    local body = type(res) == "table" and (res.Body or res.body) or res
    if not body then return nil end
    local parsed = nil; pcall(function() parsed = HS:JSONDecode(body) end)
    if parsed and parsed.answer then return tostring(parsed.answer) end
    return nil
end

local function solveGroq(text)
    if not cfg.groqKey or cfg.groqKey:gsub("%s", "") == "" then
        addRiddleLog("Groq: No API key set!"); return nil
    end
    if not reqFunc then
        addRiddleLog("Groq: No HTTP request func!"); return nil
    end
    addRiddleLog("Calling Groq API...")
    local ok2, res = pcall(reqFunc, {
        Url = "https://api.groq.com/openai/v1/chat/completions",
        Method = "POST",
        Headers = {["Content-Type"] = "application/json", ["Authorization"] = "Bearer " .. cfg.groqKey},
        Body = HS:JSONEncode({
            model = "llama-3.3-70b-versatile",
            messages = {
                {role = "system", content = "You are a riddle solver. Reply with ONLY the answer word or short phrase. No punctuation, no quotes, no explanation."},
                {role = "user", content = text}
            },
            temperature = 0.1, max_tokens = 30
        })
    })
    if not ok2 then addRiddleLog("Groq request FAIL: " .. tostring(res)); return nil end
    local body = nil
    if type(res) == "table" then
        local sc2 = res.StatusCode or res.statusCode
        addRiddleLog("Groq HTTP: " .. tostring(sc2 or "?"))
        body = res.Body or res.body
    elseif type(res) == "string" then body = res end
    if not body then addRiddleLog("Groq: empty body"); return nil end
    addRiddleLog("Body len: " .. #body)
    local parsed = nil
    local ok3, pErr = pcall(function() parsed = HS:JSONDecode(body) end)
    if not ok3 then addRiddleLog("Groq JSON fail: " .. tostring(pErr)); return nil end
    if parsed.error then
        addRiddleLog("Groq API err: " .. tostring(parsed.error.message or parsed.error.type or "?"))
        return nil
    end
    if parsed.choices and parsed.choices[1] then
        local content = parsed.choices[1].message and parsed.choices[1].message.content
        if content then
            local ans = content:gsub("^%s+", ""):gsub("%s+$", ""):gsub('^"', ""):gsub('"$', ""):gsub("^'", ""):gsub("'$", "")
            addRiddleLog("Groq answer: " .. ans)
            return ans
        end
    end
    addRiddleLog("Groq: unexpected format"); return nil
end

local function submitRiddleAnswer(answer)
    addRiddleLog("Answer: " .. answer)
    if cfg.riddleCopy1 and setclipboard then pcall(setclipboard, answer); addRiddleLog("Copied") end
    if cfg.riddleCopy2 then
        if pasteToChat(answer) then addRiddleLog("Pasted to chat") else addRiddleLog("Chat not found") end
    end
    if cfg.riddleSubmitV3 then v3SetGreen(); task.delay(10, function() v3SetRed() end) end
end

onAnnouncement = function(text)
    local lower = text:lower()
    local isRiddle = lower:find("riddle") or lower:find("adivin") or lower:find("puzzle")
        or lower:find("what has") or lower:find("what can") or lower:find("what is")
        or lower:find("what gets") or lower:find("what goes") or lower:find("what belongs")
        or lower:find("what occurs") or lower:find("what disappears") or lower:find("guess")
    
    if isRiddle then
        addRiddleLog("--- RIDDLE ---")
        addRiddleLog(text:sub(1, 60))
        task.spawn(function()
            local answer = nil
            answer = solveWorker(text)
            if answer then addRiddleLog("Worker: " .. answer) end
            if not answer then answer = solveGroq(text) end
            if not answer then
                answer = solveLocalDB(text)
                if answer then addRiddleLog("LocalDB: " .. answer) else addRiddleLog("LocalDB: miss") end
            end
            if answer then submitRiddleAnswer(answer)
            else addRiddleLog("FAILED: no answer") end
        end)
    else
        local words = {}
        for word in text:gmatch("%S+") do
            if #word >= 2 and word:match("^[%w_]+$") and not word:match("^%d+$") then
                table.insert(words, word)
            end
        end
        if #words > 0 then
            for _, w in ipairs(words) do appendWord(w) end
        else
            addFeed("Unrecognized: " .. text:sub(1, 30))
        end
    end
end

