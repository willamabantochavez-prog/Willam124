local function createEngine(config,deps,saved)
    saved=saved or {}
    local e={alive=true,enabled=saved.enabled==true,guess=saved.guess==true,partsMode=saved.partsMode==true,amount=tonumber(saved.amount) or config.DefaultParts,parts={},partLength=0,partsRevision=0,seenIds={},seenText={},attempts=saved.attempts or {},redeemed=saved.redeemed or {},epoch=0,pending=nil,scheduled=false,halted=false,status="V2 Auto Redeem Off",autoMode=saved.autoMode==true,autoWaiting=false,autoRiddle=false,partsModeBeforeGuess=saved.partsModeBeforeGuess,manualBeforeAuto=type(saved.manualBeforeAuto)=="table" and{enabled=saved.manualBeforeAuto.enabled==true,guess=saved.manualBeforeAuto.guess==true,partsMode=saved.manualBeforeAuto.partsMode==true,partsModeBeforeGuess=saved.manualBeforeAuto.partsModeBeforeGuess}or nil}
    e.amount=math.clamp(math.floor(e.amount),1,config.MaxParts) if e.guess then e.partsMode=false end
    local pump,sessionJob,responseJob local timers,cacheSizes={},setmetatable({},{__mode="k"}) local nextMaintenance=0
    local function controlText(v) return v:lower():gsub("[%.!,:;%s]+$",""):gsub("%s+"," ") end
    local blacklist={} for _,v in ipairs(config.BlacklistedMessages or{}) do blacklist[controlText(v)]=true end
    local function guessKey(v) return v:gsub("[^A-Za-z0-9]",""):lower() end
    local guessBlacklist={} for _,v in ipairs(config.AutoSubmitBlacklist or{}) do if type(v)=="string" then local k=guessKey(v) if k~="" then guessBlacklist[k]=true end end end
    local function emit(msg) if msg then e.status=msg end deps.changed(e) end
    local function trim(s) return s:match("^%s*(.-)%s*$") end
    local function clean(s) if not s:find("[<&]") then return trim(s) end return trim((s:gsub("<[^>]*>",""):gsub("&lt;","<"):gsub("&gt;",">"):gsub("&quot;",'"'):gsub("&apos;","'"):gsub("&amp;","&"))) end
    local function prune(cache,ttl,now2) local count=0 for key,ts in pairs(cache) do if type(ts)~="number" or now2-ts>ttl then cache[key]=nil else count+=1 end end while count>config.CacheLimit do local oldest,when=nil,math.huge for key,ts in pairs(cache) do if ts<when then oldest,when=key,ts end end if not oldest then break end cache[oldest],count=nil,count-1 end cacheSizes[cache]=count end
    local function maintain(now2) if now2<nextMaintenance then return end nextMaintenance=now2+config.CacheSweepInterval prune(e.seenIds,config.MessageIdTTL,now2) prune(e.seenText,config.DuplicateWindow,now2) prune(e.attempts,config.AttemptTTL,now2) prune(e.redeemed,config.RedeemedTTL,now2) end
    local function cached(cache,key,ttl,now2) local ts=cache[key] return type(ts)=="number" and now2-ts<=ttl end
    local function rememberCache(cache,key,ttl,now2) if cacheSizes[cache]==nil then prune(cache,ttl,now2) end if cache[key]==nil then cacheSizes[cache]=(cacheSizes[cache]or 0)+1 end cache[key]=now2 if cacheSizes[cache]>config.CacheLimit then prune(cache,ttl,now2) end end
    local function cancel(job) if not job then return end timers[job]=nil if deps.cancel then deps.cancel(job) end end
    local function later(seconds,fn) local version=e.epoch local function run() if e.alive and e.epoch==version then fn() end end local job=seconds<=0 and deps.defer(run) or deps.after(seconds,run) if job then timers[job]=true end return job end
    local function cancelTimers() for job in pairs(timers) do cancel(job) end sessionJob,responseJob=nil,nil end
    local function reset(msg,clearTB) e.epoch+=1 cancelTimers() e.parts,e.partLength,e.pending,e.scheduled,e.halted={},0,nil,false,false e.partsRevision+=1 e.lastPartAt,e.lastResponse=nil,nil if clearTB then deps.clearTextbox() end emit(msg) end
    local function classify(message) local s=clean(message):lower() if s:find("please wait",1,true) or s:find("cooldown",1,true) or s:find("too fast",1,true) or s:find("try again later",1,true) then return "rate" end if s:find("invalid code",1,true) or s:find("code is invalid",1,true) then return "invalid" end if s:find("already",1,true) and s:find("redeem",1,true) then return "used" end if s:find("expired",1,true) or s:find("sold out",1,true) then return "terminal" end return "unknown" end
    local function candidate() local count=e.guess and #e.parts or(e.partsMode and e.amount or 1) if count==0 or #e.parts<count then return nil end return table.concat(e.parts,"",1,count),count end
    local function armAutoMode() e.autoMode,e.autoWaiting,e.enabled=true,true,false e.autoRiddle=false reset("Waiting For Sammy's Code...",true) end
    local function manualControl(restore) if restore and e.autoMode and e.manualBeforeAuto then local p=e.manualBeforeAuto e.enabled,e.guess,e.partsMode=p.enabled,p.guess,p.partsMode e.partsModeBeforeGuess=p.partsModeBeforeGuess if e.guess then e.partsMode=false end end e.autoMode,e.autoWaiting=false,false e.autoRiddle=false e.manualBeforeAuto=nil end
    local function queue(seconds) if e.scheduled then return end e.scheduled=true later(seconds,function() e.scheduled=false pump() end) end
    local function discard(count) local remaining,length={},0 for i=count+1,#e.parts do remaining[#remaining+1]=e.parts[i] length+=#e.parts[i] end e.parts,e.partLength=remaining,length e.partsRevision+=1 if #remaining==0 then cancel(sessionJob) sessionJob=nil end end
    local function completedStatus(msg) emit(msg) later(1.4,function() if not e.pending and #e.parts==0 and e.status==msg then emit(e.enabled and "Waiting For Announcement..." or "V2 Auto Redeem Off") end end) end
    local function finish(request,kind,message)
        if not e.alive then return end local now2=deps.now()
        if kind=="success" or kind=="used" then rememberCache(e.redeemed,request.code,config.RedeemedTTL,now2) end
        if e.pending~=request or request.epoch~=e.epoch then return end cancel(responseJob) responseJob=nil e.lastResponse=message
        if kind=="timeout" then request.timedOut=true e.halted=true emit("Game Response Delayed") return end
        e.pending,e.halted=nil,false
        if kind=="rate" then emit("Waiting For Next Part...") if #e.parts>request.count then pump() end return end
        if kind=="unknown" then e.halted=true emit("Game reply unclear") return end
        if e.autoMode and(kind=="success" or kind=="terminal") then armAutoMode() e.lastResponse=message return end
        if e.guess and kind=="used" then emit("Already Redeemed") if #e.parts>request.count then pump() end return end
        if kind=="success" or kind=="used" then discard(request.count) deps.clearTextbox() completedStatus(kind=="success" and "Code Redeemed" or "Already Redeemed") pump()
        elseif e.guess and kind~="terminal" then emit("Waiting For Next Part...") if #e.parts>request.count then pump() end
        elseif kind=="invalid" or kind=="terminal" then discard(request.count) deps.clearTextbox() completedStatus(kind=="invalid" and "Invalid Code" or "Code Expired") pump() end
    end
    pump=function()
        if not e.alive or not e.enabled or e.pending or e.halted or e.autoRiddle then return end
        local code,count=candidate() if not code then return end
        if e.guess and guessBlacklist[guessKey(code)] then emit("Guess Skipped") return end
        if #code>config.MaxCodeLength then emit("Code Too Long") return end
        local now2=deps.now() maintain(now2)
        if cached(e.redeemed,code,config.RedeemedTTL,now2) then if e.guess then emit("Already Redeemed") return end if e.autoMode then armAutoMode() return end discard(count) completedStatus("Already Redeemed") if #e.parts>0 then queue(0) end return end
        if cached(e.attempts,code,config.AttemptTTL,now2) then if e.guess then emit("Waiting For Next Part...") else discard(count) deps.clearTextbox() completedStatus("Already Checked") if #e.parts>0 then queue(0) end end return end
        local ready,reason=deps.ready() if not ready then emit(reason or "Waiting For Code Box") return end
        local request={code=code,count=count,epoch=e.epoch} e.pending=request e.lastSubmitted=code e.submissions=(e.submissions or 0)+1
        rememberCache(e.attempts,code,config.AttemptTTL,now2) emit("Redeeming Code...")
        responseJob=later(config.ResponseTimeout,function() if e.pending==request then finish(request,"timeout","") end end)
        local ok2=pcall(deps.submit,code,function(success,message) finish(request,success and "success" or classify(message or ""),message or "") end)
        if not ok2 then finish(request,"unknown","Submit Failed") end
    end
    function e:receive(message,duration,sound,location,senderId,messageId,remove)
        if not self.alive or self.halted then return false end
        if not self.enabled and not(self.autoMode and self.autoWaiting) then return false end
        if location~="Top" or remove or type(message)~="string" then return false end
        local sender=tonumber(senderId)
        if config.RequireSenderId and sender~=config.SammyUserId then return false end
        if senderId~=nil and sender~=config.SammyUserId then return false end
        local plain=clean(message) local now2=deps.now() maintain(now2)
        local idKey=messageId~=nil and(tostring(senderId)..":"..tostring(messageId)..":"..plain) or nil
        if idKey and cached(self.seenIds,idKey,config.MessageIdTTL,now2) then return false end
        local part local lower=plain:lower()
        local riddleMarker=lower:find("%f[%w_]riddle%f[^%w_]")~=nil
        local a,b=lower:find("%f[%w_]use%s+code%f[^%w_]")
        if not a then a,b=lower:find("%f[%w_]code%s+is%f[^%w_]") end
        if riddleMarker then if self.autoMode and not self:startRiddle() then return false end if idKey then rememberCache(self.seenIds,idKey,config.MessageIdTTL,now2) end return true end
        if self.autoMode and(self.autoWaiting or self.autoRiddle) then
            if not a or self.pending then return false end
            self.autoRiddle,self.autoWaiting=false,false self.enabled,self.guess,self.partsMode=true,true,false self.partsModeBeforeGuess=nil
            reset("Waiting For Code Parts...",true)
        elseif self.autoRiddle then return false end
        if a then part=plain:sub(b+1):match("^%s*[:=]%s*(.+)$") if not part then if idKey then rememberCache(self.seenIds,idKey,config.MessageIdTTL,now2) end return true end end
        if not part and blacklist[controlText(plain)] then return false end
        if not part then
            if config.AcceptBareParts and plain:match("^[A-Za-z0-9]+$") then part=plain
            else local n2,value=plain:match("^[Pp][Aa][Rr][Tt]%s*(%d+)%s*:%s*(.+)$") if n2 then part=value end part=part or plain:match("^[Cc][Oo][Dd][Ee]%s*:%s*(.+)$") if not part and config.AcceptBareParts and config.AcceptSentenceParts~=false then part=plain end end
        end
        if type(part)~="string" then return false end
        if not part:match("^[A-Za-z0-9]+$") then part=part:gsub("[^A-Za-z0-9]","") end
        if #part<config.MinPartLength then return false end
        if #self.parts>=config.MaxParts then self.halted=true emit("Too Many Parts") return false end
        if idKey then rememberCache(self.seenIds,idKey,config.MessageIdTTL,now2) end
        self.parts[#self.parts+1]=part self.partLength+=#part self.partsRevision+=1 self.lastPartAt=now2
        emit("Part "..#self.parts.." Detected") cancel(sessionJob) sessionJob=nil
        if not self.guess and(not self.partsMode or #self.parts>=self.amount) then pump() else queue(0) end
        if #self.parts>0 then sessionJob=later(config.SessionTimeout,function() if self.pending then return end if #self.parts>0 then if self.autoMode then armAutoMode() else reset("Waiting For Announcement...",true) end end end) end
        return true
    end
    function e:startRiddle() if not self.autoMode or self.pending or self.halted then return false end if self.autoRiddle then return true end self.autoWaiting,self.autoRiddle,self.enabled=false,true,true self.guess,self.partsMode,self.partsModeBeforeGuess=true,false,nil reset("Waiting For Riddle Questions...",true) return true end
    function e:finishRiddle(result) if not self.autoMode or not self.autoRiddle then return end if result=="success" or result=="unavailable" or result=="used" then armAutoMode() end end
    function e:setEnabled(v) manualControl(true) self.enabled=v==true self:clear() end
    function e:setGuess(v) if self.autoMode then manualControl(true) end local ng=v==true if ng and not self.guess then self.partsModeBeforeGuess=self.partsMode self.partsMode=false elseif not ng and self.guess then self.partsMode=self.partsModeBeforeGuess==true end self.guess=ng self:clear() end
    function e:setPartsMode(v) if self.autoMode then manualControl(true) end self.partsMode=v==true if self.partsMode then self.guess=false end self.partsModeBeforeGuess=nil self:clear() end
    function e:setAmount(v) self.amount=math.clamp(math.floor(v),1,config.MaxParts) self:clear() end
    function e:setAutoMode(v) if v==true then if not self.autoMode then self.manualBeforeAuto={enabled=self.enabled,guess=self.guess,partsMode=self.partsMode,partsModeBeforeGuess=self.partsModeBeforeGuess} end armAutoMode() else manualControl(true) self:clear() end end
    function e:clear(retry) if retry then self.attempts,self.seenIds,self.seenText={},{},{} nextMaintenance=0 end if self.autoMode then armAutoMode() else reset(self.enabled and "Waiting For Announcement..." or "V2 Auto Redeem Off",true) end end
    function e:wake() pump() end
    function e:stop() self.alive=false self.epoch+=1 self.enabled=false cancelTimers() end
