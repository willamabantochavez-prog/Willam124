local function createFPSController(onChanged)
    local f={enabled=false,busy=false,changedProperties=0,textures=0,stoppedTracks=0}
    local records,touched,connections,watchedAnimators={},{},{},{}
    local watchedProperties,stoppedTracks={},{} local worker,generation=nil,0
    local function notify() if onChanged then onChanged(f) end end
    local function change(obj,prop,val) local ok2,old=pcall(function() return obj[prop] end) if not ok2 or old==val then return false end local keys=touched[obj] if not keys then keys={} touched[obj]=keys end local suc=pcall(function() obj[prop]=val end) if not suc then return false end local rec=keys[prop] if not rec then rec={object=obj,property=prop,old=old,applied=val} keys[prop]=rec records[#records+1]=rec f.changedProperties+=1 else rec.old,rec.applied=old,val end return true end
    local function enforceProperty(obj,prop,val,isTex) local props=watchedProperties[obj] if not props then props={} watchedProperties[obj]=props end if not props[prop] then local ver,writing=generation,false local ok2,conn=pcall(function() return obj:GetPropertyChangedSignal(prop):Connect(function() if not f.enabled or generation~=ver or writing then return end writing=true if change(obj,prop,val) and isTex then f.textures+=1 end writing=false end) end) if ok2 then props[prop]=conn connections[#connections+1]=conn end end if change(obj,prop,val) and isTex then f.textures+=1 end end
    local function disconnectAll() for _,c in ipairs(connections) do c:Disconnect() end connections={} end
    local function apply(obj) if not f.enabled then return end
        if obj:IsA("BasePart") and not obj:IsA("Terrain") then if obj.Material~=Enum.Material.SmoothPlastic then change(obj,"CustomPhysicalProperties",obj.CurrentPhysicalProperties) change(obj,"Material",Enum.Material.SmoothPlastic) end enforceProperty(obj,"MaterialVariant","") change(obj,"Reflectance",0) change(obj,"CastShadow",false) if obj:IsA("MeshPart") then enforceProperty(obj,"TextureID","",true) end if obj:IsA("UnionOperation") then change(obj,"UsePartColor",true) end
        elseif obj:IsA("SurfaceAppearance") or obj:IsA("Decal") or obj:IsA("Texture") then if change(obj,"Parent",nil) then f.textures+=1 end
        elseif obj:IsA("FileMesh") then enforceProperty(obj,"TextureId","",true)
        elseif obj:IsA("Shirt") then enforceProperty(obj,"ShirtTemplate","",true)
        elseif obj:IsA("Pants") then enforceProperty(obj,"PantsTemplate","",true)
        elseif obj:IsA("ShirtGraphic") then enforceProperty(obj,"Graphic","",true)
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") or obj:IsA("Light") or obj:IsA("PostEffect") or obj:IsA("Highlight") then enforceProperty(obj,"Enabled",false) if obj:IsA("ParticleEmitter") then pcall(obj.Clear,obj) end
        elseif obj:IsA("Explosion") then enforceProperty(obj,"Visible",false)
        elseif obj:IsA("Sky") or obj:IsA("Atmosphere") or obj:IsA("Clouds") then change(obj,"Parent",nil)
        elseif obj:IsA("Animator") and not watchedAnimators[obj] then watchedAnimators[obj]=true local ver=generation connections[#connections+1]=obj.AnimationPlayed:Connect(function(track) if generation==ver and f.enabled then pcall(track.Stop,track,0) end end) pcall(function() for _,track in ipairs(obj:GetPlayingAnimationTracks()) do pcall(track.Stop,track,0) end end) end
    end
    local sel="BasePart,SurfaceAppearance,Decal,Texture,FileMesh,Shirt,Pants,ShirtGraphic,ParticleEmitter,Trail,Beam,Smoke,Fire,Sparkles,Light,PostEffect,Highlight,Explosion,Sky,Atmosphere,Clouds,Animator"
    function f:setEnabled(v) v=v==true if v==self.enabled then return end generation+=1 local ver=generation self.enabled,self.busy=v,false if worker then pcall(task.cancel,worker) worker=nil end disconnectAll()
        if not v then for i=#records,1,-1 do local r=records[i] pcall(function() if r.property=="Parent" and r.old and r.old.Parent==nil then return end if r.object[r.property]==r.applied then r.object[r.property]=r.old end end) end records,touched,watchedAnimators,watchedProperties,stoppedTracks={},{},{},{},{} if self.renderSettings and self.prevQuality then pcall(function() if self.renderSettings.QualityLevel==Enum.QualityLevel.Level01 then self.renderSettings.QualityLevel=self.prevQuality end end) end self.renderSettings,self.prevQuality=nil,nil notify() return end
        self.changedProperties,self.textures,self.stoppedTracks=0,0,0 self.busy=true
        change(Lighting,"GlobalShadows",false) change(Lighting,"EnvironmentDiffuseScale",0) change(Lighting,"EnvironmentSpecularScale",0) change(WS.Terrain,"WaterWaveSize",0) change(WS.Terrain,"WaterWaveSpeed",0) change(WS.Terrain,"WaterReflectance",0) change(WS.Terrain,"Decoration",false)
        local qOk,rendering=pcall(function() return settings().Rendering end) if qOk then pcall(function() self.prevQuality=rendering.QualityLevel rendering.QualityLevel=Enum.QualityLevel.Level01 end) self.renderSettings=rendering end
        connections[#connections+1]=WS.DescendantAdded:Connect(apply) connections[#connections+1]=Lighting.DescendantAdded:Connect(apply) notify()
        worker=task.defer(function() local objs=WS:QueryDescendants(sel) local lo=Lighting:QueryDescendants(sel) for _,o in ipairs(lo) do objs[#objs+1]=o end for i,obj in ipairs(objs) do if not self.enabled or generation~=ver then return end apply(obj) if i%180==0 then task.wait() end end if self.enabled and generation==ver then self.busy,worker=false,nil notify() end end)
    end
    function f:stop() self:setEnabled(false) end return f
end

