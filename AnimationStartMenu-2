-- ===== FUNCIÓN BARRA ALEATORIA =====
local function generateRandomProgress(numFrames, startPct, endPct)
    local points = {}
    local totalRange = endPct - startPct
    local increments = {}
    local sum = 0
    for i = 1, numFrames do
        local val = math.random()
        increments[i] = val
        sum = sum + val
    end
    local current = startPct
    for i = 1, numFrames do
        current = current + (increments[i] / sum) * totalRange
        if i == numFrames then
            points[i] = endPct
        else
            points[i] = math.min(math.max(current, (points[i-1] or startPct) + 0.5), endPct - 0.5)
        end
    end
    return points
end

