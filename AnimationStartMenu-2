img2.Parent = screenGui

-- Configuración
local fps = 10
local frameDelay = 1 / fps
local frontIsImg1 = true

-- Loop sin loop - una sola pasada
for i = 2, #frames do
    task.wait(frameDelay)
    
    local nextAsset = "rbxassetid://" .. frames[i]
    
    if frontIsImg1 then
        -- img1 está adelante, preparar img2 detrás
        img2.Image = nextAsset
        img2.ZIndex = 6  -- traer adelante
        img1.ZIndex = 5  -- enviar atrás
    else
        -- img2 está adelante, preparar img1 detrás
        img1.Image = nextAsset
        img1.ZIndex = 6  -- traer adelante
        img2.ZIndex = 5  -- enviar atrás
    end
    
    frontIsImg1 = not frontIsImg1
end

