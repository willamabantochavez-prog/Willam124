local function executeScript(url)
    if url == "" or url == nil then return warn("⚠️ No hay script") end
    local s, e = pcall(function() loadstring(game:HttpGet(url))() end)
    if s then print("✅ OK") else warn("❌ " .. tostring(e)) end
end

local function createButton(data, index)
    local delay = 0.1 + (index * 0.15)
    local btn = Instance.new("TextButton")
    btn.Name = data.key .. "Btn"
    btn.Size = UDim2.new(0, 0, 0, 0)
    btn.BackgroundColor3 = C.DarkGray
    btn.BackgroundTransparency = 0.15
    btn.BorderSizePixel = 0
    btn.Text = ""
    btn.ZIndex = 6
    btn.AutoButtonColor = false
    btn.LayoutOrder = index
    btn.Parent = scrollFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = C.DarkBlack
    stroke.Thickness = 1
    stroke.Parent = btn
    
    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(0, 2, 0.6, 0)
    bar.Position = UDim2.new(0, 5, 0.2, 0)
    bar.BackgroundColor3 = data.active and C.Yellow or C.DarkGray
    bar.BackgroundTransparency = data.active and 0 or 0.5
    bar.BorderSizePixel = 0
    bar.ZIndex = 7
    bar.Parent = btn
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -40, 1, 0)
    lbl.Position = UDim2.new(0, 14, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = data.text
    lbl.TextColor3 = data.active and C.White or C.Gray
    lbl.TextSize = 11
    lbl.Font = Enum.Font.GothamSemibold
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 7
    lbl.Parent = btn
    
    local icon = Instance.new("TextLabel")
    icon.Size = UDim2.new(0, 20, 1, 0)
    icon.Position = UDim2.new(1, -24, 0, 0)
    icon.BackgroundTransparency = 1
    icon.Text = data.active and "›" or "•"
    icon.TextColor3 = data.active and C.Yellow or C.Gray
    icon.TextSize = data.active and 16 or 12
    icon.Font = Enum.Font.GothamBold
    icon.ZIndex = 7
    icon.Parent = btn
    
    task.spawn(function()
        task.wait(delay)
        TweenService:Create(btn, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = UDim2.new(1, -8, 0, 32)
        }):Play()
    end)
    
    if data.active then
        btn.MouseEnter:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(55, 55, 55)}):Play()
            TweenService:Create(stroke, TweenInfo.new(0.2), {Color = C.Yellow, Thickness = 1.5}):Play()
            TweenService:Create(bar, TweenInfo.new(0.2), {BackgroundColor3 = C.BrightYellow}):Play()
        end)
        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = C.DarkGray}):Play()
            TweenService:Create(stroke, TweenInfo.new(0.2), {Color = C.DarkBlack, Thickness = 1}):Play()
            TweenService:Create(bar, TweenInfo.new(0.2), {BackgroundColor3 = C.Yellow}):Play()
        end)
        btn.MouseButton1Down:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.08), {Size = UDim2.new(1, -10, 0, 30)}):Play()
        end)
        btn.MouseButton1Up:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.08), {Size = UDim2.new(1, -8, 0, 32)}):Play()
        end)
        btn.MouseButton1Click:Connect(function()
            icon.Text = "◌"
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(60, 60, 60)}):Play()
            task.wait(0.3)
            executeScript(SCRIPTS[data.key])
            task.wait(0.5)
            icon.Text = "✓"
            TweenService:Create(btn, TweenInfo.new(0.3), {BackgroundColor3 = C.DarkGray}):Play()
            task.wait(1)
            icon.Text = "›"
        end)
    else
        btn.MouseButton1Click:Connect(function()
            for i = 1, 3 do
                TweenService:Create(btn, TweenInfo.new(0.05), {Position = UDim2.new(0, 3, 0, 0)}):Play()
                task.wait(0.05)
                TweenService:Create(btn, TweenInfo.new(0.05), {Position = UDim2.new(0, -3, 0, 0)}):Play()
                task.wait(0.05)
            end
            TweenService:Create(btn, TweenInfo.new(0.05), {Position = UDim2.new(0, 0, 0, 0)}):Play()
        end)
    end
    return btn
end

