local function createButton(name, text, positionY, isActive, scriptUrl, delay)
    local button = Instance.new("TextButton")
    button.Name = name
    button.Size = UDim2.new(0, 0, 0, 0)
    button.Position = UDim2.new(0.5, 0, 0, positionY + 10)
    button.AnchorPoint = Vector2.new(0.5, 0)
    button.BackgroundColor3 = COLORS.DarkGray
    button.BackgroundTransparency = 0.15
    button.BorderSizePixel = 0
    button.Text = ""
    button.ZIndex = 6
    button.AutoButtonColor = false
    button.Parent = mainFrame
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 10)
    btnCorner.Parent = button
    
    -- BORDE NEGRO BOTÓN
    local btnStroke = Instance.new("UIStroke")
    btnStroke.Color = COLORS.DarkBlack
    btnStroke.Thickness = 1.5
    btnStroke.Transparency = 0
    btnStroke.Parent = button
    
    -- Indicador lateral amarillo
    local accentBar = Instance.new("Frame")
    accentBar.Name = "AccentBar"
    accentBar.Size = UDim2.new(0, 3, 0.6, 0)
    accentBar.Position = UDim2.new(0, 6, 0.2, 0)
    accentBar.BackgroundColor3 = isActive and COLORS.Yellow or COLORS.DarkGray
    accentBar.BackgroundTransparency = isActive and 0 or 0.5
    accentBar.BorderSizePixel = 0
    accentBar.ZIndex = 7
    accentBar.Parent = button
    
    local barCorner = Instance.new("UICorner")
    barCorner.CornerRadius = UDim.new(1, 0)
    barCorner.Parent = accentBar
    
    -- Texto
    local btnLabel = Instance.new("TextLabel")
    btnLabel.Name = "BtnLabel"
    btnLabel.Size = UDim2.new(1, -50, 1, 0)
    btnLabel.Position = UDim2.new(0, 18, 0, 0)
    btnLabel.BackgroundTransparency = 1
    btnLabel.Text = text
    btnLabel.TextColor3 = isActive and COLORS.White or COLORS.Gray
    btnLabel.TextSize = 13
    btnLabel.Font = Enum.Font.GothamSemibold
    btnLabel.TextXAlignment = Enum.TextXAlignment.Left
    btnLabel.ZIndex = 7
    btnLabel.Parent = button
    
    -- Icono
    local iconLabel = Instance.new("TextLabel")
    iconLabel.Name = "Icon"
    iconLabel.Size = UDim2.new(0, 25, 1, 0)
    iconLabel.Position = UDim2.new(1, -30, 0, 0)
    iconLabel.BackgroundTransparency = 1
    iconLabel.Text = isActive and "›" or "•"
    iconLabel.TextColor3 = isActive and COLORS.Yellow or COLORS.Gray
    iconLabel.TextSize = isActive and 20 or 14
    iconLabel.Font = Enum.Font.GothamBold
    iconLabel.ZIndex = 7
    iconLabel.Parent = button
    
    -- ENTRADA
    task.spawn(function()
        task.wait(delay)
        TweenService:Create(button, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = UDim2.new(1, -20, 0, 40),
            Position = UDim2.new(0.5, 0, 0, positionY),
        }):Play()
    end)
    
    -- HOVER
    button.MouseEnter:Connect(function()
        if isActive then
            TweenService:Create(button, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(55, 55, 55),
            }):Play()
            TweenService:Create(btnStroke, TweenInfo.new(0.2), {
                Color = COLORS.Yellow,
                Thickness = 2,
            }):Play()
            TweenService:Create(accentBar, TweenInfo.new(0.2), {
                BackgroundColor3 = COLORS.BrightYellow,
            }):Play()
        end
    end)
    
    button.MouseLeave:Connect(function()
        if isActive then
            TweenService:Create(button, TweenInfo.new(0.2), {
                BackgroundColor3 = COLORS.DarkGray,
            }):Play()
            TweenService:Create(btnStroke, TweenInfo.new(0.2), {
                Color = COLORS.DarkBlack,
                Thickness = 1.5,
            }):Play()
            TweenService:Create(accentBar, TweenInfo.new(0.2), {
                BackgroundColor3 = COLORS.Yellow,
            }):Play()
        end
    end)
    
    -- CLIC
    button.MouseButton1Down:Connect(function()
        if isActive then
            TweenService:Create(button, TweenInfo.new(0.08), {
                Size = UDim2.new(1, -22, 0, 38),
            }):Play()
        end
    end)
    
    button.MouseButton1Up:Connect(function()
        if isActive then
            TweenService:Create(button, TweenInfo.new(0.08), {
                Size = UDim2.new(1, -20, 0, 40),
            }):Play()
        end
    end)
    
    -- EJECUTAR
    button.MouseButton1Click:Connect(function()
        if isActive then
            iconLabel.Text = "◌"
            TweenService:Create(button, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(60, 60, 60),
            }):Play()
            TweenService:Create(accentBar, TweenInfo.new(0.2), {
                BackgroundColor3 = COLORS.BrightYellow,
            }):Play()
            
            task.wait(0.3)
            executeScript(scriptUrl)
            
            task.wait(0.5)
            iconLabel.Text = "✓"
            TweenService:Create(button, TweenInfo.new(0.3), {
                BackgroundColor3 = COLORS.DarkGray,
            }):Play()
            
            task.wait(1)
            iconLabel.Text = "›"
        else
            for i = 1, 3 do
                TweenService:Create(button, TweenInfo.new(0.05), {
                    Position = UDim2.new(0.5, 4, 0, positionY),
                }):Play()
                task.wait(0.05)
                TweenService:Create(button, TweenInfo.new(0.05), {
                    Position = UDim2.new(0.5, -4, 0, positionY),
                }):Play()
                task.wait(0.05)
            end
            TweenService:Create(button, TweenInfo.new(0.05), {
                Position = UDim2.new(0.5, 0, 0, positionY),
            }):Play()
        end
    end)
    
    return button
end

