local function safeLoad(url, label)
    local ok, err = pcall(function()
        local raw = game:HttpGet(url)
        if not raw or raw == "" then
            warn("[LOADER] ❌ Respuesta vacía: " .. tostring(label))
            return
        end
        local fn, loadErr = loadstring(raw)
        if not fn then
            warn("[LOADER] ❌ Error en loadstring (" .. tostring(label) .. "): " .. tostring(loadErr))
            return
        end
        fn()
        print("[LOADER] ✅ Ejecutado: " .. tostring(label))
    end)
    if not ok then
        warn("[LOADER] ❌ Falló: " .. tostring(label) .. " — " .. tostring(err))
    end
end

