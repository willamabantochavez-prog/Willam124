    img.Position = UDim2.new(0, -6, 0, -6)
    img.ZIndex = parent.ZIndex - 1
    img.Parent = parent
    return img
end

local function tweenColor(obj, color, duration)
    TweenService:Create(obj, TweenInfo.new(duration or 0.2, Enum.EasingStyle.Quint), {BackgroundColor3 = color}):Play()
end

local function tweenStrokeColor(obj, color, duration)
    TweenService:Create(obj, TweenInfo.new(duration or 0.2, Enum.EasingStyle.Quint), {Color = color}):Play()
end

local function setupHover(btn, normalColor, hoverColor, strokeObj, normalStroke, hoverStroke)
    btn.MouseEnter:Connect(function()
        tweenColor(btn, hoverColor, 0.2)
        if strokeObj then tweenStrokeColor(strokeObj, hoverStroke or ECLIPSE.glow, 0.2) end
    end)
    btn.MouseLeave:Connect(function()
        tweenColor(btn, normalColor, 0.2)
        if strokeObj then tweenStrokeColor(strokeObj, normalStroke or ECLIPSE.border, 0.2) end
    end)
end

local function animateEntry(frame, delay)
    local origPos = frame.Position
    frame.Position = UDim2.new(origPos.X.Scale, origPos.X.Offset, origPos.Y.Scale, origPos.Y.Offset + 15)
    frame.BackgroundTransparency = 1
    task.delay(delay or 0, function()
        TweenService:Create(frame, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Position = origPos,
            BackgroundTransparency = 0
        }):Play()
    end)
end

