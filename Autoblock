-- ==================== CORE BLOCKING ENGINE ====================
local function fastClick()
    task.wait(BLOCK_DELAY)
    local cam = workspace.CurrentCamera
    if not cam then return end
    local viewport = cam.ViewportSize
    local x = viewport.X / 2
    local y = (viewport.Y / 2) + 23

    for _ = 1, 8 do
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
        task.wait(0.008)
    end
end

local function blockPlayer(plr)
    if not plr or plr == player or not plr.Parent then return end
    pcall(function()
        StarterGui:SetCore("PromptBlockPlayer", plr)
        fastClick()
    end)
end

local function blockAllPlayers()
    local playersToBlock = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            table.insert(playersToBlock, p)
        end
    end
    for _, p in ipairs(playersToBlock) do
        blockPlayer(p)
        task.wait(BLOCK_ALL_COOLDOWN)
    end
end

-- ==================== AUTO-BLOCK FOR "BRAINROT" ITEMS ====================
local function hasBrainrotItem(plr)
    local char = plr.Character
    if not char then return false end
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") then
            local name = item.Name:lower()
            if name:find("animal") or name:find("monkey") or name:find("brainrot") or name:find("banana") then
                return true
            end
        end
    end
    return false
end

-- ==================== VISUAL HELPERS ====================
local function addCorner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 10)
    c.Parent = parent
    return c
end

local function addStroke(parent, thickness, color, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or ECLIPSE.border
    s.Thickness = thickness or 1.5
    s.Transparency = transparency or 0.2
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

local function addGlow(parent, color)
    local s = Instance.new("UIStroke")
    s.Color = color or ECLIPSE.glow
    s.Thickness = 2
    s.Transparency = 0.55
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

local function addShadow(parent)
    local img = Instance.new("ImageLabel")
    img.Name = "Shadow"
    img.BackgroundTransparency = 1
    img.Image = "rbxassetid://1316045217"
    img.ImageColor3 = Color3.new(0, 0, 0)
