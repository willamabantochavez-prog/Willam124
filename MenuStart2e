-- =============================================================
-- FUNCIÓN: EJECUTAR SCRIPT (START)
-- =============================================================
local function runScript(name)
    local url = scriptURLs[name]
    if not url then return end

    local guisBefore = {}
    for _, g in ipairs(playerGui:GetChildren()) do
        guisBefore[g] = true
    end
    scriptEnvs[name] = guisBefore

    scriptThreads[name] = task.spawn(function()
        local ok, err = pcall(function()
            local scriptCode = game:HttpGet(url)
            if scriptCode and scriptCode ~= "" then
                local func = loadstring(scriptCode)
                if func then
                    func()
                else
                    warn("[Hub] Error compilando: " .. name)
                end
            end
        end)
        if not ok then
            warn("[Hub] Error en " .. name .. ": " .. tostring(err))
        end
    end)

    print("[Hub] ✅ " .. name .. " INICIADO")
end

-- =============================================================
-- FUNCIÓN: DETENER SCRIPT (STOP)
-- =============================================================
local function stopScript(name)
    local guisBefore = scriptEnvs[name]

    if guisBefore then
        for _, g in ipairs(playerGui:GetChildren()) do
            if not guisBefore[g] and g.Name ~= "RobloxHub" then
                pcall(function() g:Destroy() end)
            end
        end
    end

    if scriptThreads[name] then
        scriptThreads[name] = nil
    end

    scriptEnvs[name] = nil
    print("[Hub] ❌ " .. name .. " DETENIDO")
end

