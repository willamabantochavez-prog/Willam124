    local function squareOrbitPos(angle, dist, cx, cy)
        local a = ((angle % (math.pi * 2)) + math.pi * 2) % (math.pi * 2)
        local side = math.floor(a / (math.pi / 2))
        local t = (a % (math.pi / 2)) / (math.pi / 2)
 
        local px, py = cx, cy
        if side == 0 then
            px = cx - dist + t * dist * 2
            py = cy - dist
        elseif side == 1 then
            px = cx + dist
            py = cy - dist + t * dist * 2
        elseif side == 2 then
            px = cx + dist - t * dist * 2
            py = cy + dist
        else
            px = cx - dist
            py = cy + dist - t * dist * 2
        end
 
        return px, py
    end
 
    local function makeSquareOrbitDot(startAngle, dist, dotSize, spd)
        local dot = Instance.new("Frame")
        dot.Size = UDim2.new(0, dotSize, 0, dotSize)
        dot.BackgroundColor3 = COLORS.OrangeBright
        dot.BackgroundTransparency = 0.3
        dot.BorderSizePixel = 0
