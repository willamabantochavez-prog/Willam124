            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(0.3, 1 - alpha * 0.4),
            NumberSequenceKeypoint.new(1, 1 - alpha * 0.1),
        })
        tGrad.Rotation = 180
        tGrad.Parent = tail

        return {
            dot = star, glow = starGlow, tail = tail,
            x = startX, y = startY, speed = speed, drift = drift,
