        dgCorner.CornerRadius = UDim.new(0, 3)
        dgCorner.Parent = dotGlow

        local cx, cy = LOGO_SIZE / 2, LOGO_SIZE / 2
        local a = startAngle

        table.insert(hubConnections, RunService.Heartbeat:Connect(function(dt)
            a += dt * spd
            local px, py = squareOrbitPos(a, dist, cx, cy)
            dot.Position = UDim2.new(0, px - dotSize / 2, 0, py - dotSize / 2)
        end))

        local gA = TweenService:Create(dotGlow, TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {BackgroundTransparency = 0.85})
        local gB = TweenService:Create(dotGlow, TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {BackgroundTransparency = 0.5})
        gA.Completed:Connect(function() gB:Play() end)
