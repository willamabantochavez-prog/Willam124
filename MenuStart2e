    local function squareOrbitPos(angle, dist, cx, cy)
        local a = ((angle % (math.pi * 2)) + math.pi * 2) % (math.pi * 2)
        local side = math.floor(a / (math.pi / 2))
        local t = (a % (math.pi / 2)) / (math.pi / 2)

        local px, py = cx, cy
        if side == 0 then
            px = cx - dist + t * dist * 2
            py = cy - dist
        elseif side == 1 then
            px = cx + dist
            py = cy - dist + t * dist * 2
        elseif side == 2 then
            px = cx + dist - t * dist * 2
            py = cy + dist
        else
            px = cx - dist
            py = cy + dist - t * dist * 2
        end

        return px, py
    end

