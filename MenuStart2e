        local size = math.random(2, 4)
        local speed = math.random(50, 140)
        local drift = math.random(-15, 15)
        local startX = math.random(0, BAR_WIDTH)
        local startY = math.random(-20, 0)
        local tailLen = math.random(6, 20)
        local alpha = math.random(40, 85) / 100
 
        star.Size = UDim2.new(0, size, 0, size)
        star.Position = UDim2.new(0, startX, 0, startY)
        star.BackgroundTransparency = 1 - alpha
 
        starGlow.Size = UDim2.new(0, size * 3, 0, size * 3)
        starGlow.Position = UDim2.new(0, startX - size, 0, startY - size)
        starGlow.BackgroundTransparency = 1 - (alpha * 0.3)
 
        local tail = Instance.new("Frame")
        tail.BackgroundColor3 = star.BackgroundColor3
        tail.BorderSizePixel = 0
        tail.ZIndex = 1
        tail.Size = UDim2.new(0, size, 0, tailLen)
        tail.Position = UDim2.new(0, startX, 0, startY - tailLen)
        tail.BackgroundTransparency = 1
        tail.Parent = starsLayer
 
        local tCorner = Instance.new("UICorner")
        tCorner.CornerRadius = UDim.new(1, 0)
        tCorner.Parent = tail
 
        local tGrad = Instance.new("UIGradient")
        tGrad.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(0.3, 1 - alpha * 0.4),
            NumberSequenceKeypoint.new(1, 1 - alpha * 0.1),
        })
        tGrad.Rotation = 180
        tGrad.Parent = tail
 
        return {
            dot = star, glow = starGlow, tail = tail,
            x = startX, y = startY, speed = speed, drift = drift,
            size = size, alpha = alpha, tailLen = tailLen, alive = true,
        }
