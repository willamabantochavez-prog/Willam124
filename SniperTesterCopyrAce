-- ============================================================
-- HELPER FUNCTIONS
-- ============================================================
local function createCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius)
    corner.Parent = parent
    return corner
end

local function createStroke(parent, color, thickness, transparency)
    local stroke = Instance.new("UIStroke")
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Color = color
    stroke.Thickness = thickness or 1
    stroke.Transparency = transparency or 0
    stroke.Parent = parent
    return stroke
end

local function createLabel(parent, text, position, size, textSize, color, font, alignment)
    local label = Instance.new("TextLabel")
    label.Size = size or UDim2.fromOffset(100, 20)
    label.Position = position or UDim2.fromOffset(0, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextSize = textSize or 14
    label.TextColor3 = color or COLORS.Text
    label.Font = font or Enum.Font.GothamMedium
    label.TextXAlignment = alignment or Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.Parent = parent
    return label
end

local function createToggleButton(parent, position, size, isOn, onToggle)
    -- Toggle background (pill shape)
    local toggleBg = Instance.new("TextButton")
    toggleBg.Size = size or UDim2.fromOffset(75, 42)
    toggleBg.Position = position or UDim2.fromOffset(0, 0)
    toggleBg.BackgroundColor3 = isOn and COLORS.Accent or COLORS.Control
    toggleBg.BorderSizePixel = 0
    toggleBg.AutoButtonColor = false
    toggleBg.Text = ""
    toggleBg.Parent = parent
    createCorner(toggleBg, DIMENSIONS.SettingsToggle.CornerRadius)
    createStroke(toggleBg, isOn and COLORS.Accent or COLORS.Border, 1, 
                 isOn and TRANSPARENCY.ToggleStrokeOn or TRANSPARENCY.ToggleStrokeOff)
    
    -- Toggle knob (circle)
    local knobSize = 34
    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(knobSize, knobSize)
    knob.Position = isOn and UDim2.new(1, -(knobSize + 4), 0.5, -(knobSize/2)) 
                             or UDim2.fromOffset(4, 0)
    knob.AnchorPoint = isOn and Vector2.new(0, 0) or Vector2.new(0, 0.5)
    knob.Position = isOn and UDim2.new(1, -(knobSize + 4), 0.5, -(knobSize/2))
                          or UDim2.new(0, 4, 0.5, -(knobSize/2))
    knob.BackgroundColor3 = COLORS.Window
    knob.Parent = toggleBg
    createCorner(knob, knobSize/2)
    
    -- State tracking
    local currentState = isOn
    
    -- Toggle function
    local function toggle()
        currentState = not currentState
        
        local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        
        -- Animate background
        TweenService:Create(toggleBg, tweenInfo, {
            BackgroundColor3 = currentState and COLORS.Accent or COLORS.Control
        }):Play()
        
        -- Animate knob position
        TweenService:Create(knob, tweenInfo, {
            Position = currentState and UDim2.new(1, -(knobSize + 4), 0.5, -(knobSize/2))
                                     or UDim2.new(0, 4, 0.5, -(knobSize/2))
        }):Play()
        
        -- Update stroke
        local stroke = toggleBg:FindFirstChildOfClass("UIStroke")
        if stroke then
            stroke.Color = currentState and COLORS.Accent or COLORS.Border
            stroke.Transparency = currentState and TRANSPARENCY.ToggleStrokeOn or TRANSPARENCY.ToggleStrokeOff
        end
        
        if onToggle then
            onToggle(currentState)
        end
    end
    
    toggleBg.MouseButton1Click:Connect(toggle)
    
    return toggleBg, function() return currentState end
end

