    if _anchorConn then _anchorConn:Disconnect();_anchorConn=nil end
    if _anchorRespawn then _anchorRespawn:Disconnect();_anchorRespawn=nil end
    if st then
        local ch=player.Character;if not ch then return end
        local r=ch:FindFirstChild("HumanoidRootPart");if not r then return end
        _anchorPos=r.CFrame
