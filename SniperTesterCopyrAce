local savedL={}
local function doAntiLag(st)
    if st then
        savedL={GS=Lighting.GlobalShadows,Q=settings().Rendering.QualityLevel}
        pcall(function()
            Lighting.GlobalShadows=false;Lighting.FogEnd=100000
            settings().Rendering.QualityLevel=Enum.QualityLevel.Level01
            for _,d in ipairs(workspace:GetDescendants()) do
                if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") then d.Enabled=false end
            end
        end)
        if ConsoleOut then appendStatus("Anti Lag",true) end
    else
        pcall(function()
            if savedL.GS~=nil then Lighting.GlobalShadows=savedL.GS end
            if savedL.Q then settings().Rendering.QualityLevel=savedL.Q end
            for _,d in ipairs(workspace:GetDescendants()) do
                if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") then d.Enabled=true end
            end
        end)
        if ConsoleOut then appendStatus("Anti Lag",false) end
    end
end

