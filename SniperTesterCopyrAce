local function mkToggle(par,onState,cName,cb)
    par.Active=true
    local b=Instance.new("TextButton");b.Size=UDim2.fromOffset(42,20);b.Position=UDim2.new(1,-50,0.5,-10)
    b.BackgroundColor3=onState and COL.A or COL.C;b.BorderSizePixel=0;b.AutoButtonColor=false
    b.Text=onState and "ON" or "OFF";b.TextSize=8;b.TextColor3=onState and COL.TT or COL.D
    b.Font=Enum.Font.GothamBold;b.ZIndex=8;b.Parent=par;corner(b,6)
    local os=stroke(b,onState and COL.A or COL.B,1,onState and 0.5 or 0.7)
    local isOn=function() return b.Text=="ON" end
    table.insert(TH.toggles,{b=b,on=isOn});table.insert(TH.tStrokes,{s=os,on=isOn})
    local lt=0
    local function tog()
        if tick()-lt<0.15 then return end;lt=tick()
        local ns=b.Text~="ON"
        b.Text=ns and "ON" or "OFF"
        local t=THEMES[_bg] or THEMES[1]
        b.BackgroundColor3=ns and t.A or t.C;b.TextColor3=ns and t.TT or t.D
        os.Color=ns and t.A or t.B;os.Transparency=ns and 0.5 or 0.7
        if _on then appendStatus(cName,ns) end
        if cb then cb(ns) end
    end
    b.MouseButton1Click:Connect(tog)
    return b
end

