            if not _anchorOn or not _anchorPos then return end
            local c=player.Character;if not c then return end
            local hr=c:FindFirstChild("HumanoidRootPart");if not hr then return end
            if (hr.Position-_anchorPos.Position).Magnitude>2 then hr.CFrame=_anchorPos end
            pcall(function() hr.AssemblyLinearVelocity=Vector3.zero end)
        end)
        _anchorRespawn=player.CharacterAdded:Connect(function(nc)
            if not _anchorOn or not _anchorPos then return end
            task.wait(1.5)
            local nr=nc:WaitForChild("HumanoidRootPart",5)
            if nr then nr.CFrame=_anchorPos end
        end)
        if ConsoleOut then appendStatus("Anchor",true) end
    else
        _anchorPos=nil
        if ConsoleOut then appendStatus("Anchor",false) end
    end
end
