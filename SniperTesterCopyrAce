local function c3r(c)
    if c==COL.Green then return CCOL.Green end
    if c==COL.Red then return CCOL.Red end
    if c==COL.T then return CCOL.Amber end
    if c==COL.White then return CCOL.Cyan end
    if c==COL.D then return CCOL.Dim end
    return string.format("rgb(%d,%d,%d)",math.floor(c.R*255+0.5),math.floor(c.G*255+0.5),math.floor(c.B*255+0.5))
end

function setStatus(msg,col)
