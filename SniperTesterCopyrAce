-- ============================================================
-- TAB SWITCHING LOGIC
-- ============================================================
local function switchTab(tabName)
    currentTab = tabName
    
    -- Update tab button appearances
    for name, btn in pairs(tabButtons) do
        local isActive = (name == currentTab)
        local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        
        TweenService:Create(btn, tweenInfo, {
            BackgroundColor3 = isActive and COLORS.TabActive or COLORS.TabInactive,
            TextColor3 = isActive and COLORS.TabTextOn or COLORS.Dim
        }):Play()
        
        local stroke = btn:FindFirstChildOfClass("UIStroke")
        if stroke then
            stroke.Color = isActive and COLORS.TabActive or COLORS.Border
            stroke.Transparency = isActive and TRANSPARENCY.TabStrokeActive or TRANSPARENCY.TabStrokeInactive
        end
    end
    
    -- Show/hide panels
    MainPanel.Visible = (currentTab == "MAIN")
    FarmPanel.Visible = (currentTab == "FARM")
    SettingsPanelTab.Visible = (currentTab == "SETTINGS")
end

-- Connect tab buttons
for tabName, btn in pairs(tabButtons) do
    btn.MouseButton1Click:Connect(function()
        switchTab(tabName)
    end)
end

-- ============================================================
-- DRAGGING FUNCTIONALITY
-- ============================================================
local dragging = false
local dragStart = nil
local startPos = nil

Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Window.Position
    end
end)

Header.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        Window.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

