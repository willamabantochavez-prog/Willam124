local function norm(s) return (tostring(s or "")):match("^%s*(.-)%s*$") or "" end

local function aiPost(path, body)
    if not httpReq then return nil end
    local ok, res = pcall(httpReq, {
        Url = RURL..path, Method = "POST",
        Headers = {["Content-Type"]="application/json",["Authorization"]="Bearer "..RTOKEN},
        Body = HS:JSONEncode(body),
    })
    if not ok or type(res)~="table" then return nil end
    local raw = res.Body or res.body
    if type(raw)~="string" then return nil end
    local ok2, data = pcall(function() return HS:JSONDecode(raw) end)
    if not ok2 or type(data)~="table" then return nil end
    if data.error then return nil end
    return data
end

local function isOurs(inst)
    local p = inst
    for _=1,10 do
        if not p then break end
        if p.Name=="EclipseSniperUI" then return true end
        p = p.Parent
    end
    return false
end

local function visChain(inst)
    local c = inst
    while c do
        if c:IsA("GuiObject") and not c.Visible then return false end
        if c:IsA("ScreenGui") then return c.Enabled end
        c = c.Parent
    end
    return true
end

local function findBoxes(pg)
    local boxes = {}
    for _,g in ipairs(pg:GetChildren()) do
        if g:IsA("ScreenGui") and g.Enabled and not isOurs(g) then
            for _,d in ipairs(g:GetDescendants()) do
                if d:IsA("TextBox") and not isOurs(d) then boxes[#boxes+1]=d end
            end
        end
    end
    return boxes
end

local function findBtns(pg)
    local btns = {}
    for _,g in ipairs(pg:GetChildren()) do
        if g:IsA("ScreenGui") and g.Enabled and not isOurs(g) then
            for _,d in ipairs(g:GetDescendants()) do
                if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOurs(d) then
                    local n = d.Name:lower()
                    local pn = (d.Parent and d.Parent.Name or ""):lower()
                    if (n:find("code") or n:find("redeem") or pn:find("code") or pn:find("redeem")) and visChain(d) then
                        btns[#btns+1] = d
                    end
                end
            end
        end
    end
    return btns
end

