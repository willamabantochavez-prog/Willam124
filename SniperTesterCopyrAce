clearPend=function()
    _pendToken=_pendToken+1;_pendText=nil;_pendBox=nil;_pendUntil=0
end

rememberPend=function(box,text,rep)
    if not _retype or not text or text=="" then return end
    if not rep and _pendText and os.clock()<=_pendUntil then return end
    _pendToken=_pendToken+1;local tk=_pendToken
    _pendText=text;_pendBox=box;_pendUntil=os.clock()+8
    task.delay(8,function() if tk==_pendToken then clearPend() end end)
end

local function restore(box,txt)
    if not _retype or not txt or txt=="" then return false end
    RunService.Heartbeat:Wait()
    local rb=aceBox() or box
    if not rb or not visChain(rb) then return false end
    local ok=pcall(function() rb.Text=txt end)
    if ok then _lastBox=rb;watchBox(rb) end
    return ok
end

handleFeedback=function(text,obj)
    if not _retype or not _pendText then return end
    if os.clock()>_pendUntil then clearPend();return end
    if obj and obj:IsDescendantOf(GUI) then return end
    local l=tostring(text or ""):lower()
    local rej=l:find("invalid code",1,true) or l:find("expired",1,true) or l:find("already redeemed",1,true) or l:find("already used",1,true) or l:find("not found",1,true) or l:find("rejected",1,true)
    if not rej then return end
    local pt,pb=_pendText,_pendBox
    local ok=restore(pb,pt);clearPend()
    if ok then setStatus("Invalid - repasted: "..pt,COL.T);flashCode(pt,COL.Red) end
end

function appendBox(text)
    if not text or text=="" then return end
    if _lastWatched and not visChain(_lastWatched) then resetParts();clearWatch() end
    local box=aceBox()
    _parts[#_parts+1]=text
    local code=table.concat(_parts)
    local cnt=#_parts
    if box then
        _lastBox=box;watchBox(box)
        box.Text=code
    else
        setStatus("Captured; searching...",COL.T)
    end
    setStatus("Pasted "..cnt.."/".._submitAfter,COL.Green)
    flashCode(code,COL.Green)
    if cnt>=_submitAfter then
        _parts={}
        if _autoAccept then
            rememberPend(box,code,true)
            local ok,msg=submitCode(code)
            if ok then
                setStatus("Redeemed: "..code,COL.Green)
            else
                local r=restore(box,code);clearPend()
                if r then setStatus("Invalid - repasted: "..code,COL.T);flashCode(code,COL.Red)
                else setStatus("Failed: "..tostring(msg),COL.Red) end
            end
        end
    end
end

