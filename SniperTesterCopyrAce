local function aiPost(path, body)
    if not httpRequest then
        if setStatus then setStatus("ERROR: httpRequest not available", COLORS.Red) end
        return nil
    end
    local ok, res = pcall(httpRequest, {
        Url = RIDDLE_URL .. path,
        Method = "POST",
        Headers = {
            ["Content-Type"] = "application/json",
            ["Authorization"] = "Bearer " .. RIDDLE_TOKEN,
        },
        Body = HttpService:JSONEncode(body),
    })
    if not ok then
        if setStatus then setStatus("ERROR: HTTP failed - " .. tostring(res), COLORS.Red) end
        return nil
    end
    if type(res) ~= "table" then
        if setStatus then setStatus("ERROR: Invalid response type", COLORS.Red) end
        return nil
    end
    local raw = res.Body or res.body
    if type(raw) ~= "string" then
        if setStatus then setStatus("ERROR: No response body", COLORS.Red) end
        return nil
    end
    local okd, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not okd then
        if setStatus then setStatus("ERROR: JSON decode failed", COLORS.Red) end
        return nil
    end
    if type(data) == "table" and data.error then
        if setStatus then setStatus("API ERROR: " .. tostring(data.error):sub(1,60), COLORS.Red) end
        return nil
    end
    return data
end

local function isOurGui(instance)
    local p = instance
    for _ = 1, 10 do
        if not p then break end
        if p.Name == "ACECodeSniperUI" or p.Name == "SourcesHubRedeemerGui" then return true end
        p = p.Parent
