local function getNotifyRemote()
    local ok,Net=pcall(function() return RS:WaitForChild("Packages"):WaitForChild("Net") end)
    if not ok or not Net then return nil end
    for _,d in ipairs(Net:GetDescendants()) do
        if d:IsA("RemoteEvent") then
            local n=d.Name:lower()
            if n:find("notify") or n:find("notification") then return d end
        end
    end
    return nil
end

local function stripRich(t) return type(t)=="string" and (t:gsub("<[^>]->","")) or tostring(t) end

local function solveRiddle(msg,seq)
    _solving=_solving+1
    setStatus("Riddle detected! Asking AI...",COL.T)
    task.spawn(function()
        local data=nil
        local ok,err=pcall(function() data=aiPost("/solve",{riddle=msg}) end)
        _solving=math.max(0,_solving-1)
        if not _on then return end
        if not ok or not data or not data.answer then setStatus("ERROR: AI failed",COL.Red);return end
        local ans=norm(data.answer)
        if ans=="" then setStatus("ERROR: empty answer",COL.Red);return end
        if not _riddle then return end
        setStatus("AI answer: "..ans,COL.Green)
        rememberPend(nil,ans,true)
        local sok,smsg=submitCode(ans)
        if sok then setStatus("Riddle redeemed: "..ans,COL.Green)
        else setStatus("Riddle failed: "..tostring(smsg),COL.Red) end
    end)
end

local collectBuf={}
local function onAnnounce(...)
    local txt=stripRich(tostring((...) or ""))
    txt=txt:match("^%s*(.-)%s*$") or ""
    if txt=="" then return end
    if _riddle and txt:find("%s") then _riddleSeq=_riddleSeq+1;solveRiddle(txt,_riddleSeq);return end
    if txt:find("%s") then return end
    for w in txt:gmatch("[%w_]+") do collectBuf[#collectBuf+1]=w end
    if #collectBuf<1 then return end
    local captured=collectBuf[1];collectBuf={}
    if captured=="" or _seen[captured] then return end
    _seen[captured]=true
    task.delay(1.25,function() _seen[captured]=nil end)
    appendBox(captured)
end

local notifyRemote=getNotifyRemote()
if notifyRemote then
    notifyRemote.OnClientEvent:Connect(function(...)
        if not _on then return end
        pcall(onAnnounce,...)
    end)
end

