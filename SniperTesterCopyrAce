local function watchBox(box)
    if not box or _lastWatched==box then return end
    clearWatch();_lastWatched=box
    if box.Text~="" then _lastText=box.Text end
    _boxConn=box:GetPropertyChangedSignal("Text"):Connect(function()
        if box.Text=="" then resetParts() else _lastText=box.Text end
    end)
