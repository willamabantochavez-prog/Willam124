        if cf then
            if cf:IsA("GuiObject") then cf.Visible=true end
            local box,sub = nil,nil
            for _,d in ipairs(cf:GetDescendants()) do
                if d:IsA("TextBox") and not isOurs(d) then box=d; break end
            end
            for _,d in ipairs(cf:GetDescendants()) do
                if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOurs(d) then
                    local n=d.Name:lower()
                    if n:find("submit") or n:find("redeem") then sub=d; break end
                end
            end
            if box then
                pcall(function() box.Text=code end)
                task.wait(0.05)
                if sub then clickBtn(sub) end
                fireFocusLost(box)
                return true,"ok"
            end
        end
    end

    local btns = findBtns(pg)
    for _,b in ipairs(btns) do clickBtn(b); task.wait(0.05) end
    task.wait(0.2)

    local box = nil
    local dl = tick()+2
    while tick()<dl do
        for _,d in ipairs(findBoxes(pg)) do
            if visChain(d) then box=d; break end
        end
        if box then break end
        task.wait(0.1)
    end
    if not box then return false,"no box" end

    pcall(function() box.Text=code end)
    task.wait(0.05)

    local rBtn = nil
