-- REMOTE DETECTION (for fallback)
local getconns = getconnections or (debug and debug.getconnections)
local getinfo  = debug and (debug.getinfo or debug.info)

local function resolveNotifyRemote()
    if _G.PhiNotifyRemote then return _G.PhiNotifyRemote end
    local ok, Net = pcall(function() return ReplicatedStorage:WaitForChild("Packages"):WaitForChild("Net") end)
    if not ok or not Net then return nil end
    if getgc and getinfo and getconns then
        for _, d in ipairs(Net:GetDescendants()) do
            if d:IsA("RemoteEvent") then
                local ok2, cs = pcall(getconns, d.OnClientEvent)
                if ok2 and type(cs) == "table" then
                    for _, c in ipairs(cs) do
                        local f, fn = pcall(function() return c.Function end)
                        if f and type(fn) == "function" then
                            local i, info = pcall(getinfo, fn)
                            if i and tostring(info.short_src or info.source or ""):find("NotificationController", 1, true) then
                                return d
                            end
                        end
                    end
                end
            end
        end
    end
    return nil
end

local aceNotifyRemote = nil
pcall(function() aceNotifyRemote = resolveNotifyRemote() end)

-- ============================================================
-- FIRE FUNCTION (Delta compatible - tries multiple methods)
-- ============================================================
local function fireFakeAnnouncement(text)
    if not text or text == "" then return false, "empty text" end

    -- METHOD 1: Direct global function call (BEST for Delta)
    -- This calls the Code Sniper's onAnnounce directly
    if _G.EclipseOnAnnounce then
        local ok, err = pcall(_G.EclipseOnAnnounce, text)
        if ok then return true, "direct call" end
    end

    -- METHOD 2: firesignal on remote (some executors)
    if aceNotifyRemote and typeof(firesignal) == "function" then
        local ok = pcall(firesignal, aceNotifyRemote.OnClientEvent, text)
        if ok then return true, "firesignal" end
    end

    -- METHOD 3: getconnections on remote (Synapse, etc.)
    if aceNotifyRemote and getconns then
        local ok, cs = pcall(getconns, aceNotifyRemote.OnClientEvent)
        if ok and type(cs) == "table" then
            for _, c in ipairs(cs) do
                pcall(function() c:Fire(text) end)
            end
            return true, "getconnections"
        end
    end

    -- METHOD 4: Brute force all Net remotes (last resort)
    local ok, Net = pcall(function() return ReplicatedStorage:FindFirstChild("Packages") and ReplicatedStorage.Packages:FindFirstChild("Net") end)
    if ok and Net then
        local fired = false
        for _, d in ipairs(Net:GetDescendants()) do
            if d:IsA("RemoteEvent") then
                if typeof(firesignal) == "function" then
                    pcall(firesignal, d.OnClientEvent, text)
                    fired = true
                end
                if getconns then
                    local ok2, cs = pcall(getconns, d.OnClientEvent)
                    if ok2 and type(cs) == "table" then
                        for _, c in ipairs(cs) do
                            pcall(function() c:Fire(text) end)
                            fired = true
                        end
                    end
                end
            end
        end
        if fired then return true, "brute force" end
    end

    return false, "no method available"
end

