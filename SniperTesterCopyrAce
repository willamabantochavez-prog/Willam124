local function clearWatch()
    if _boxConn then pcall(function() _boxConn:Disconnect() end) end
    if _boxAncConn then pcall(function() _boxAncConn:Disconnect() end) end
    _boxConn=nil;_boxAncConn=nil;_lastWatched=nil
