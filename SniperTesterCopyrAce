    if themed.autoWriteStroke then TweenService:Create(themed.autoWriteStroke, ti, {Color = autoWriteEnabled and t.Accent or t.Border}):Play() end
    for _, c in ipairs(themed.cards) do TweenService:Create(c, ti, {BackgroundColor3 = t.Row}):Play() end
