local function toggleAnchor(state)
    if state == nil then state = not _anchorEnabled end
    _anchorEnabled = state; savedConfig.anchorEnabled = state; saveConfig()
    local t = BG_THEMES[_selectedBG] or BG_THEMES[1]
    AnchorToggle.Text = state and "ON" or "OFF"
    AnchorToggle.BackgroundColor3 = state and t.Accent or t.Control
    AnchorToggle.TextColor3 = state and t.TabTextOn or t.Dim
    ATStroke.Color = state and t.Accent or t.Border; ATStroke.Transparency = state and 0.4 or 0.7

    if _anchorConnection then _anchorConnection:Disconnect(); _anchorConnection = nil end
    if _anchorRespawnConn then _anchorRespawnConn:Disconnect(); _anchorRespawnConn = nil end

    if state then
        local char = player.Character
        if not char then
            if ConsoleOutput then appendConsoleStatus("Anchor: sin personaje", false) end
            return
        end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then
            if ConsoleOutput then appendConsoleStatus("Anchor: sin HRP", false) end
            return
        end

        _anchorPosition = root.CFrame
        local ANCHOR_THRESHOLD = 2
        local currentRoot = root

        local function anchorLoop()
            if not _anchorEnabled or not _anchorPosition then return end
            local c = player.Character
            if not c then return end
            local r = c:FindFirstChild("HumanoidRootPart")
            if not r then return end
            local hum = c:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health <= 0 then return end

            if r ~= currentRoot then currentRoot = r end

            local dist = (r.Position - _anchorPosition.Position).Magnitude
            if dist > ANCHOR_THRESHOLD then
                r.CFrame = _anchorPosition
            end

            pcall(function() r.AssemblyLinearVelocity = Vector3.zero end)
            pcall(function() r.AssemblyAngularVelocity = Vector3.zero end)
            pcall(function() r.Velocity = Vector3.zero end)
            pcall(function() r.RotVelocity = Vector3.zero end)
