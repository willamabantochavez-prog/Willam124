local P_TEXTURES = {
    "rbxassetid://5833235272","rbxassetid://5833323391",
    "rbxassetid://5857892330","rbxassetid://5857851618","rbxassetid://6711256324",
}

local function spawnParticle()
    if not runtime.particlesEnabled then return end
    if not ParticleLayer or not ParticleLayer.Parent then return end
    local tex = P_TEXTURES[math.random(1,#P_TEXTURES)]
    local size = math.random(18,48)
    local startX = math.random(-10,WIN_W-size+10)
    local startY = WIN_H+10
    local driftX = math.random(-25,25)/10
    local riseSpeed = 40+math.random(15,55)
    local theme = THEMES[runtime.currentTheme]
    local hue, sat, val
    if theme.hueMin == 0 and theme.hueMax == 0 then
        hue = 0; sat = 0; val = 0.6+math.random()*0.4
    else
        hue = (theme.hueMin + math.random()*(theme.hueMax-theme.hueMin))/360
        sat = 0.35+math.random()*0.35
        val = 0.85+math.random()*0.15
    end
    local tint = Color3.fromHSV(hue%1, sat, val)
    local p = new("ImageLabel", {
        Size=UDim2.new(0,size,0,size), Position=UDim2.new(0,startX,0,startY),
        BackgroundTransparency=1, Image=tex, ImageColor3=tint,
        ImageTransparency=0.4, Rotation=math.random(0,360), ZIndex=2,
    }, ParticleLayer)
    local life=0; local rotSpeed=math.random(-30,30)
    local wobbleAmp=math.random(5,20)/10; local wobbleFreq=0.5+math.random()*1.5
    local baseX=startX
    local mc
    mc = RunService.Heartbeat:Connect(function(dt)
        if not p.Parent then if mc then mc:Disconnect() end return end
        life=life+dt
        local newY=p.Position.Y.Offset-riseSpeed*dt
        local wobble=math.sin(life*wobbleFreq*math.pi*2)*wobbleAmp
        local newX=baseX+driftX*life*8+wobble*6
        p.Position=UDim2.new(0,newX,0,newY)
        p.Rotation=p.Rotation+rotSpeed*dt
        local progress=1-(newY/startY)
        if progress<0.2 then p.ImageTransparency=0.4+(1-progress/0.2)*0.6
        else p.ImageTransparency=0.4+((progress-0.2)/0.8)*0.6 end
        if newY<-size-20 then p:Destroy() if mc then mc:Disconnect() end end
    end)
end

