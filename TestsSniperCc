-- ═══════ DESTROY ═══════
function runtime.destroy()
    runtime.alive=false; runtime.enabled=false
    stopNotifListener()
    for _,c in ipairs(runtime.connections) do disconnect(c) end
    table.clear(runtime.connections)
    if runtime.gui then pcall(function() runtime.gui:Destroy() end) end
    if runtime.settingsGui then pcall(function() runtime.settingsGui:Destroy() end) end
    if runtime.headDisplay then pcall(function() runtime.headDisplay:Destroy() end) end
    local kb=parentGui:FindFirstChild("VailSettingsUI")
    if kb then pcall(function() kb:Destroy() end) end
    if environment[RUNTIME_KEY]==runtime then environment[RUNTIME_KEY]=nil end
end

_G.Vail = {
    Toggle=toggleEnabled,
    SetKey=function(k) runtime.snipeKey=k end,
    SetCode=function(c) runtime.lastCode=c end,
    Redeem=function() if runtime.lastCode then processCode(runtime.lastCode) end end,
    SetTheme=applyTheme,
    Announce=function(text) pcall(onAnnouncement, text) end,
    Destroy=runtime.destroy,
}
