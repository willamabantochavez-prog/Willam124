            tweenProperty(b, {BackgroundColor3 = C.accentDim}, 0.08)
        end)
        b.MouseButton1Up:Connect(function()
            tweenProperty(b, {BackgroundColor3 = C.btnBgHover}, 0.1)
        end)
        return b
    end

    local minusBtn = styledBtn("-", startX)
    local valFrame, valLabel = makeValBox(ctrlFrame, VAL_W, btnH, "1")
    valFrame.Position = UDim2.new(0, startX + BTN_SZ + GAP, 0.5, -btnH / 2)
    valFrame.ZIndex = 8
    valLabel.ZIndex = 9
    local plusBtn = styledBtn("+", startX + BTN_SZ + GAP + VAL_W + GAP)

    return minusBtn, valLabel, plusBtn
end

-- [input] [Set] with hover
local function makeInputGroup(ctrlFrame, default)
    local btnH = BTN_SZ
    local totalW = INP_W + GAP + APP_W
    local startX = CTRL_W - totalW

    local input = makeInputBox(ctrlFrame, INP_W, btnH, default)
    input.Position = UDim2.new(0, startX, 0.5, -btnH / 2)

    local applyBtn = Instance.new("TextButton")
    applyBtn.Size = UDim2.new(0, APP_W, 0, btnH)
    applyBtn.Position = UDim2.new(0, startX + INP_W + GAP, 0.5, -btnH / 2)
    applyBtn.BackgroundColor3 = C.green
    applyBtn.Text = "Set"
    applyBtn.TextColor3 = C.text
    applyBtn.TextSize = 10
    applyBtn.Font = Enum.Font.GothamBold
    applyBtn.BorderSizePixel = 0
    applyBtn.ZIndex = 10  -- Higher ZIndex
    applyBtn.AutoButtonColor = false
    applyBtn.Parent = ctrlFrame
    Instance.new("UICorner", applyBtn).CornerRadius = UDim.new(0, 6)

    applyBtn.MouseEnter:Connect(function()
        tweenProperty(applyBtn, {BackgroundColor3 = C.greenGlow}, 0.15)
    end)
    applyBtn.MouseLeave:Connect(function()
        tweenProperty(applyBtn, {BackgroundColor3 = C.green}, 0.15)
    end)
    applyBtn.MouseButton1Down:Connect(function()
        tweenProperty(applyBtn, {BackgroundColor3 = Color3.fromRGB(30, 140, 45)}, 0.08)
    end)

    return input, applyBtn
end

-- [ON/OFF] toggle with glow
local function makeToggleCtrl(ctrlFrame)
    local btnH = BTN_SZ
    local startX = CTRL_W - TOGGLE_W

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, TOGGLE_W, 0, btnH)
    btn.Position = UDim2.new(0, startX, 0.5, -btnH / 2)
    btn.BackgroundColor3 = C.red
    btn.Text = "OFF"
    btn.TextColor3 = C.text
    btn.TextSize = 11
    btn.Font = Enum.Font.GothamBold
    btn.BorderSizePixel = 0
    btn.ZIndex = 10  -- Higher ZIndex
    btn.AutoButtonColor = false
    btn.Parent = ctrlFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 7)

    local glow = Instance.new("UIStroke")
    glow.Color = C.redGlow
    glow.Thickness = 1.5
    glow.Transparency = 0.6
    glow.Parent = btn

    btn.MouseEnter:Connect(function()
        tweenProperty(btn, {BackgroundColor3 = C.redGlow}, 0.15)
    end)
    btn.MouseLeave:Connect(function()
        if not farmActive then
            tweenProperty(btn, {BackgroundColor3 = C.red}, 0.15)
        end
    end)

    return btn, glow
end

