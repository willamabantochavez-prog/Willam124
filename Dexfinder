local function createFilterToggle(parent, text, posX, default)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 90, 0, 22)
    btn.Position = UDim2.new(0, posX, 0, 0)
    btn.BackgroundColor3 = default and Color3.fromRGB(255, 100, 0) or Color3.fromRGB(40, 40, 55)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 10
    btn.Font = Enum.Font.GothamBold
    btn.Parent = parent
    
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 4)
    c.Parent = btn
    
    local active = default
    
    btn.MouseButton1Click:Connect(function()
        active = not active
        btn.BackgroundColor3 = active and Color3.fromRGB(255, 100, 0) or Color3.fromRGB(40, 40, 55)
    end)
    
    return function() return active end
end

