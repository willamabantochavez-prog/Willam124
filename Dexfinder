local function searchInstance(instance, query, depth)
    if depth > 15 then return end
    if searching == false then return end
    
    local found = false
    
    -- Buscar en nombre
    if getName() then
        if instance.Name:lower():find(query:lower()) then
            local service = getServiceName(instance)
            addResult(
                "NOMBRE",
                getFullPath(instance),
                "Class: " .. instance.ClassName,
                service
            )
            table.insert(results, instance)
            found = true
        end
    end
    
    -- Buscar en propiedades de valor
    if getProperties() and not found then
        if instance:IsA("ValueBase") then
            local val = tostring(instance.Value)
            if val:lower():find(query:lower()) then
                local service = getServiceName(instance)
                addResult(
                    "VALOR",
                    getFullPath(instance),
                    instance.ClassName .. " = " .. val,
                    service
                )
                table.insert(results, instance)
            end
        end
        
        -- Buscar en propiedades específicas
        pcall(function()
            if instance:IsA("TextLabel") or instance:IsA("TextButton") then
                if instance.Text:lower():find(query:lower()) then
                    local service = getServiceName(instance)
                    addResult(
                        "TEXTO",
                        getFullPath(instance),
                        "Text: \"" .. instance.Text:sub(1, 50) .. "\"",
                        service
                    )
                    table.insert(results, instance)
                end
            end
        end)
        
        pcall(function()
            if instance:IsA("Model") or instance:IsA("BasePart") then
                for _, tag in pairs(instance:GetTags()) do
                    if tag:lower():find(query:lower()) then
                        local service = getServiceName(instance)
                        addResult(
                            "TAG",
                            getFullPath(instance),
                            "Tag: " .. tag,
                            service
                        )
                        table.insert(results, instance)
                    end
                end
            end
        end)
    end
    
    -- Buscar en Remotes
    if getRemotes() then
        if instance:IsA("RemoteEvent") or instance:IsA("RemoteFunction") or instance:IsA("BindableEvent") or instance:IsA("BindableFunction") then
            if instance.Name:lower():find(query:lower()) then
                local service = getServiceName(instance)
                addResult(
                    "REMOTE",
                    getFullPath(instance),
                    "Class: " .. instance.ClassName,
                    service
                )
                table.insert(results, instance)
            end
        end
    end
    
    -- Buscar en scripts (nombre y source si está disponible)
    if getScripts() then
        if instance:IsA("LocalScript") or instance:IsA("ModuleScript") or instance:IsA("Script") then
            -- Buscar en nombre ya cubierto arriba
            
            -- Intentar buscar en Source (solo funciona con exploits que soportan decompile)
            pcall(function()
                local source = instance.Source or ""
                if source:lower():find(query:lower()) then
                    local service = getServiceName(instance)
                    local startPos = source:lower():find(query:lower())
                    local snippet = source:sub(math.max(1, startPos - 30), startPos + #query + 30)
                    snippet = snippet:gsub("\n", " "):gsub("\r", ""):gsub("\t", " ")
                    
                    addResult(
                        "SCRIPT",
                        getFullPath(instance),
                        snippet,
                        service
                    )
                    table.insert(results, instance)
                end
            end)
        end
    end
    
    -- Buscar hijos recursivamente
    for _, child in pairs(instance:GetChildren()) do
        if searching then
            searchInstance(child, query, depth + 1)
        end
    end
end

-- ========================
-- EJECUTAR BÚSQUEDA
-- ========================
local function performSearch(query)
    if query == "" or #query < 1 then
        statusLabel.Text = "Escribe algo para buscar"
        statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end
    
    searching = true
    clearResults()
    
    statusLabel.Text = "Buscando: \"" .. query .. "\" ..."
    statusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
    searchBtn.Text = "PARAR"
    searchBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    
    local services = {
        Workspace,
        ReplicatedStorage,
        StarterGui,
        StarterPlayer,
        Players,
        game:GetService("Lighting"),
        game:GetService("SoundService"),
    }
    
    -- Intentar acceder a ServerStorage (solo con exploits)
    pcall(function()
        table.insert(services, ServerStorage)
    end)
    
    pcall(function()
        table.insert(services, game:GetService("ServerScriptService"))
    end)
    
    -- Buscar en cada servicio
    for _, service in pairs(services) do
        if searching then
            statusLabel.Text = "Buscando en: " .. service.Name .. "..."
            searchInstance(service, query, 0)
            task.wait(0.05) -- Evitar freeze
        end
    end
    
    -- Buscar en PlayerGui
    if searching then
        statusLabel.Text = "Buscando en PlayerGui..."
        searchInstance(playerGui, query, 0)
    end
    
    countLabel.Text = #results .. " resultados"
    
    if #results == 0 then
        statusLabel.Text = "No se encontró: \"" .. query .. "\""
        statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
    else
        statusLabel.Text = "✅ Encontrados: " .. #results .. " para \"" .. query .. "\""
        statusLabel.TextColor3 = Color3.fromRGB(80, 255, 80)
    end
    
    searching = false
    searchBtn.Text = "BUSCAR"
    searchBtn.BackgroundColor3 = Color3.fromRGB(255, 100, 0)
end

