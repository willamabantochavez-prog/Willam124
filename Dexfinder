local function getFullPath(instance)
    local path = instance.Name
    local current = instance.Parent
    while current and current ~= game do
        path = current.Name .. "." .. path
        current = current.Parent
    end
    return path
end

local function getServiceName(instance)
    local current = instance
    while current.Parent and current.Parent ~= game do
        current = current.Parent
    end
    return current.Name or "Unknown"
end

local function getServiceColor(serviceName)
    local colors = {
        Workspace = Color3.fromRGB(100, 200, 100),
        ReplicatedStorage = Color3.fromRGB(100, 150, 255),
        ServerStorage = Color3.fromRGB(255, 150, 100),
        StarterGui = Color3.fromRGB(200, 100, 255),
        StarterPlayer = Color3.fromRGB(255, 200, 100),
        Players = Color3.fromRGB(255, 120, 120),
        Lighting = Color3.fromRGB(255, 255, 150),
        SoundService = Color3.fromRGB(150, 255, 255),
        ["Server Script Service"] = Color3.fromRGB(255, 180, 120),
    }
    return colors[serviceName] or Color3.fromRGB(200, 200, 200)
end

